{
  "name": "@eigenius/orchestration",
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env src/main.ts",
    "start": "deno run --allow-net --allow-env src/main.ts",
    "test": "deno test --allow-net --allow-env tests/",
    "generate": "cd .. && PATH=$PWD/node_modules/.bin:$PATH buf generate",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "ai": "npm:ai@latest",
    "@ai-sdk/anthropic": "npm:@ai-sdk/anthropic@latest",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@latest",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2",
    "@connectrpc/connect-node": "npm:@connectrpc/connect-node@^2",
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2",
    "zod": "npm:zod@^3"
  },
  "lint": {
    "exclude": ["src/gen/"]
  },
  "compilerOptions": {
    "strict": true
  }
}
