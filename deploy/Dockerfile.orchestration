# Eigenius Orchestration Layer — Deno runtime
#
# Runs the TypeScript orchestration layer that handles program execution,
# LLM adapters, and the MCP server surface.

FROM denoland/deno:latest

WORKDIR /app

# Copy config and cache dependencies
COPY orchestration/deno.json ./
COPY orchestration/src/ src/
RUN deno cache src/main.ts

ENV EIGENIUS_KERNEL_ENDPOINT=http://eigenius-kernel:50051

EXPOSE 8080

CMD ["deno", "run", "--allow-net", "--allow-env", "--allow-sys=hostname", "src/main.ts"]
