# Eigenius Kernel Service — multi-stage build
#
# Produces a minimal container image running the Eigenius CLI
# with gRPC service on port 50051.

# --- Build stage ---
FROM rust:1.97-bookworm AS builder

RUN apt-get update && apt-get install -y protobuf-compiler libclang-dev && rm -rf /var/lib/apt/lists/*

# `release` for production builds (full LTO, opt-level 3); `ci` for CI builds
# (opt-level 1, no LTO, parallel codegen — ~3-5x faster compile, functionally
# identical binary for e2e). Pass `--build-arg CARGO_PROFILE=ci` from the
# workflow when building for the notebook E2E job.
ARG CARGO_PROFILE=release
# D71 — the untrusted proposers (sense ranker, reading ranker, anaphora,
# discourse kind, abbreviation, POS) only exist under `use-llm`. Without them a
# formalization run against a doc branch that carries no recorded draws fails
# CLOSED: a run with no sense ranker is cap-only, which is a DIFFERENT
# experiment, not a quieter version of the same one.
#
# Off by default, because the default image should not carry an LLM client or
# invite one. Turn it on for a stack you intend to formalize with:
#   docker compose build --build-arg CARGO_FEATURES=use-llm kernel
# and give the kernel service an ANTHROPIC_API_KEY. Once a run succeeds its
# draws live on its `doc-<id>` branch, and re-runs replay them without a key.
ARG CARGO_FEATURES=

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY kernel/ kernel/
COPY crates/ crates/
COPY storage/ storage/
COPY cli/ cli/
COPY proto/ proto/
COPY ontologies/ ontologies/
# eigenius-julia (transitive dep of the CLI's `env build` command) does
# `include_str!`s of julia/common/EigeniusJuliaCommon/ at compile time.
COPY julia/ julia/
# `eigenius-lean-runtime`'s build script reads the workspace's pinned Lean toolchain and bakes it
# into a const, so the Dockerfile composer and every Rust caller see one version with no drift.
# That crate entered the CLI's build graph when `eigenius-lean` promoted it from a dev-dependency
# (D74 §3.3 — the IRI -> Lean name mangling must have ONE implementation, called by both D30's
# emitter and the externalizer). Just the pin, not `lean/`: it is the single source of truth elan
# reads natively, and the rest of that tree — research projects, the vendored lean4export — has
# no business in this image.
COPY lean/runtime-worker/lean-toolchain lean/runtime-worker/lean-toolchain
COPY patches/ patches/

# Build the CLI binary (includes serve command). Cargo cache mounts persist
# the dependency build across buildkit invocations of the same context;
# combined with buildx's --cache-from/--cache-to GHA cache they persist across
# CI runs. The final binary is staged under /out/ so the cache-mounted target/
# directory doesn't shadow it on the way out.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --profile ${CARGO_PROFILE} -p eigenius-cli \
        ${CARGO_FEATURES:+--features ${CARGO_FEATURES}} \
    && mkdir -p /out \
    && cp /build/target/${CARGO_PROFILE}/eigenius /out/eigenius

# --- Runtime stage ---
FROM debian:bookworm-slim

# OCI image labels for registry consumers (GHCR auto-links the image
# to the source repository via image.source; Docker Hub / other
# registries surface description + licenses on the listing page).
LABEL org.opencontainers.image.title="eigenius-kernel"
LABEL org.opencontainers.image.description="Eigenius kernel gRPC server — typed knowledge-graph platform with layer chains, EigenTT type theory, and an institutional dispatch surface."
LABEL org.opencontainers.image.source="https://github.com/eigenius/eigenius"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="Eigenius"
LABEL org.opencontainers.image.documentation="https://github.com/eigenius/eigenius/tree/main/docs"

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/eigenius /usr/local/bin/eigenius

# WordNet's Morphy dictionary is MOUNTED, not baked in — see the compose file.
# `references/` is gitignored (only `.gitkeep` is tracked), so a `COPY` here
# breaks every clean checkout and CI build while working fine on a developer's
# machine that happens to have the download.
#
# The license would permit shipping it (WordNet 3.0 grants distribution without
# fee, provided the copyright notice travels with it) — this is a repo-convention
# decision, not a legal one: third-party corpora are downloaded, not vendored.
#
# WITHOUT IT THE SERVED PARSER DOES NOT LEMMATISE: `build_parse_config` falls
# back to the no-op `Identity`, so `models` never reaches `model`, nothing seeds,
# and every sentence yields zero parses — reported as `cut_grammar` ("no parse
# with every token in vocabulary"), which reads like a grammar gap and is not
# one. Found `2026-08-20` the first time a D71 formalization ran in the
# container; `ParseSentence` had been silently unlemmatised there since it
# shipped. The startup log says which lemmatizer loaded; check it.
ENV EIGENIUS_MORPHY_DICT=/usr/share/eigenius/wordnet/dict

EXPOSE 50051

ENV EIGENIUS_ORCHESTRATOR_ENDPOINT=""

ENTRYPOINT ["eigenius"]
CMD ["serve", "--port", "50051"]
