# Eigenius Kernel Service — multi-stage build
#
# Produces a minimal container image running the Eigenius CLI
# with gRPC service on port 50051.

# --- Build stage ---
FROM rust:1.86-bookworm AS builder

RUN apt-get update && apt-get install -y protobuf-compiler libclang-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY kernel/ kernel/
COPY storage/ storage/
COPY cli/ cli/
COPY proto/ proto/
COPY ontologies/ ontologies/

# Build the CLI binary (includes serve command)
RUN cargo build --release -p eigenius-cli

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/eigenius /usr/local/bin/eigenius

EXPOSE 50051

ENV EIGENIUS_ORCHESTRATOR_ENDPOINT=""

ENTRYPOINT ["eigenius"]
CMD ["serve", "--port", "50051"]
