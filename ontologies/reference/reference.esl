// reference — bibliographic references + literature-citation warrants.
//
// Lets an encoding import a claim from the published literature as a
// first-class, cite-able warrant, instead of burying the citation in prose.
// A bootstrap ontology (kernel-seeded via kernel/src/bootstrap/mod.rs, stacked
// above the `ingest` layer): always present on every chain, so any study
// encoding can cite literature without first loading a support layer.
//
// DESIGN — separate the WORK from a USE of it, three standards, kept native to
// the platform's own epistemic model rather than grafting on a parallel RDF graph:
//
//   0. REFERENCE vs CITATION (the core split, after BiRO / CiTO). A
//      `reference:Reference` is the global bibliographic WORK (Buehler 2012); a
//      `reference:Citation` is one citing entity's USE of that work. Anything
//      local to the citing document — the in-text reference number, the CiTO
//      function, the imported claim — lives on the Citation, never on the
//      Reference (a different paper citing the same work numbers it differently).
//
//   1. The imported CLAIM (what a citation warrants) is **Declared**.
//      `reference:Citation` is a `reflection:DeclaredResource`: a citation is an
//      asserted act, and when it imports a claim (a *literature warrant*) the
//      claim IS its `reflection:canonical_proposition`. Consuming nodes cite the
//      warrant through the existing `reasoning:DeclaredEvidence` mechanism.
//
//   2. The reference IDENTITY + METADATA follows **CSL-JSON / Dublin Core**.
//      `reference:Reference` is epistemically neutral (it asserts nothing; the
//      Citation does). Its fields mirror CSL-JSON (the de-facto Zotero/Pandoc
//      bibliographic data model) + Dublin Core, so a chain's bibliography
//      round-trips to standard tooling. Identity = DOI and/or PubMed ID.
//
//   3. The citation FUNCTION follows **CiTO** (Citation Typing Ontology,
//      SPAR). `reference:citation_type` (on the Citation) names HOW the work is
//      used — background / method / evidence / source-document / authority — so
//      the "what claim does this reference support" table (encoding-plan §3)
//      becomes machine-meaningful. Each type carries `reference:cito_iri`.
//
// WORKED EXAMPLE (the shape an encoding produces; lives in wrn-literature.esl):
//
//   // (1) the Reference — the global bibliographic WORK (no citing-doc-local
//   //     fields like a reference number; those belong on the Citation).
//   resource lit:buehler_2012 : reference:Reference {
//       reference:doi             = "10.1371/journal.pone.0051942";
//       reference:title           = "C911: a bench-level control for ... siRNA off-target effects";
//       reference:creator         = "Buehler E, Chen YC, Martin S";
//       reference:container_title = "PLoS One";
//       reference:issued_year     = 2012;
//   }
//   // (2) the Citation — THIS encoding's use of that work: a Declared act that
//   //     carries the CiTO function, the citing doc's local label, and (when it
//   //     imports a claim, i.e. a literature warrant) the claim via
//   //     canonical_proposition. reference:cites is the authoritative link
//   //     (declared_by is compiler-stamped on commit).
//   resource wrn:lit_c911_design : reference:Citation {
//       reference:cites                  = lit:buehler_2012;
//       reference:citation_type          = reference:uses_method_in;
//       reference:reference_label        = "16";   // the WRN paper's own [16]
//       reflection:rationale             = "A C911 (seed-preserving, target-
//           disrupted) control isolates on-target from shRNA seed off-target.";
//       reflection:canonical_proposition = type_expr( onco:SeedControlIsValid("C911") );
//   }
//   // (3) a node CITES the warrant via the existing reasoning mechanism —
//   //     e.g. wrn:seed_control_rule's justification gains
//   //     DeclaredEvidence("urn:eigenius:pub:wrn:lit_c911_design").

namespace core       = "urn:eigenius:core";
namespace formats    = "urn:eigenius:core:formats";
namespace reflection = "urn:eigenius:reflection";
namespace reference  = "urn:eigenius:reference";

// ── The bibliographic WORK (CSL-JSON / Dublin Core aligned) ──────────────
//
// A published work, identified by DOI / PubMed ID. Epistemically neutral: it is
// a global record of an external artifact and asserts nothing on its own (a
// marker class with metadata, like stats:ImpossibilityWitness). It carries NO
// citing-document-local fields — those live on reference:Citation. The CLAIM a
// citation warrants lives on the Citation that `reference:cites` this work.

class reference:Reference {
    description = "A published work cited by an encoding — the global bibliographic record, reusable across any number of citing documents. Identified by a DOI and/or a PubMed ID (reference:doi / reference:pmid — the authoritative external identifiers); the IRI is a stable readable slug, by convention urn:eigenius:reference:lit:<first-author>_<year>. Metadata fields follow CSL-JSON / Dublin Core so a chain's bibliography is interoperable. Epistemically neutral: it asserts nothing, and carries no citing-doc-local data (in-text number, citation function, imported claim) — those belong on reference:Citation.";
    recommends reference:doi, reference:pmid, reference:title, reference:creator,
               reference:container_title, reference:issued_year, reference:url;
}

property reference:doi : core:string {
    description = "Digital Object Identifier (CSL 'DOI'), bare form '10.xxxx/...'. Preferred stable identity; canonical IRI urn:eigenius:reference:doi:<doi>.";
    domain reference:Reference;
}

property reference:pmid : core:string {
    description = "PubMed identifier (the common biomedical-literature id; not a CSL field but carried in PubMed/NCBI exports). Used as identity when no DOI is recorded; canonical IRI urn:eigenius:reference:pmid:<pmid>.";
    domain reference:Reference;
}

property reference:title : core:string {
    description = "Title of the work (CSL 'title' / dcterms:title).";
    domain reference:Reference;
}

property reference:creator : core:string {
    description = "Authors (CSL 'author' / dcterms:creator). v1: a single formatted display string, e.g. 'Chan EM, Shibue T, et al.'. A structured value_array is a future refinement.";
    domain reference:Reference;
}

property reference:container_title : core:string {
    description = "Journal / book / venue the work appeared in (CSL 'container-title').";
    domain reference:Reference;
}

property reference:issued_year : core:integer {
    description = "Year of publication (CSL 'issued', year part).";
    domain reference:Reference;
}

property reference:url : core:string {
    description = "Resolvable URL for the work (CSL 'URL'); typically https://doi.org/<doi>.";
    format = formats:iri;
    domain reference:Reference;
}

// ── Citation-function vocabulary (CiTO-aligned individuals) ───────────────
//
// The rhetorical/evidential role a citation plays, mirroring the CiTO object
// properties. Individuals (not constructors) so each can carry its canonical
// CiTO URI for interop, exactly as reflection:EpistemicStatus enumerates
// observed/derived/verified/declared.

class reference:CitationType {
    description = "How a literature warrant uses the work it cites — the CiTO (Citation Typing Ontology, SPAR) citation function. A DeclaredResource names one via reference:citation_type; reference:cito_iri carries the canonical CiTO URI.";
}

property reference:cito_iri : core:string {
    description = "Canonical CiTO URI this citation type maps to, e.g. 'http://purl.org/spar/cito/citesAsEvidence'. Carried for export / interop.";
    format = formats:iri;
    domain reference:CitationType;
}

resource reference:obtains_background_from : reference:CitationType {
    core:description = "The citing claim takes background or motivation from the cited work — e.g. a definition, framing, or domain premise. CiTO cito:obtainsBackgroundFrom.";
    reference:cito_iri = "http://purl.org/spar/cito/obtainsBackgroundFrom";
}

resource reference:uses_method_in : reference:CitationType {
    core:description = "The citing claim uses a method, protocol, assay, or reagent design described in the cited work. CiTO cito:usesMethodIn.";
    reference:cito_iri = "http://purl.org/spar/cito/usesMethodIn";
}

resource reference:cites_as_evidence : reference:CitationType {
    core:description = "The cited work supplies empirical evidence for the citing claim. CiTO cito:citesAsEvidence.";
    reference:cito_iri = "http://purl.org/spar/cito/citesAsEvidence";
}

resource reference:cites_as_source_document : reference:CitationType {
    core:description = "The cited work is the source document for data, material, or a dataset the citing claim uses. CiTO cito:citesAsSourceDocument.";
    reference:cito_iri = "http://purl.org/spar/cito/citesAsSourceDocument";
}

resource reference:cites_as_authority : reference:CitationType {
    core:description = "The cited work is an authority for a definition, standard, or convention the citing claim adopts. CiTO cito:citesAsAuthority.";
    reference:cito_iri = "http://purl.org/spar/cito/citesAsAuthority";
}

// ── The CITATION (a citing entity's use of a Reference) ──────────────────
//
// One use of a Reference: it names the cited work, the CiTO function, and the
// citing document's local label. A Citation IS a reflection:DeclaredResource —
// a citation is an asserted act — so a *literature warrant* (a Citation that
// imports a domain claim) simply carries that claim as its
// reflection:canonical_proposition, and consuming nodes discharge it via
// reasoning:DeclaredEvidence on the Citation's IRI. (declared_by is
// compiler-stamped on commit, so reference:cites is the authoritative link.)

class reference:Citation : reflection:DeclaredResource {
    description = "A citation — one citing entity's use of a reference:Reference. Carries the cited work (reference:cites), the CiTO citation function (reference:citation_type), and the citing document's own in-text label (reference:reference_label). As a DeclaredResource it may carry an imported claim in reflection:canonical_proposition (then it is a 'literature warrant' a node can discharge via DeclaredEvidence); a Citation without one is pure provenance. All citing-doc-local data lives here, not on the global Reference.";
    requires reference:cites;
    recommends reference:citation_type, reference:reference_label;
}

property reference:cites : core:resource {
    description = "The published Reference this Citation uses. The authoritative work link (reflection:declared_by is compiler-stamped, so cannot carry it).";
    class_types reference:Reference;
    domain reference:Citation;
}

property reference:citation_type : core:resource {
    description = "How the cited work is used, from the CiTO-aligned reference:CitationType vocabulary. Constrained by allows_only to the five citation functions, so an unknown value is rejected at commit and narrowing the set is a retroactively-checked change.";
    class_types reference:CitationType;
    allows_only reference:obtains_background_from,
                reference:uses_method_in,
                reference:cites_as_evidence,
                reference:cites_as_source_document,
                reference:cites_as_authority;
    domain reference:Citation;
}

property reference:reference_label : core:string {
    description = "The citing document's own in-text label for this citation (e.g. the WRN paper's '[16]'), for cross-walk to its published reference list. Local to the citing document, hence on the Citation — not the Reference.";
    domain reference:Citation;
}
