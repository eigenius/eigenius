// What a ClinVar release says about an allele (D99 8b).
//
// "Absent from ClinVar" is a statement about a database state, so its subject is a RELEASE — a
// finite artifact, fixed once published — not the allele. Querying a release is a `prov:Activity`;
// its result is Observed, by a `prov:ObservationTrace` whose `prov:was_generated_by` is the query and
// whose `prov:used` is the release. Where no query was run on the chain, the statement is Declared
// by whoever reports it.
//
// No predicate here derives anything about the allele. The retrieval failure in UAB experiment 02
// ("the absence of ours reads as the absence of a problem") is the step from `NotListed` to a claim
// about the allele, and that step would need a declared bridge.
//
// Not a ClinVar import: a release is named, not loaded. Chain-loaded, above `clinical` (D99 §9).

namespace core     = "urn:eigenius:core";
namespace lexicon  = "urn:eigenius:lexicon";
namespace variant  = "urn:eigenius:variant";
namespace clinical = "urn:eigenius:clinical";
namespace clinvar  = "urn:eigenius:clinvar";

class clinvar:Release : lexicon:Entity {
    description = "One ClinVar release. ClinVar publishes monthly; a statement about what ClinVar lists is about one release, and a later release may list what an earlier one did not.";
    recommends clinvar:release_date;
}

property clinvar:release_date : core:string {
    description = "The release's date, ISO-8601. Absent where a source reports a lookup without saying which release it consulted.";
    domain clinvar:Release;
}

data clinvar:NotListed : clinvar:Release -> variant:Allele -> Prop {
    description = "The release has no record of the allele. Says nothing about the allele: absence from a release is not evidence of benignity.";
}

data clinvar:ListedAs : clinvar:Release -> variant:Allele -> clinical:AcmgTier -> Prop {
    description = "The release lists the allele with the germline classification. ClinVar's classification values include the five ACMG/AMP tiers and others (conflicting classifications, risk factor, drug response), which are not modelled.";
}

// ── Structured variation records and review status (D103 §5.2) ───────────────────────────────

class clinvar:ReviewStatus {
    description = "ClinVar germline review status tier (0 to 4 stars). Closed.";
}

resource clinvar:no_assertion_provided : clinvar:ReviewStatus {
    core:short_name  = "no_assertion_provided";
    core:description = "0 stars: no assertion provided.";
}

resource clinvar:no_assertion_criteria_provided : clinvar:ReviewStatus {
    core:short_name  = "no_assertion_criteria_provided";
    core:description = "0 stars: assertion provided without assertion criteria.";
}

resource clinvar:single_submitter : clinvar:ReviewStatus {
    core:short_name  = "single_submitter";
    core:description = "1 star: criteria provided, single submitter.";
}

resource clinvar:conflicting_classifications : clinvar:ReviewStatus {
    core:short_name  = "conflicting_classifications";
    core:description = "1 star: criteria provided, conflicting classifications.";
}

resource clinvar:multiple_submitters_no_conflicts : clinvar:ReviewStatus {
    core:short_name  = "multiple_submitters_no_conflicts";
    core:description = "2 stars: criteria provided, multiple submitters, no conflicts.";
}

resource clinvar:reviewed_by_expert_panel : clinvar:ReviewStatus {
    core:short_name  = "reviewed_by_expert_panel";
    core:description = "3 stars: reviewed by ClinGen/variant curation expert panel.";
}

resource clinvar:practice_guideline : clinvar:ReviewStatus {
    core:short_name  = "practice_guideline";
    core:description = "4 stars: practice guideline.";
}

class clinvar:VariationRecord : lexicon:Entity {
    description = "One ClinVar VCV variation record observed in a fixed clinvar:Release, carrying its accession, allele, classification tier, review status, star count, submitter count, and conflict flag.";
    requires clinvar:vcv_accession, clinvar:record_release, clinvar:record_allele;
    recommends clinvar:vcv_version, clinvar:classification, clinvar:review_status,
               clinvar:star_rating, clinvar:submitter_count, clinvar:has_conflict,
               core:short_name, core:description;
}

property clinvar:vcv_accession : core:string {
    description = "ClinVar VCV accession without version suffix (e.g. VCV000000001).";
    domain clinvar:VariationRecord;
}

property clinvar:vcv_version : core:integer {
    description = "Integer version number of the VCV record (e.g. 4 for VCV000000001.4).";
    domain clinvar:VariationRecord;
}

property clinvar:record_release : core:resource {
    description = "The ClinVar release in which this variation record was observed.";
    class_types clinvar:Release;
    domain clinvar:VariationRecord;
}

property clinvar:record_allele : core:resource {
    description = "The variant allele this ClinVar variation record describes.";
    class_types variant:Allele;
    domain clinvar:VariationRecord;
}

property clinvar:classification : core:resource {
    description = "Germline ACMG/AMP classification tier when the record carries one of the five standard tiers.";
    class_types clinical:AcmgTier;
    domain clinvar:VariationRecord;
}

property clinvar:review_status : core:resource {
    description = "ClinVar review status governing the record's star rating.";
    class_types clinvar:ReviewStatus;
    allows_only clinvar:no_assertion_provided, clinvar:no_assertion_criteria_provided,
                clinvar:single_submitter, clinvar:conflicting_classifications,
                clinvar:multiple_submitters_no_conflicts, clinvar:reviewed_by_expert_panel,
                clinvar:practice_guideline;
    domain clinvar:VariationRecord;
}

property clinvar:star_rating : core:integer {
    description = "ClinVar review-status star rating (0 through 4).";
    domain clinvar:VariationRecord;
}

property clinvar:submitter_count : core:integer {
    description = "Number of clinical submitters contributing to this VCV record.";
    domain clinvar:VariationRecord;
}

property clinvar:has_conflict : core:boolean {
    description = "Whether the record carries conflicting interpretations of pathogenicity.";
    domain clinvar:VariationRecord;
}

axiom clinvar:HasReviewStatus   : clinvar:Release -> variant:Allele -> clinvar:ReviewStatus -> Prop
axiom clinvar:HasReviewStars    : clinvar:Release -> variant:Allele -> core:integer -> Prop
axiom clinvar:HasSubmitterCount : clinvar:Release -> variant:Allele -> core:integer -> Prop
axiom clinvar:HasConflict       : clinvar:Release -> variant:Allele -> Prop
