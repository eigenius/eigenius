    "urn:eigenius:core:recommends": [
      "urn:eigenius:core:source_irl",
      "urn:eigenius:reflection:observed_at",
      "urn:eigenius:reflection:timestamp"
    ]
  },
  {
    "@id": "urn:eigenius:reflection:DerivedResource",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A resource produced by a typed program from other resources. The epistemic category is asserted by `is_a`; the audit trail (a `derivation` pointer to the chain-resident `ProgramTrace`) is recorded when the kernel can produce one. RunProgram outputs and AutoOnLoad-fired Verdicts always carry a trace. EigenQL `FIBER ... INTO` commits and post-translation comorphism reify outputs are still derived by construction (the substrate produced them) but may not have a kernel-generated trace yet — `derivation` is recommended rather than required so those still validate cleanly.",
    "urn:eigenius:core:short_name": "DerivedResource",
    "urn:eigenius:core:recommends": [
      "urn:eigenius:reflection:derivation"
    ]
  },
  {
    "@id": "urn:eigenius:reflection:VerifiedResource",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A resource that carries a machine-checked formal proof.",
    "urn:eigenius:core:short_name": "VerifiedResource",
    "urn:eigenius:core:subclass_of": ["urn:eigenius:reflection:DerivedResource"],
    "urn:eigenius:core:requires": [
      "urn:eigenius:reflection:derivation",
      "urn:eigenius:reflection:verification"
    ]
  },

  {
    "@id": "urn:eigenius:reflection:InstitutionEmittedDerivation",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A DerivedResource the kernel emitted as a side-effect of an AutoOnLoad institution dispatch — the test result the institution computed from the gated analysis spec + the data. Distinguished from author-authored DerivedResources (e.g. theorems committed by hand) because the kernel produced it deterministically from the (analysis, data) pair; the witness emitter walks these directly to admit IsDerivedAs(derivation_iri, canonical_proposition) without needing a separate ProgramTrace. Carries `reflection:from_subject` pointing at the gated subject (the analysis the kernel ran), `reflection:runtime_invocation` pointing at the producing RuntimeInvocation, and `reflection:canonical_proposition` carrying the chain-attested proposition. Statistics emits one per ANOVA effect; other institutions emit zero or more as appropriate.",
    "urn:eigenius:core:short_name": "InstitutionEmittedDerivation",
    "urn:eigenius:core:subclass_of": ["urn:eigenius:reflection:DerivedResource"],
    "urn:eigenius:core:requires": [
      "urn:eigenius:reflection:from_subject"
    ],
    "urn:eigenius:core:recommends": [
      "urn:eigenius:reflection:runtime_invocation",
      "urn:eigenius:reflection:canonical_proposition"
    ]
  },

  {
    "@id": "urn:eigenius:reflection:from_subject",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:description": "The gated subject (analysis spec, claim, etc.) the institution ran against to produce this derivation. Lets the per-derivation resource be navigated back to the resource that triggered its emission.",
    "urn:eigenius:core:short_name": "from_subject",
    "urn:eigenius:core:data_type": "urn:eigenius:core:resource"
  },

  {
    "@id": "urn:eigenius:reflection:runtime_invocation",
