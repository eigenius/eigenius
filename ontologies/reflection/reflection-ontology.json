[
  {
    "@id": "urn:eigenius:reflection:DeclaredResource",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A resource asserted by a human as an axiom, definition, or design decision. The epistemic foundation — anchored in human thought and intent.",
    "urn:eigenius:core:short_name": "DeclaredResource",
    "urn:eigenius:core:requires": [
      "urn:eigenius:reflection:declared_by"
