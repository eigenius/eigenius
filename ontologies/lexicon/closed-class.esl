          : forall (T : Set) => units:Quantity(u"1") -> ((lexicon:Entity -> core:float) -> lexicon:Entity -> core:float) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
