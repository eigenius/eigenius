// ── The pseudo-partitive (D95 slice 8c) ───────────────────────────────────────────
// `300 µl of CellTiter-Glo`, `0.2 µg/mL of doxycycline`, `24 h of puromycin selection`: an amount of the
// noun's stuff, as the prenominal measure phrase states it (`300 µl CellTiter-Glo`). `of` takes the
// measure phrase on its left and yields the predicative item a quantity seeds, which the modifier lift
// makes prenominal. One entry per dimension that measures an amount of stuff or of an activity —
// volume, mass, amount of substance, mass and amount concentration, time. Not the dimensionless unit:
// `15% of colon cancers` is the partitive's proportion (slice 7c), not cancers measuring 15%. The sense
// is `of`, as the partitive's is: the constructions differ by category, which the chart resolves, and a
// sense label of their own would put them before the sense ranker, which eliminated the plain `of` of
// `Depletion of WRN` in favour of this one (measured at the reseed after slice 8).
resource lexicon:of_amount_volume_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (q : units:Quantity(u"m^3")) => fun (x : lexicon:Entity) => ontology:has_quantity(x, u"m^3", q)
          : units:Quantity(u"m^3") -> lexicon:Entity -> Prop )
    );
}
resource lexicon:of_amount_volume : lexicon:LexicalEntry {
    core:description = "grammatical: pseudo-partitive of, a volume ('300 µl of CellTiter-Glo').";
    lexicon:form     = "of";
    lexicon:cat      = type_expr( lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_mp(u"m^3", lexicon:value)) );
    lexicon:sem      = lexicon:of_amount_volume_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"m^3") -> lexicon:Entity -> Prop );
    lexicon:sense    = "of";
}
