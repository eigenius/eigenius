// 11. Dimensional post-modifier LONG and unit/count post-modifiers
resource lexicon:long_post_mp : lexicon:LexicalEntry {
    core:description = "grammatical: dimensional post-modifier LONG after a measure phrase.";
    lexicon:form     = "long";
    lexicon:cat      = type_expr( lexicon:cat_unit_forall(fun (u : core:unit) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_mp(u, lexicon:value))) );
    lexicon:sem      = lexicon:eq_clause_sem;
    lexicon:sem_type = type_expr( forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> Prop );
    lexicon:sense    = "unit:postmod";
}
resource lexicon:unit_post_mp_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (q : units:Quantity(u"1")) => q
          : units:Quantity(u"1") -> units:Quantity(u"1") )
    );
}
resource lexicon:unit_post_adj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (q : units:Quantity(u"1")) => fun (x : lexicon:Entity) =>
            ontology:has_quantity(x, u"1", q)
          : units:Quantity(u"1") -> lexicon:Entity -> Prop )
    );
}
resource lexicon:unit_post_np_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (q : units:Quantity(u"1")) => ontology:kind_of(lexicon:Entity)
          : units:Quantity(u"1") -> lexicon:Entity )
    );
}

resource lexicon:nucleotides_post_mp : lexicon:LexicalEntry {
    core:description = "grammatical: unit post-modifier (nucleotides) forming a measure phrase.";
    lexicon:form     = "nucleotides";
    lexicon:cat      = type_expr( lexicon:bwd(lexicon:m_all, lexicon:cat_mp(u"1", lexicon:value), lexicon:cat_num) );
    lexicon:sem      = lexicon:unit_post_mp_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") -> units:Quantity(u"1") );
    lexicon:sense    = "unit:postmod";
