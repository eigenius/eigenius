// ── Offsets, `before`, `post`, `later`, and `by` with a value (D95 slice 8a) ─────────
// An offset is a measure phrase a temporal preposition takes on its LEFT: `72 h after transduction`,
// `6 h before collection`, `4 days post transduction` — x after (before) y by the interval q. The
// measure phrase is consumed first (`unit_application_backward`), so a bound on it composes too
// (`about 6 h before collection`). `post` is `after` in Latin and shares its relations; `before` is new
// to the closed class, with the NP roles `after` has. `later` takes a measure phrase on its left, `2
// days later` = `after 2 days`. `by` with a measured value is a deadline, `recovered by three weeks`;
// it does not lower to `prep_by`, and the passive `by` takes a noun phrase. VP adjuncts in the six
// finiteness variants, and a noun-modifier form.
resource lexicon:prep_before_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:adv_before(x, V, s))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nmod_before_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_before(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:prep_after_offset_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (y : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:adv_after_offset(y, u, q, V, s))
          : forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nmod_after_offset_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            ontology:prep_after_offset(x, y, u, q)
          : forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:prep_before_offset_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (y : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:adv_before_offset(y, u, q, V, s))
          : forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nmod_before_offset_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            ontology:prep_before_offset(x, y, u, q)
          : forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:prep_by_value_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:adv_by_value(u, q, V, s))
          : forall (u : core:unit) => units:Quantity(u) -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
