// ── PP noun-modifiers: prepositions as post-nominal modifiers (6-mod) ──
// "biomarker of WRN dependency" — a PP modifies the HEAD NOUN, refining it. Category
// `cat_pp / NP`: consume the standard NP, yield a `cat_pp` (⟦·⟧ = Entity → Prop), a
// predicate over the head noun's entities; the post-nominal refine rule (parser.rs) puts it
// under the noun's Σ:
//   `λy. λx. ontology:prep_of(x, y)`   (x = the head entity, y = the standard).
// `of` is the canonical noun-modifier (no VP-adjunct entry); in/for/with/on/from get a
// noun-modifier entry IN ADDITION to their VP-adjunct entry above, so a PP after a noun has
// BOTH attachments as separate parses (PP-attachment ambiguity, carried in the forest).
resource lexicon:nmod_of_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_of(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_in_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_in(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_for_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_for(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_with_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_with(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_on_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_on(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_from_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_from(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:of_nmod : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking a genitive/partitive relation ('depletion of WRN').";
    lexicon:form     = "of";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:nmod_of_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "of";
    lexicon:grade    = epistemic:declared;
}
