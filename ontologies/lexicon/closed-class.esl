    lexicon:sense    = "neither";
}

// ── the / this / that — definite + demonstrative determiners (D62 P2.2a) ──────
// The highest-frequency closed-class gap on real scientific prose. Categorially these
// ARE determiners (confirmed against references/openccg/grammars/core-en det.xsl), so
// they reuse the working determiner shape verbatim from `a` (singular subject + object
// positions). FIRST-CUT SEMANTICS: definite/demonstrative ≈ existential (`exists_sem`),
// a deliberate approximation so `the X` PARSES; the proper iota/uniqueness (definite) and
// deictic (this/that) semantics are a faithfulness refinement (ties to D61). Plural
// determination (`the X`s, `these`/`those`) is a later slice (these copies are `sg`,
// like `a`). `that` here is the demonstrative determiner; it coexists with the existing
// relativizer/complementizer `that` (competing chart edges, resolved downstream).
resource lexicon:the_subj : lexicon:LexicalEntry {
    core:description = "grammatical: definite article/determiner ('the gene').";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:the_ref_subj_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "the";
}
resource lexicon:the_obj : lexicon:LexicalEntry {
    core:description = "grammatical: definite article/determiner ('the gene').";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:the_ref_obj_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "the";
}
// Plural definite `the` (D62 CNL experiment): `the genes`, `the MMR genes`, `the lines`. The
