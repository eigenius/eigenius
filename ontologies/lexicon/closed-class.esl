    lexicon:form     = "for";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_arg(lexicon:prep_for), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:argmarker_sem;
