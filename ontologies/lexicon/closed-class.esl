    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (V : T -> Prop) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:approx(u"1", q, b), ontology:has_count(T, fun (x : T) => V(x), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop ) );
