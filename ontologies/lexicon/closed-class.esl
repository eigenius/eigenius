// ════════════════════════════════════════════════════════════════════
// closed-class — the determiner lexicon (D63 §8.3 Phase 1-2).
// ════════════════════════════════════════════════════════════════════
//
// The closed-class function words English's grammar provides (vs. the open-class
// WordNet content). Built on the bootstrapped `lexicon` schema (`cat_forall`,
// `SemTerm`, `lexicon:Entity`) + `logic` (`logic:False` for `no`). Domain-
// independent: every determiner is polymorphic in the noun type `T:Set`
// (CN-as-types), and the verb-subject position uses the schema entity top
// `lexicon:Entity` (D63 §8.3 decision ii), with specific types reaching slots by
// coercive subtyping. SUBJECT determiners denote `(A→Prop)→Prop`; OBJECT
// determiners are type-raised, denoting `(T→E→Prop)→(E→Prop)`.

namespace lexicon   = "urn:eigenius:lexicon";
namespace logic     = "urn:eigenius:logic";
namespace ontology  = "urn:eigenius:ontology";
namespace epistemic = "urn:eigenius:reflection:epistemic";
namespace measurements = "urn:eigenius:measurements";
namespace core         = "urn:eigenius:core";

// ── Quantifier cores (factored; D63 §8.3 Phase 1) ─────────────────────

// Universal (subject): λA. λV. ∀x:A. V(x).
resource lexicon:forall_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => forall (x : A) => V(x)
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Existential (subject): λA. λV. ∃x:A. V(x)   (impredicative ∃).
resource lexicon:exists_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) =>
            forall (C : Prop) => (forall (x : A) => (V(x) -> C)) -> C
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Negative (subject): λA. λV. ∀x:A. ¬V(x)   (¬P := P -> logic:False).
resource lexicon:no_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => forall (x : A) => (V(x) -> logic:False)
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Universal (object): λT. λTV. λsubj. ∀x:T. TV(x, subj).
resource lexicon:obj_forall_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : T) => TV(x, subj)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// Existential (object): λT. λTV. λsubj. ∃x:T. TV(x, subj).
resource lexicon:obj_exists_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : T) => (TV(x, subj) -> C)) -> C
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// Negative (object): λT. λTV. λsubj. ∀x:T. ¬TV(x, subj).
resource lexicon:obj_no_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : T) => (TV(x, subj) -> logic:False)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

// ── Definite / demonstrative determiners — REFERENTIAL, not existential ───────────────
// A definite ("the", "this"/"that", "these"/"those") denotes a fixed, presupposed referent
// `ontology:the(A) : A` (the ι operator), NOT an existential quantifier. Referential ⇒
// SCOPELESS: `¬require(the(A), subj)` is one reading, whereas reusing the existential
// (`obj_exists_sem`, a documented first-cut) spuriously split into `¬∃x.P` / `∃x.¬P` under
// negation — equivalent for a unique referent (the WRN-paper "did not require the exonuclease
// activity of WRN"). Genuine existentials (`a`/`an`/`some`) and cardinals keep the quantifier
// sems above, whose negation-scope split is real.
// Subject definite: λA. λV. V(the(A)).
resource lexicon:the_ref_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => V(ontology:the(A))
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Object definite: λT. λTV. λsubj. TV(the(T), subj).
resource lexicon:the_ref_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            TV(ontology:the(T), subj)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

// ── wh-question semantics (D63 §8.5, Slice 5b — subject wh) ───────────
// A wh-question denotes its **answer-property** ⟦Q(T)⟧ = T → Prop. A SUBJECT wh
// has its gap adjacent to the VP (`S\NP_T`), so it composes by plain application
// (no extraction): the wh-word is the identity on the VP, narrowing the answer to
// the queried type T via the category `cat_q(T)`. (Object/embedded extraction —
// `cat_q(T)/(S/NP_T)` + composition B + Eisner — is Slice 5c.)

// what — unrestricted subject wh (T = Entity): λV. λx:Entity. V(x).
// (η-expanded — the answer-property is a λ, so the felicity check pushes the
// queried type into the binder; cf. `which`, where this is what makes the
// restrictor narrow without needing contravariant function subtyping.)
resource lexicon:wh_what_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) => fun (x : lexicon:Entity) => V(x)
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// which — restricted subject wh, polymorphic in the noun type T: λA. λV. λx:A. V(x).
// The η-expansion binds `x:A` (= the queried type T), so the answer-property is
// `λx:T. V(x) : T → Prop` checked against ⟦Q(T)⟧; the Entity-typed VP `V` accepts
// the T-typed `x` by the COVARIANT application coercion (`T ≤ Entity`) the kernel
// supports — no contravariant function subtyping needed.
resource lexicon:wh_which_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => fun (x : A) => V(x)
          : forall (A : Set) => (A -> Prop) -> (A -> Prop) )
    );
}

// what — subject wh, unrestricted. `cat_q(Entity)/(S\NP_Entity)`: takes the VP on
// its right, yields the Entity-ranged answer-property.
resource lexicon:what_subj : lexicon:LexicalEntry {
    core:description = "grammatical: interrogative/relative pronoun.";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_q(lexicon:Entity), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:wh_what_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "what";
    lexicon:grade    = epistemic:declared;
}
// which — subject wh, restricted by a common noun. `cat_forall(λT. cat_q(T)/(S\NP_T))`:
// consumes the noun (binding T), then the VP, yielding the T-ranged answer-property.
// The VP's `S\NP_Entity` fills the `S\NP_T` slot by the contravariant functor
// subsumption (§8.2 item 4), so `Entity`-typed verbs answer `which gene` queries.
resource lexicon:which_subj : lexicon:LexicalEntry {
    core:description = "grammatical: relative pronoun introducing a relative clause ('genes which are essential').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_q(T), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:wh_which_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> (A -> Prop) );
    lexicon:sense    = "which";
    lexicon:grade    = epistemic:declared;
}

// ── Object wh — extraction (D63 §8.5, Slice 5c) ───────────────────────
// The OBJECT gap is non-adjacent ("what does HeLa affect [gap]?"), so the wh-word
// consumes a sentence-missing-its-object `S[q]/NP` (built by forward composition B:
// `does HeLa ∘ affect`). Distinct category from the subject wh (`/(S\NP_T)`); same
// answer-property sems (reused). CCG uses both categories side by side — context
// (the presence of the `S[q]/NP` vs the `S\NP` VP) selects which fires.

// what — object wh, unrestricted. `cat_q(Entity)/(S[q]/NP_Entity)`.
resource lexicon:what_obj : lexicon:LexicalEntry {
    core:description = "grammatical: interrogative/relative pronoun.";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_q(lexicon:Entity), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:wh_what_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "what";
    lexicon:grade    = epistemic:declared;
}
// which — object wh, restricted. `cat_forall(λT. cat_q(T)/(S[q]/NP_T))`: consumes
// the noun (binding T), then the `S[q]/NP` (the gapped sentence), yielding the
// T-ranged answer-property. The composed `S[q]/NP_Entity` fills the `S[q]/NP_T`
// slot by the contravariant functor subsumption (§8.2 item 4).
resource lexicon:which_obj : lexicon:LexicalEntry {
    core:description = "grammatical: relative pronoun introducing a relative clause ('genes which are essential').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_q(T), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:wh_which_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> (A -> Prop) );
    lexicon:sense    = "which";
    lexicon:grade    = epistemic:declared;
}

// ── Auxiliary `do`-support (D63 §8.5, Slice 5a — polar questions) ─────
// `does`/`do`/`did` invert to form a yes/no question: `aux + subject + base-VP`.
// Category `(S[q,fin] / (S[dcl,bse]\NP)) / NP` — takes the subject, then the BASE
// VP, yields a finite question `S[q]`. ⟦S[q]⟧ = Prop (the queried proposition,
// `denote_mood(q) = Prop`), so a polar question denotes the same `Prop` as the
// declarative, `mood`-tagged `q`. `do`-support is semantically vacuous (tense
// erased): the sem is `λsubj. λV. V(subj)`. The `bse` complement slot makes the
// `Fin`-meet reject `*does HeLa affects …`.

resource lexicon:do_aux_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (subj : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => V(subj)
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop )
    );
}

// does — present, 3sg do-support.
resource lexicon:does_aux : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular DO-support auxiliary, carrying tense in negation ('does not lead to cell death').";
    lexicon:form     = "does";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:sg)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "does";
    lexicon:grade    = epistemic:declared;
}
// do — present, non-3sg do-support.
resource lexicon:do_aux : lexicon:LexicalEntry {
    core:description = "grammatical: DO-support auxiliary, carrying tense in negation and questions ('do not lead').";
    lexicon:form     = "do";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:pl)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "do";
    lexicon:grade    = epistemic:declared;
}
// did — past do-support (tense erased in v1).
resource lexicon:did_aux : lexicon:LexicalEntry {
    core:description = "grammatical: past DO-support auxiliary ('did not respond').";
    lexicon:form     = "did";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "did";
    lexicon:grade    = epistemic:declared;
}

// ── Copula `be` — predicative (D63 §8.5, Slice 3a) ────────────────────
// `is`/`are` link a subject to a **predicative adjective**: `HeLa is primary`.
// Category `(S[dcl,fin]\NP) / (S[dcl,adj]\NP)` — it takes the **adjectival** (`adj`)
// predicate and supplies finiteness, yielding the finite VP. The `adj` complement
// slot makes the copula REQUIRED for adjectives (`*HeLa primary` is not a finite
// root), selects ONLY adjectives — not finite verbal VPs (`*HeLa is affects HeLa`)
// nor base verbs — and is what do-support (`bse`) correctly *won't* accept
// (`*does HeLa primary`). Semantically vacuous: `λP. P` (it only lifts finiteness).
resource lexicon:copula_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => P
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// is — copula, 3sg.
resource lexicon:is_copula : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
// are — copula, plural / non-3sg.
resource lexicon:are_copula : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
// was/were — PAST copula (predicate nominal/adjective): "WRN was a vulnerability", "WRN was
// essential", "cell lines were distinct". Mirror is/are_copula (over the `adj` complement) with past
// finiteness. The past copula KEEPS number agreement (was = sg, were = pl) — unlike past lexical
// verbs, which are number-agnostic. Tense is erased by ⟦·⟧, so the sem is the same vacuous `λP.P`.
resource lexicon:was_copula : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:were_copula : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// ── Predicate-nominal `a` (D63 §8.5, Slice 3c) ────────────────────────
// The PREDICATIVE indefinite article: "HeLa is **a cell line**". Distinct from the
// existential determiner `a` — here `a` is semantically the membership former, not a
// quantifier. It consumes the common noun (binding its type T) and yields an
// **predicate nominal** `S[dcl,pred]\NP` `λs. is_a(s, T)`, which the copula then
// lifts to a finite VP. It used to yield `S[dcl,adj]\NP` and reuse the adjectival
// copula outright ("no new copula"); that is what this feature split changes. It
// costs NO extra entry — `feat_meets` admits `pred ⊑ adj`, so the ordinary `adj`
// copula selects a predicate nominal unchanged (see the note above the copula
// section). The reason for the split is that
// `adj` licenses ATTRIBUTIVE use and a predicate nominal must not have it: sharing
// the feature let `a promising drug target for MSI` modify `cancers`, splitting the
// compound "MSI cancers" and asserting `is_a(WRN, cancer)` (d44dfda). Subject
// dispatch is by type-checking: an instance subject (`hela : CellLine ≤ Entity`)
// makes `is_a(hela, CellLine)` felicitous. (The `subclass_of` reading for KIND
// subjects awaits bare-plural/generic subjects — deferred.)
resource lexicon:pred_nominal_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (s : lexicon:Entity) => ontology:is_a(s, T)
          : forall (T : Set) => lexicon:Entity -> Prop )
    );
}
resource lexicon:a_pred : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('a gene').";
    lexicon:form     = "a";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:pred_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => lexicon:Entity -> Prop );
    lexicon:sense    = "a";
    lexicon:grade    = epistemic:declared;
}
// `an` — the ORTHOGRAPHIC ALLOMORPH of the predicative `a`, and it must exist wherever `a` does.
// It did not: `a` carried three entries (a_pred / a_subj / a_obj) and `an` only two, so "X is AN
// interaction between two genetic events" had NO predicate-nominal route. The NP was forced to be an
// existential quantifier, and the between-PP — with nowhere to land inside it — attached at the VP
// level and ended up on the SUBJECT, in every reading. Witnessed 2026-07-25 by a minimal pair that
// differs only in the article:
//   "… is A relationship between two genetic events."  → is_a(SL, ΣG#0. … prep_between(G#0, …))  ✓ nests
//   "… is AN interaction between two genetic events."  → prep_between(SL, …) in ALL readings      ✗
// Same defect class as the missing plural `some` (2026-07-24): an entry present for one surface form
// and absent for its variant, which reads as a GRAMMAR gap rather than the lexical hole it is.
resource lexicon:an_pred : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('an interaction').";
    lexicon:form     = "an";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:pred_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => lexicon:Entity -> Prop );
    lexicon:sense    = "a";
    lexicon:grade    = epistemic:declared;
}

// ── Kind-subject predicate nominal: `are` (D63 §8.5, Slice 3c kind subjects) ──
// "Genes are cell lines" → subclass_of(Gene, CellLine). The KIND copula `are`
// consumes the predicate noun (binding its type T), yielding a finite VP over a
// KIND subject `S[dcl,fin]\Kind`, sem `λK:Set. subclass_of(K, T)`. A bare-plural
// kind subject (`cat_kind`, ⟦·⟧ = Set) then applies. Distinct from the predicative
// adjective copula `are` (over `cat_np`) — the categories don't overlap.
resource lexicon:kind_nominal_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (k : Set) => ontology:subclass_of(k, T)
          : forall (T : Set) => Set -> Prop )
    );
}
resource lexicon:are_kind : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_kind)) );
    lexicon:sem      = lexicon:kind_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => Set -> Prop );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// ── Negation (D63 §8.6 Slice 6-neg) ──────────────────────────────────
// Verbal: "HeLa does not affect BRCA1" → affect(brca1, hela) → logic:False.
// Copular: "HeLa is not primary" → is_primary(hela) → logic:False.
// `¬P := P -> logic:False` (reusing logic:False). Verbal negation uses
// DECLARATIVE do-support (the non-inverted counterpart of the 5a question aux):
// `do/does/did : (S[dcl,fin]\NP)/(S[dcl,bse]\NP)`, sem `λP.P` (reuses `copula_sem`,
// just `λP.P`). `not` is a predicate-modifier `λP.λs. ¬P(s)`, in two forms (over
// `bse` verbal VPs and over `adj` adjectival predicates — no feature-polymorphism).

resource lexicon:neg_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) => (P(s) -> logic:False)
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// not — over a base verbal VP ("does not affect …").
resource lexicon:not_vp : lexicon:LexicalEntry {
    core:description = "grammatical: sentential negation ('does not lead to').";
    lexicon:form     = "not";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:neg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "not";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}
// not — over an adjectival predicate ("is not primary").
resource lexicon:not_adj : lexicon:LexicalEntry {
    core:description = "grammatical: sentential negation ('does not lead to').";
    lexicon:form     = "not";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:neg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "not";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}
// Declarative do-support (verbal negation / emphatic) — finiteness-lifting `λP.P`.
resource lexicon:does_decl : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular DO-support auxiliary, carrying tense in negation ('does not lead to cell death').";
    lexicon:form     = "does";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "do";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}
resource lexicon:do_decl : lexicon:LexicalEntry {
    core:description = "grammatical: DO-support auxiliary, carrying tense in negation and questions ('do not lead').";
    lexicon:form     = "do";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "do";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}
resource lexicon:did_decl : lexicon:LexicalEntry {
    core:description = "grammatical: past DO-support auxiliary ('did not respond').";
    lexicon:form     = "did";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "do";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}

// ── Progressive + perfect auxiliaries (D63 §8.9 Slice 6-aux) ──────────
// The aspect auxiliaries are **finiteness-lifters** `λP.P` (aspect/tense erased — like
// the copula and do-support), selecting the participle VPs the importer now generates
// (`eigenius-wordnet::inflect`, the 6-aux morphology keystone):
//   progressive `be` over a present-participle (`ger`) VP — "HeLa is affecting BRCA1";
//   perfect    `have` over a past-participle (`pss`) VP — "HeLa has affected BRCA1".
// Category `(S[dcl,fin]\NP) / (S[dcl,ger|pss]\NP)` — the `ger`/`pss` complement slot
// selects exactly the participle form (so `*is affect` / `*has affecting` get no parse),
// and the result is a finite VP. Application-only, no new combinators; the predicate
// axiom is unchanged (finiteness erased by `⟦·⟧`). All reuse `copula_sem` (`λP.P`).
// `is`/`are` are also the copula (over `adj`) — distinct categories, no overlap.

// Progressive `be` (over `ger`): is/are (present), was/were (past — tense erased).
resource lexicon:is_prog : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:ger), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:are_prog : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:ger), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:was_prog : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:ger), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:were_prog : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:ger), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// Perfect `have` (over `pss`): has/have (present), had (past — tense erased).
resource lexicon:has_perf : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of HAVE — perfect auxiliary.";
    lexicon:form     = "has";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "have";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:have_perf : lexicon:LexicalEntry {
    core:description = "grammatical: present of HAVE — perfect auxiliary.";
    lexicon:form     = "have";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "have";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:had_perf : lexicon:LexicalEntry {
    core:description = "grammatical: past of HAVE — perfect auxiliary.";
    lexicon:form     = "had";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "have";
    lexicon:grade    = epistemic:declared;
}

// ── Passive (short / agentless) `be` (D63 §8.9 Slice 6-aux) ───────────
// "BRCA1 is affected" → ∃a:Entity. affects(BRCA1, a) (the agent is existentially
// closed — "BRCA1 is affected by *something*"). Unlike progressive/perfect, passive is
// a **voice alternation**: the surface subject is the logical *object* (patient) and the
// agent is demoted. It is realized as a single `be` entry that takes the **unsaturated**
// transitive past-participle TV `(S[dcl,pss]\NP)/NP` (object-first) — *before* its object
// slot is filled — and yields a patient-subject finite VP, closing the agent:
//   `λTV. λp. ∃a:Entity. TV(p, a)`   (impredicative ∃, as in `exists_sem`).
// Taking the TV as a functor argument is what blocks over-generation: once the object is
// supplied ("affected BRCA1" : `S[pss]\NP`), this `is` no longer matches, so
// `*BRCA1 is affected HeLa` has no parse. Distinct from the copula (`adj` VP), progressive
// (`ger` VP), and perfect `have` (saturated `pss` VP) — different argument categories, no
// overlap. (The AGENTIVE long passive "…by HeLa" is a separate construction — it needs a
// voice feature to keep `*is affected HeLa` out — and is deferred.)
resource lexicon:passive_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) => fun (p : lexicon:Entity) =>
            forall (C : Prop) => (forall (a : lexicon:Entity) => (TV(p, a) -> C)) -> C
          : (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:is_passive : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:passive_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:are_passive : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:passive_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:was_passive : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:passive_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:were_passive : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:passive_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// ── Agentive (long) passive: `by` + passive `be` (D63 §8.9 Slice 6-aux) ──
// "BRCA1 is affected by HeLa" → affects(BRCA1, HeLa) (the agent is supplied, not closed).
// `by` is the agent marker: it consumes the agent NP, then the **unsaturated** active
// past-participle TV `(S[dcl,pss]\NP)/NP` on its left, yielding a PASSIVE patient-VP
// tagged with the voice feature `pass` — `S[dcl,pass]\NP`, sem `λp. TV(p, agent)`. The
// `pass` result is what keeps the over-generation out: an active object-saturated
// participle is `S[pss]\NP` (not `pass`), so it can never feed the passive `be` below,
// and `*BRCA1 is affected HeLa` has no parse. `by`'s category is
// `(S[pass]\NP \ (S[pss]\NP)/NP) / NP_agent`.
resource lexicon:by_agent_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (agent : lexicon:Entity) => fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) =>
            fun (p : lexicon:Entity) => TV(p, agent)
          : lexicon:Entity -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:by_agent : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking the agent of a passive ('represented by these data').";
    lexicon:form     = "by";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pss), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:by_agent_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "by";
    lexicon:grade    = epistemic:declared;
}

// Passive `be` over the agentive `pass` VP — finiteness-lifter `λP.P` (reuses
// `copula_sem`), `(S[dcl,fin]\NP)/(S[dcl,pass]\NP)`. Selects ONLY the `pass` VP that the
// `by`-phrase builds, never the active `pss` form — so it lifts "affected by HeLa" but
// not "affected BRCA1".
resource lexicon:is_passive_by : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:are_passive_by : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:was_passive_by : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:were_passive_by : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}
// BASE form under a modal — "can/may be limited by toxicity". The `is/are/was/were` above lift the
// agentive `pass` VP to a FINITE clause; a modal ("can") selects a BASE `S[dcl,bse]\NP` complement, so
// the agentive passive under a modal needs this `be : (S[dcl,bse]\NP)/(S[dcl,pass]\NP)`. Same
// `copula_sem` (λP.P) and same `pass`-only selection (never the active `pss`).
resource lexicon:be_passive_by : lexicon:LexicalEntry {
    core:description = "grammatical: base form of BE — passive auxiliary under a modal.";
    lexicon:form     = "be";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pass), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// ── Modal auxiliaries (D63 §8.9 Slice 6-aux) ─────────────────────────
// "HeLa can affect BRCA1" → Possible(affects(brca1, hela)); "… must …" → Necessary(…).
// Categorially a do-support-shaped aux `(S[dcl,fin]\NP)/(S[dcl,bse]\NP)` (selects the
// BASE VP, like `do`/`does`), so `*HeLa can affects BRCA1` (finite complement) gets no
// parse. The modal wraps the whole proposition with the OPAQUE operator (logic layer):
//   `λP. λs. logic:Possible(P(s))`  /  `λP. λs. logic:Necessary(P(s))`.
// can/could/may/might → Possible (◇); must → Necessary (□). `will`/`would`/`should`
// each carry their OWN opaque operator (`logic:Will`/`Would`/`Should`) — they are not
// ◇/□ (future / conditional / weak-deontic), so collapsing them would be lossy; the
// justification-logic reasoning institution supplies their meaning (logic.esl). All
// share the base-VP-selecting modal category, matching core-en's `Modal` family
// `(S[dcl]\NP)/(S[base]\NP)`. (`shall` and the epistemic→grade refinement are follow-ons.)
resource lexicon:poss_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) => logic:Possible(P(s))
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nec_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) => logic:Necessary(P(s))
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:can_modal : lexicon:LexicalEntry {
    core:description = "grammatical: modal auxiliary of possibility/ability.";
    lexicon:form     = "can";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:poss_sem;
