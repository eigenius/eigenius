    core:description = "grammatical: preposition marking a genitive/partitive relation ('depletion of WRN').";
    lexicon:form     = "of";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:nmod_of_sem;
