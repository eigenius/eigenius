    lexicon:sem      = lexicon:nmod_from_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "from";
    lexicon:grade    = epistemic:declared;
}

// ── Comparative `than` marker (D63 §8.12 Slice 6-cmp) ─────────────────
// "X is larger than Y": `than` marks the comparison STANDARD `Y`. It consumes the
// standard NP and yields a `cat_pp_than` (⟦·⟧ = Entity), semantically the identity on the
// standard entity (`λy. y`); the comparative adjective `(S[adj]\NP)/cat_pp_than` then
// builds `λx. gt(deg_A(x), deg_A(y))`. A distinct `cat_pp_than` (not a bare NP) forces
// the `than`, so `*X is larger Y` has no parse.
resource lexicon:than_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (y : lexicon:Entity) => y : lexicon:Entity -> lexicon:Entity ) );
}
resource lexicon:than_marker : lexicon:LexicalEntry {
    lexicon:form     = "than";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:cat_pp_than, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:than_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "than";
    lexicon:grade    = epistemic:declared;
}

// ── Determiner entries (D63 §8.3 Phase 2) ─────────────────────────────
// Subject category:  cat_forall(num, λT. S/(S\NP_T))
// Object category:   cat_forall(num, λT. (S\NP_E)\((S\NP_E)/NP_T)),  E = lexicon:Entity
// `every`/`each` sg, `all` pl universal; `a` sg, `some` sg existential; `no` sg
// negative. (Plural `some`/`no` and the definite `the` are follow-ons — D63 §8.3.)

// every — universal, singular.
resource lexicon:every_subj : lexicon:LexicalEntry {
    lexicon:form     = "every";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "every"; 
    lexicon:grade    = epistemic:declared;
}
resource lexicon:every_obj : lexicon:LexicalEntry {
    lexicon:form     = "every";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:fwd(lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:obj_forall_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "every"; 
    lexicon:grade    = epistemic:declared;
}
// each — universal, singular (≈ every truth-conditionally).
resource lexicon:each_subj : lexicon:LexicalEntry {
    lexicon:form     = "each";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "each"; 
    lexicon:grade    = epistemic:declared;
}
// all — universal, plural.
resource lexicon:all_subj : lexicon:LexicalEntry {
    lexicon:form     = "all";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "all"; 
    lexicon:grade    = epistemic:declared;
}
resource lexicon:all_obj : lexicon:LexicalEntry {
    lexicon:form     = "all";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:fwd(lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:obj_forall_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "all"; 
    lexicon:grade    = epistemic:declared;
}
// a — existential, singular.
resource lexicon:a_subj : lexicon:LexicalEntry {
    lexicon:form     = "a";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "a"; 
