    core:description = "grammatical: existential determiner — at least one member ('some cells died').";
    lexicon:form     = "some";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_exists_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "some";
}
// some — existential, PLURAL ('some MSI lines'). Mirrors `several`/`many` below (plural existential
// `cat_forall(pl, …)`); `some` shipped only the singular, so a plural "some X" had NO determiner reading
// and fell back to the UMLS `C0205392` "Some (qualifier value)" NOUN, which piled into a spurious
// `compound_kind` (D63 Defect 2a). The UMLS noun is now withheld at import (DETERMINER_SURFACES).
resource lexicon:some_pl_subj : lexicon:LexicalEntry {
    core:description = "grammatical: plural existential determiner ('some MSI lines'). First-cut existential, cardinality opaque.";
    lexicon:form     = "some";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "some";
}
resource lexicon:some_pl_obj : lexicon:LexicalEntry {
    core:description = "grammatical: plural existential determiner ('some MSI lines'), object position.";
    lexicon:form     = "some";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_exists_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "some";
}

// ── Plural quantifier determiners (`several`/`many`/`few`/`most`/`both`) ───────────────
// These were MISSING from the determiner lexicon, so `several cancers` had no quantifier reading and
// fell back to `several`'s WordNet gradable-ADJECTIVE entry used prenominally (`gt(deg_a, std)` — the
// spurious "more-several-than-standard" modifier). Modeled on the plural `the`/`some`: an
// existential-PLURAL determiner (category `cat_forall(pl, …)`, `exists_sem`/`obj_exists_sem`). The
// exact cardinality (`several` > 2, `both` = 2, `most` = majority) is a FIRST-CUT existential and left
// opaque, as with the other determiners; the WordNet adjective reading is dropped at seed time when a
// determiner reading is present (the cross-POS adjective prune, `parse/seed.rs`).
