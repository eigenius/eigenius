        ( fun (mu : lexicon:Entity -> core:float) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(mu(x), mu(y))
          : (lexicon:Entity -> core:float) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
