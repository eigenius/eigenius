// ── Clausal complements: complementizer `that` (D63 §8.11 Slice 6-cl) ──
// "HeLa shows that BRCA1 affects HeLa" → shows(affects(brca1, hela), hela). The
// complementizer `that` wraps a finite declarative clause into an embedded CP
// (`cat_cp`, ⟦·⟧ = Prop), semantically vacuous (`λp. p`). A clause-taking verb is then
// `(S\NP)/cat_cp` — an opaque report axiom `Prop → Entity → Prop` (the complement is NOT
// asserted; intensional). Distinct from the relativizer `that` (a reserved-word rule
// over a *gapped* body): the complementizer needs a FULL finite S on its right and a
// VERB on its left; `cat_cp` not being a clause root keeps a leading "that …" from
// parsing as a standalone sentence.
resource lexicon:that_comp_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (p : Prop) => p : Prop -> Prop ) );
}
resource lexicon:that_comp : lexicon:LexicalEntry {
    core:description = "grammatical: singular distal demonstrative determiner, or the complementiser introducing a clause ('showed that WRN is essential').";
    lexicon:form     = "that";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_cp, lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:that_comp_sem;
    lexicon:sem_type = type_expr( Prop -> Prop );
    lexicon:sense    = "that";
    lexicon:grade    = epistemic:declared;
}

// ── Clausal subordinators (D62 §2d) ───────────────────────────────────
// Concrete sentential categories `(S\S)/S` (medial, comma-free first cut), NOT the
// category-polymorphic coordination rule: a subordinator joins two clauses with a fixed
// binary connective. Expert-informed (docs/notes/d62-subordinator-design-findings.md).
//
// `if` is the CONDITIONAL and is therefore NOT an opaque binary: in a dependent type
// theory "if P then Q" is the NATIVE implication `P → Q` (a first-class Prop, since an
// arrow between Props is a Prop — cf. `¬P := P → False`). Encoding it opaquely would
// forfeit modus ponens in the checker. "S₁ if S₂" ⇒ `⟦S₂⟧ → ⟦S₁⟧` (antecedent S₂ on the
// right is consumed first by `/S`, then the matrix S₁ on the left by `\S`).
//   sem: `λs₂:Prop. λs₁:Prop. (s₂ → s₁)`  :  Prop → Prop → Prop
// (Fronted "If S₂, S₁" + comma, the modal/Kratzer-restrictor conditional, and the factive
// subordinators because/although/while are follow-ons — see the findings note.)
resource lexicon:if_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) => (s2 -> s1)
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:if_subord : lexicon:LexicalEntry {
    core:description = "grammatical: conditional subordinator ('if the gene is deleted').";
    lexicon:form     = "if";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:if_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "if";
    lexicon:grade    = epistemic:declared;
}

// `but` — contrastive conjunction (D62 §2d). Sentential-binary `(S\S)/S` (core-en's
// Conj-Sentential-Binary), NOT the category-polymorphic and/or coordination rule. Maps to
// `logic:And`: every `but` in the WRN source is "X but (not) Y" — truth-conditionally plain
// conjunction, the contrast rhetorical and carried by explicit negation, so the adversative
// relation is not part of the typed claim. "S₁ but S₂" ⇒ `logic:And(⟦S₁⟧, ⟦S₂⟧)` (the right
// clause S₂ is consumed first by `/S`, then the left clause S₁ by `\S`, so the first λ binds
// S₂ and the second S₁ — order preserved). A distinct contrast-preserving `logic:But` is the
// documented upgrade (findings note; GH #95) for when discourse structure is load-bearing.
//   sem: `λs₂:Prop. λs₁:Prop. logic:And(s₁, s₂)`  :  Prop → Prop → Prop
resource lexicon:but_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) => logic:And(s1, s2)
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:but_subord : lexicon:LexicalEntry {
    core:description = "grammatical: contrastive coordinating conjunction.";
    lexicon:form     = "but";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:but_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "but";
    lexicon:grade    = epistemic:declared;
}

// ── Referential pronouns (D62 §2e / D64 Phase A — the open-parse carrier) ──
// A referential pronoun is categorially a plain NP (core-en `ProNP` = NP) whose semantics
// is an UNRESOLVED referent — an open-parse *hole* (D64). The committed entry stores the
// typed placeholder `lexicon:anaphor : lexicon:Entity`, so it gate-passes closed (the kernel
// stays hole-free at rest); the lookup bridge freshens that placeholder into a per-occurrence
// free variable at parse time, yielding an **open** parse the D64 resolver later fills (by
// substituting a chain antecedent + re-gating). Slice 1 is the deterministic carrier only —
// no resolver; `Case` (he/him) and morphosyntactic features are deferred. `it` = sg, `they`
// = pl; both refer to an `Entity` (the referent's narrower type is recovered at resolution).
axiom lexicon:anaphor : lexicon:Entity
resource lexicon:anaphor_sem : lexicon:SemTerm {
    lexicon:term = type_expr( lexicon:anaphor );
}
resource lexicon:it_pron : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular pronoun.";
    lexicon:form     = "it";
    lexicon:cat      = type_expr( lexicon:cat_np(lexicon:Entity, lexicon:sg) );
    lexicon:sem      = lexicon:anaphor_sem;
    lexicon:sem_type = type_expr( lexicon:Entity );
    lexicon:sense    = "it";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:they_pron : lexicon:LexicalEntry {
    core:description = "grammatical: third-person plural subject pronoun.";
    lexicon:form     = "they";
    lexicon:cat      = type_expr( lexicon:cat_np(lexicon:Entity, lexicon:pl) );
    lexicon:sem      = lexicon:anaphor_sem;
    lexicon:sem_type = type_expr( lexicon:Entity );
    lexicon:sense    = "they";
    lexicon:grade    = epistemic:declared;
}

// `we` — DEICTIC 1st-person-plural pronoun. Unlike `it`/`they` it is NOT anaphoric: it
// denotes the utterance's author(s), a fixed discourse referent. So it is a CLOSED NP (no
// hole) whose sem is the designated `lexicon:speaker` constant — "we analysed X" ⇒
// analysed(X, speaker). (A later refinement may resolve `speaker` to the document's actual
// author entity; for now it is a stable deictic constant, plural.)
axiom lexicon:speaker : lexicon:Entity
resource lexicon:speaker_sem : lexicon:SemTerm {
    lexicon:term = type_expr( lexicon:speaker );
}
resource lexicon:we_pron : lexicon:LexicalEntry {
    core:description = "grammatical: first-person plural subject pronoun.";
    lexicon:form     = "we";
    lexicon:cat      = type_expr( lexicon:cat_np(lexicon:Entity, lexicon:pl) );
    lexicon:sem      = lexicon:speaker_sem;
    lexicon:sem_type = type_expr( lexicon:Entity );
    lexicon:sense    = "we";
    lexicon:grade    = epistemic:declared;
}

// ── Possessive determiners `its` / `their` (D62 §2e / D64; core-en `PossPro` = a
// determiner `NP/N` whose LF links the formed NP to a possessor) ───────────────
// A possessive is a DETERMINER (not a bare NP) carrying an anaphoric *possessor* hole. It
// existentially quantifies the noun (first-cut, like `a`/`the`) and restricts the referent
// to one POSSESSED BY the (held-open) possessor: "its N" ⇒ `∃x:N. poss_of(x, ?ref) ∧ V(x)`.
// `poss_of` is a **polymorphic** possession relation — `∀(A:Set) => A → Entity → Prop` — so it
// applies to a noun-typed `x:A` for any noun type `A` (the Entity-typed prepositions cannot).
// The possessor `lexicon:anaphor` is the same referent hole the parser freshens (here NESTED
// inside the determiner λ — see `freshen_anaphor`), so a possessive yields an OPEN parse the
// D64 resolver fills. `its` = sg, `their` = pl; subject + object positions, mirroring `a`.
// (`their` composes like the existing plural determiner `all` — "their genes affect HeLa" ⇒ an
// open parse with one possessor hole — given a plural-aware lemmatizer that reduces the plural
// noun to its lexicon form; with the bare `Identity` lemmatizer the plural noun simply never
// seeds, which is a lemmatizer concern, not a grammar gap.)
axiom lexicon:poss_of : forall (A : Set) => A -> lexicon:Entity -> Prop
resource lexicon:poss_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) =>
            forall (C : Prop) => (forall (x : A) => (lexicon:poss_of(A, x, lexicon:anaphor) -> V(x) -> C)) -> C
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
resource lexicon:poss_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : T) => (lexicon:poss_of(T, x, lexicon:anaphor) -> TV(x, subj) -> C)) -> C
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:its_subj : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular possessive determiner ('its function').";
    lexicon:form     = "its";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:poss_subj_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "its";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:its_obj : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular possessive determiner ('its function').";
    lexicon:form     = "its";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:poss_obj_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "its";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:their_subj : lexicon:LexicalEntry {
    core:description = "grammatical: third-person plural possessive determiner ('their survival').";
    lexicon:form     = "their";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:poss_subj_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "their";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:their_obj : lexicon:LexicalEntry {
    core:description = "grammatical: third-person plural possessive determiner ('their survival').";
    lexicon:form     = "their";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:poss_obj_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "their";
    lexicon:grade    = epistemic:declared;
}

// ── PP adjuncts: prepositions as VP modifiers (D63 §8.13 Slice 6-mod) ──
// "HeLa affects BRCA1 in MSI" — a PP modifies the VP, adding an OPAQUE prepositional
// conjunct. Category `((S[dcl,fin]\NP) \ (S[dcl,fin]\NP)) / NP`: consume the standard NP,
// then the VP on the left, yielding a VP with the locative conjoined:
//   `λx. λV. λs. logic:And(V(s), ontology:prep_in(s, x))`  (no event variable; the
// relation is opaque, mapped to the domain predicate's context slot by the institution).
// One entry per preposition; the `by`-passive agent (§8.9) is the special built case.
// (PP-as-noun-modifier — "biomarker of X" — and the N-N kind compound are the close
// follow-ons; this build does the VP-adjunct + the named-entity compound.)
resource lexicon:prep_in_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_in(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_for_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_for(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_with_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_with(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_to_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_to(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_on_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_on(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_from_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_from(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// `between` / `within` (D62 connectives batch): opaque prepositional relations, mirroring `in` —
// the VP-adjunct sem (`λx.λV.λs. And(V(s), prep(s,x))`) and the noun-modifier sem
// (`λy.λx. prep(x,y)`); the two entries reuse `in`'s VP-adjunct and `cat_pp` categories.
resource lexicon:prep_between_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_between(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:prep_within_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:prep_within(s, x))
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nmod_between_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_between(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:nmod_within_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_within(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
