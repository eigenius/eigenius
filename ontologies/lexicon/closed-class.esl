    lexicon:sem      = lexicon:should_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "should";
    lexicon:scope_bearing = true;
}

// ── Clausal complements: complementizer `that` (D63 §8.11 Slice 6-cl) ──
// "HeLa shows that BRCA1 affects HeLa" → shows(affects(brca1, hela), hela). The
// complementizer `that` wraps a finite declarative clause into an embedded CP
// (`cat_cp`, ⟦·⟧ = Prop), semantically vacuous (`λp. p`). A clause-taking verb is then
// `(S\NP)/cat_cp` — an opaque report axiom `Prop → Entity → Prop` (the complement is NOT
// asserted; intensional). Distinct from the relativizer `that` (a reserved-word rule
// over a *gapped* body): the complementizer needs a FULL finite S on its right and a
// VERB on its left; `cat_cp` not being a clause root keeps a leading "that …" from
// parsing as a standalone sentence.
resource lexicon:that_comp_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (p : Prop) => p : Prop -> Prop ) );
}
resource lexicon:that_comp : lexicon:LexicalEntry {
    core:description = "grammatical: the complementiser introducing a clause ('showed that WRN is essential').";
    lexicon:form     = "that";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_cp, lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:that_comp_sem;
    lexicon:sem_type = type_expr( Prop -> Prop );
    lexicon:sense    = "that";
}

// ── Clausal subordinators (D62 §2d) ───────────────────────────────────
// Concrete sentential categories `(S\S)/S` (medial, comma-free first cut), NOT the
// category-polymorphic coordination rule: a subordinator joins two clauses with a fixed
// binary connective. Expert-informed (docs/notes/d62-subordinator-design-findings.md).
//
// `if` is the CONDITIONAL and is therefore NOT an opaque binary: in a dependent type
// theory "if P then Q" is the NATIVE implication `P → Q` (a first-class Prop, since an
// arrow between Props is a Prop — cf. `¬P := P → False`). Encoding it opaquely would
// forfeit modus ponens in the checker. "S₁ if S₂" ⇒ `⟦S₂⟧ → ⟦S₁⟧` (antecedent S₂ on the
// right is consumed first by `/S`, then the matrix S₁ on the left by `\S`).
//   sem: `λs₂:Prop. λs₁:Prop. (s₂ → s₁)`  :  Prop → Prop → Prop
// (Fronted "If S₂, S₁" + comma, the modal/Kratzer-restrictor conditional, and the factive
// subordinators because/although/while are follow-ons — see the findings note.)
resource lexicon:if_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) => (s2 -> s1)
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:if_subord : lexicon:LexicalEntry {
    core:description = "grammatical: conditional subordinator ('if the gene is deleted').";
    lexicon:form     = "if";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:if_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "if";
}

// `but` — contrastive conjunction (D62 §2d). Sentential-binary `(S\S)/S` (core-en's
// Conj-Sentential-Binary), NOT the category-polymorphic and/or coordination rule. Maps to
// `logic:And`: every `but` in the WRN source is "X but (not) Y" — truth-conditionally plain
// conjunction, the contrast rhetorical and carried by explicit negation, so the adversative
// relation is not part of the typed claim. "S₁ but S₂" ⇒ `logic:And(⟦S₁⟧, ⟦S₂⟧)` (the right
// clause S₂ is consumed first by `/S`, then the left clause S₁ by `\S`, so the first λ binds
// S₂ and the second S₁ — order preserved). A distinct contrast-preserving `logic:But` is the
// documented upgrade (findings note; GH #27) for when discourse structure is load-bearing.
//   sem: `λs₂:Prop. λs₁:Prop. logic:And(s₁, s₂)`  :  Prop → Prop → Prop
resource lexicon:but_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) => logic:And(s1, s2)
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:but_subord : lexicon:LexicalEntry {
    core:description = "grammatical: contrastive coordinating conjunction.";
    lexicon:form     = "but";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:but_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "but";
}

// ── FACTIVE subordinators (D62 2d, Fork A) ─────────────────────────────────
// `because` / `although` / `while` presuppose BOTH clauses, and the decided treatment makes that
// presupposition a typing requirement: `logic:Because : Π(p q:Prop) → p → q → Prop` takes proofs of
// both. The parser never proves a clause — felicity is not truth — so the proof arguments are
// HYPOTHETICAL.
//
// `lexicon:hypothesis_of` is the Prop sibling of `lexicon:anaphor_of` (the demonstrative's
// restrictor-typed referent hole) and works the same way: it stands in the derivation as a closed
// constant so the entry gate-passes and the term stays a `Prop` throughout composition, and the
// FELICITY GATE freshens each occurrence into a typed free variable — a hole of kind
// `ProofObligation`. Keeping the term a `Prop` during composition is what makes §5's projection
// account fall out: negation and the modals apply to it normally and do not discharge the
// hypothesis, so the obligation projects through them.
//
// It is an axiom inhabiting an arbitrary `Prop`, which is only sound because it never survives the
// gate — exactly the discipline `anaphor_of : ∀(A:Set) → A` already carries for `Set`.
axiom lexicon:hypothesis_of : forall (P : Prop) => P

resource lexicon:because_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) =>
            logic:Because(s1, s2, lexicon:hypothesis_of(s1), lexicon:hypothesis_of(s2))
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:because_subord : lexicon:LexicalEntry {
    core:description = "grammatical: causal subordinator, FACTIVE ('because the assay works').";
    lexicon:form     = "because";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:because_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "because";
}
resource lexicon:although_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) =>
            logic:Although(s1, s2, lexicon:hypothesis_of(s1), lexicon:hypothesis_of(s2))
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:although_subord : lexicon:LexicalEntry {
    core:description = "grammatical: concessive subordinator, FACTIVE ('although the assay fails').";
    lexicon:form     = "although";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:although_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "although";
}
resource lexicon:while_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) =>
            logic:While(s1, s2, lexicon:hypothesis_of(s1), lexicon:hypothesis_of(s2))
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:while_subord : lexicon:LexicalEntry {
    core:description = "grammatical: temporal/concessive subordinator, FACTIVE ('while the cell divides').";
    lexicon:form     = "while";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:while_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "while";
}

// `though` and `whilst` are the same factive relations under other spellings — they share
// `although_sem` / `while_sem` rather than restating them, so the paradigm has one definition per
// RELATION, not per surface.
resource lexicon:though_subord : lexicon:LexicalEntry {
    core:description = "grammatical: concessive subordinator, FACTIVE ('though the assay fails').";
    lexicon:form     = "though";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:although_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "though";
}
resource lexicon:whilst_subord : lexicon:LexicalEntry {
    core:description = "grammatical: temporal/concessive subordinator, FACTIVE ('whilst the cell divides').";
    lexicon:form     = "whilst";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:while_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "whilst";
}

// ── `unless` and `whereas` (D62 2d, the two non-factive subordinators) ──────
// These are the subordinators the findings note does NOT route through Fork A. Fork A
// (`docs/notes/d62-subordinator-design-findings.md`) covers `because`/`although`/`while`, which are
// FACTIVE: their decided treatment is `Because : Π(p q:Prop) → p → q → Prop` with hypothetical
// proof variables threaded through the derivation — an engine extension, not a lexical row. These
// two need neither.
//
// `unless` is `if`'s negative twin and uses the same native implication: "S₁ unless S₂" is
// `¬⟦S₂⟧ → ⟦S₁⟧`, with intuitionistic `¬P = P → False`. Non-factive, no new logic type.
resource lexicon:unless_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (s2 : Prop) => fun (s1 : Prop) => ((s2 -> logic:False) -> s1)
          : Prop -> Prop -> Prop )
    );
}
resource lexicon:unless_subord : lexicon:LexicalEntry {
    core:description = "grammatical: negative conditional subordinator ('unless the assay works').";
    lexicon:form     = "unless";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:unless_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "unless";
}
// `whereas` asserts BOTH clauses and contrasts them, which is `but`'s case exactly: the contrast is
// rhetorical and not part of the typed claim, so it denotes the same proposition as the
// `and`-coordination (the FINAL `but` decision in the findings note, verified against every `but`
// in the WRN source). It reuses `but_sem` rather than restating it — one definition of what the
// contrastive conjunction means.
resource lexicon:whereas_subord : lexicon:LexicalEntry {
    core:description = "grammatical: contrastive subordinator ('whereas the control is clear').";
    lexicon:form     = "whereas";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:but_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "whereas";
}

// ── FRONTED subordinators — «Because X, Y» beside the «Y because X» above ──────
// Every entry above is `(S\S)/S`: it takes its clause on the RIGHT and the result attaches to a
// matrix clause on its LEFT. Fronted, the matrix is on the right, so the category needed is
// `(S/S)/S` — which is exactly what `category::is_sentence_premodifier` names and what the
// `AbsorbComma` fronted-modifier comma already consumes. Only the outer slash flips; the comma is
// optional either way, which is how the fronted POSITION was isolated from the punctuation
// (core-en battery, 2026-10-25: «The study failed because the gene affects cells.» parsed and the
// fronted order did not, with or without the comma).
//
// Each sem is reused VERBATIM, which is why this is eight entries and not a design: `because_sem`
// is `λs2. λs1. Because(s1, s2, …)` — it takes the SUBORDINATE clause first in both orders.
//
// `but` is excluded: «But Y, X» is a discourse connective, not a fronted subordinator. `when` has
// no subordinator entry in either order, and no temporal relation to denote one with.

resource lexicon:if_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED subordinator ('if the assay works, the study fails').";
    lexicon:form     = "if";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:if_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "if";
}
resource lexicon:because_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED subordinator ('because the assay works, the study fails').";
    lexicon:form     = "because";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:because_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "because";
}
resource lexicon:although_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED subordinator ('although the assay works, the study fails').";
    lexicon:form     = "although";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:although_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "although";
}
resource lexicon:while_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED subordinator ('while the assay works, the study fails').";
    lexicon:form     = "while";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:while_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "while";
}
resource lexicon:though_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED subordinator ('though the assay works, the study fails').";
    lexicon:form     = "though";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:although_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "though";
}
resource lexicon:whilst_subord_fronted : lexicon:LexicalEntry {
