// ── PREDICATE-NOMINAL siblings of the copula and of adjectival negation ──
// `a_pred`/`an_pred` now yield `S[dcl,pred]\NP` rather than `S[dcl,adj]\NP`, because a predicate
// nominal is PREDICATIVE ONLY while `adj` licenses attributive use (see the `pred` note in
// lexicon-ontology.esl, and d44dfda for the 7 `invalid` rows the shared feature cost).
//
// Everything that SELECTS a predicative complement must therefore select `pred` as well as `adj`.
// That is exactly the copula and adjectival negation — enumerated here rather than bound over,
// because binding over `lexicon:Fin` would also admit `bse`/`inf`/`ger`/`pss`/`pass` and re-open
// do-support ("*is affect"). Two values, two entries; the enumeration IS the statement.

// is — copula over a PREDICATE NOMINAL, 3sg: "WRN is a drug target".
resource lexicon:is_copula_prednom : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// are — copula over a PREDICATE NOMINAL, plural.
resource lexicon:are_copula_prednom : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// was — PAST copula over a PREDICATE NOMINAL, sg.
resource lexicon:was_copula_prednom : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// were — PAST copula over a PREDICATE NOMINAL, plural.
resource lexicon:were_copula_prednom : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
    lexicon:grade    = epistemic:declared;
}

// not — over a PREDICATE NOMINAL ("is not a drug target").
resource lexicon:not_adj_prednom : lexicon:LexicalEntry {
    core:description = "grammatical: sentential negation ('does not lead to').";
    lexicon:form     = "not";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:neg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "not";
    lexicon:grade    = epistemic:declared;
    lexicon:scope_bearing = true;
}
