// PLAIN-NP definite — `the gene` as an argument rather than a generalised quantifier. The four
// entries above are the only definite categories there were, and all four are type-raised:
// `S/(S\NP)` as subject, `VP\(VP/NP)` as object, with no plain `cat_np` intermediate. Measured
// consequences (2026-10-25): NP coordination over definites was unreachable — «The gene and the
// protein affect cells.» failed while «A gene and a protein affect cells.» parsed, and ONE definite
// conjunct sufficed to break it — and `UnaryKind::IdentityPredicate` never fired, because its
// `cat_np` pattern never matched a definite.
//
// No new machinery: `ontology:the : forall (A : Set) => A` gives `the(T) : T`, and
// `⟦cat_np(T, num)⟧ = T`, so the plain form is `cat_forall(num, λT. cat_np(T, num))` over
// `λA. the(A)`, consumed by `CombKind::DepApply` exactly as the raised forms are. Measured as a
// layer before merging: XIAP units 51 → 59, +2 core-en battery constructions, `encoded` and
// `ambiguous` byte-identical.
resource lexicon:the_plain_np : lexicon:LexicalEntry {
    core:description = "grammatical: definite article, PLAIN NP form ('the gene' as an argument).";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:cat_np(T, lexicon:sg)) );
    lexicon:sem      = lexicon:the_plain_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => A );
    lexicon:sense    = "the_plain";
}
resource lexicon:the_plain_np_pl : lexicon:LexicalEntry {
    core:description = "grammatical: definite article, PLAIN NP form, plural ('the genes').";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:cat_np(T, lexicon:pl)) );
    lexicon:sem      = lexicon:the_plain_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => A );
    lexicon:sense    = "the_plain";
}
