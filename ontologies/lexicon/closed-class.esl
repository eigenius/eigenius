            logic:And(measurements:gt(lexicon:card(T, y), lexicon:card(T, x)), ontology:fold_lower(k, lexicon:card(T, x), lexicon:card(T, y)))
          : forall (T : Set) => units:Quantity(u"1") -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
