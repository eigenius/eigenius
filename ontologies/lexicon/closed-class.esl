    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) => logic:Should(P(s))
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:will_modal : lexicon:LexicalEntry {
    core:description = "grammatical: modal auxiliary of future tense.";
    lexicon:form     = "will";
