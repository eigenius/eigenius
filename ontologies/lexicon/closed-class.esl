// ── Bounded counts (D95 slice 7b) ─────────────────────────────────────────────────
// A bound on a cardinal is a bound on its count: `at least 1,000 cells` is
// `∃q. le(1000, q) ∧ has_count(Cell, V, q)` (D95 implementation plan, slice 7, decision 3). Each marker
// carries two count-determiner entries, subject and object, taking the bare number — `cat_num`, which
// a digit seeds and a word numeral has — before the noun, or after it for `or more`, `or less`
// and `or fewer`. `fewer than` and `or fewer` bound counts only. Number agreement is not checked
// (`num_any`): `more than one MMR gene` takes a singular noun.
resource lexicon:lt_bound_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (V : T -> Prop) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:lt(u"1", q, b), ontology:has_count(T, fun (x : T) => V(x), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop ) );
}
resource lexicon:lt_bound_count_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:lt(u"1", q, b), ontology:has_count(T, fun (x : T) => TV(x, subj), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
}
resource lexicon:gt_bound_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (V : T -> Prop) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:lt(u"1", b, q), ontology:has_count(T, fun (x : T) => V(x), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop ) );
}
resource lexicon:gt_bound_count_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:lt(u"1", b, q), ontology:has_count(T, fun (x : T) => TV(x, subj), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
}
resource lexicon:ge_bound_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (V : T -> Prop) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:le(u"1", b, q), ontology:has_count(T, fun (x : T) => V(x), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop ) );
}
resource lexicon:ge_bound_count_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:le(u"1", b, q), ontology:has_count(T, fun (x : T) => TV(x, subj), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
}
resource lexicon:le_bound_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (b : units:Quantity(u"1")) => fun (T : Set) => fun (V : T -> Prop) =>
            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:le(u"1", q, b), ontology:has_count(T, fun (x : T) => V(x), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop ) );
