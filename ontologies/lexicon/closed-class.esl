// ── Prepositions over a measured value (D95 slice 5) ──────────────────────────────
// A measure phrase is not an NP, so a preposition takes it through an entry of its own: the MP
// sibling of its NP entry, not a widening of it. `cat_unit_forall` binds the unit from the measure
// phrase (`UnitApply`), and every entry takes the VALUE reading, `cat_mp(u, value)` — `at 37 °C` is
// 310.15 K; a difference reading (`5 °C warmer`) is slice 7's. VP adjuncts come in the six
// finiteness variants the NP adjuncts have (`at` has no VP adjunct over an NP). The WRN methods
// govern measure phrases with `with` 16, `for` 11, `in` 9, `at` 7, `of` 7, `after` 2 (D95).
resource lexicon:prep_at_value_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), ontology:adv_at_value(u, q, V, s))
          : forall (u : core:unit) => units:Quantity(u) -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:nmod_at_value_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (u : core:unit) => fun (q : units:Quantity(u)) => fun (x : lexicon:Entity) =>
            ontology:prep_at_value(x, u, q)
          : forall (u : core:unit) => units:Quantity(u) -> lexicon:Entity -> Prop )
    );
}
