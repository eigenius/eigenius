resource lexicon:in_arg : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking location or containment ('in colon cancers').";
    lexicon:form     = "in";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_arg(lexicon:prep_in), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:argmarker_sem;
