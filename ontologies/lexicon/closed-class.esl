// ── Proportions (D95 slice 7c) ──────────────────────────────────────────────────────
// `15% of colon cancers are MSI`, `in more than half of the samples`, `none of the helicases`. A
// proportion is `has_proportion(x, P, q)`: of the group `x` — the partitive's noun phrase, a definite
// plural or a kind — the members satisfying `P` are the proportion `q`. The value is a measure phrase at
// the dimensionless unit: a percentage, or `half` (1/2). The partitive `of` takes it on its left and the
// quantified noun phrase on its right, which it scopes over the group; a bound or a range on the value
// (`more than half`, `45–60%`) reaches `of` through `unit_constraint_backward`. `none of`, `all of`,
// `each of`, `most of` and `some of` state the proportion themselves: 0, 1, more than 1/2, more than
// 0. Each comes as a subject and an object quantifier.
resource lexicon:half_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( units:mk_quantity(r"1/2", 0) : units:Quantity(u"1") ) );
}
resource lexicon:half_value : lexicon:LexicalEntry {
    core:description = "grammatical: the proportion one half ('half of the cell pellet', 'more than half of the samples').";
    lexicon:form     = "half";
    lexicon:cat      = type_expr( lexicon:cat_mp(u"1", lexicon:value) );
    lexicon:sem      = lexicon:half_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") );
    lexicon:sense    = "half";
}
resource lexicon:of_proportion_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (Q : (lexicon:Entity -> Prop) -> Prop) => fun (V : lexicon:Entity -> Prop) =>
            Q(fun (x : lexicon:Entity) => ontology:has_proportion(x, fun (y : lexicon:Entity) => V(y), q))
        : units:Quantity(u"1") -> ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop ) );
}
resource lexicon:of_proportion_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (Q : (lexicon:Entity -> Prop) -> Prop) => fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            Q(fun (x : lexicon:Entity) => ontology:has_proportion(x, fun (y : lexicon:Entity) => TV(y, s), q))
        : units:Quantity(u"1") -> ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
}
resource lexicon:of_proportion_subj : lexicon:LexicalEntry {
    core:description = "grammatical: partitive of a proportion ('15% of colon cancers').";
    lexicon:form     = "of";
    lexicon:cat      = type_expr( lexicon:bwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))), lexicon:cat_mp(u"1", lexicon:value)) );
    lexicon:sem      = lexicon:of_proportion_subj_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") -> ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "of";
}
