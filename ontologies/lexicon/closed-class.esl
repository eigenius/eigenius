// ── Exclusive-focus particle: post-nominal `alone` (D61 faithfulness) ──
// "each event alone" / "this event alone" — `alone` is a BARE post-nominal `cat_pp` (⟦·⟧ = Entity →
// Prop), unlike the preposition noun-modifiers above which are `cat_pp / NP` (they still need an
// object). Adjacent to the head noun, it fires the SAME post-nominal refine rule (parser.rs,
// `RefineKind::PpMod`): `[cat_n(C)] [cat_pp]` → `Σx:C. sole(x)`; the determiner then wraps the
// refined noun, so `each event alone` → `∀x:(Σy:event. sole(y)). …` under ANY determiner. The
// exclusive `ontology:sole` operator is the "= only" reading (`this event alone` ≡ `only this
// event`), kept opaque. Closed-class ⇒ cap-EXEMPT (the pooled-cap split), so the faithful reading is
// seeded at the tight cap and need not be widened in — where the correct senses rank #0/#1 — instead
// of losing to a widen-admitted noun pile. The WordNet PREDICATIVE adjective `alone` ("the child is
// alone") stays a separate open-class entry; this adds only the post-nominal focus reading.
resource lexicon:sole_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => ontology:sole(x)
          : lexicon:Entity -> Prop )
    );
}
resource lexicon:alone_focus : lexicon:LexicalEntry {
    core:description = "grammatical: exclusive focus particle — by itself, to the exclusion of others; 'X alone' means 'only X' ('each event alone').";
    lexicon:form     = "alone";
    lexicon:cat      = type_expr( lexicon:cat_pp );
    lexicon:sem      = lexicon:sole_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> Prop );
    lexicon:sense    = "alone";
}
// ── Pre-nominal NP focus `only` (D61 faithfulness follow-up, 2026-11-05) ─────
// Pre-nominal counterpart of post-nominal `alone` (`lexicon:alone_focus`), reusing
// `ontology:sole : lexicon:Entity -> Prop`. Where `alone` refines a bare `cat_n` inside
// the determiner ("each event alone"), `only` attaches OUTSIDE the determiner to the
// generalized quantifier (`[only [an assay]]`, `[only [one pattern]]`, `[only [four residues]]`,
// `[only [the count]]`), restricting its witness by `ontology:sole`.
resource lexicon:only_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (Q : (lexicon:Entity -> Prop) -> Prop) => fun (V : lexicon:Entity -> Prop) =>
            Q(fun (x : lexicon:Entity) => logic:And(ontology:sole(x), V(x)))
          : ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop )
    );
}
resource lexicon:only_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (Q : (lexicon:Entity -> Prop) -> Prop) =>
          fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) =>
          fun (s : lexicon:Entity) =>
            Q(fun (x : lexicon:Entity) => logic:And(ontology:sole(x), TV(x, s)))
          : ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:only_s : lexicon:LexicalEntry {
    core:description = "grammatical: pre-nominal exclusive focus particle on a subject or PP-object NP ('only an assay', 'only one pattern').";
    lexicon:form     = "only";
    lexicon:cat      = type_expr( lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, n))), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, n))))) );
    lexicon:sem      = lexicon:only_subj_sem;
    lexicon:sem_type = type_expr( ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "only";
}
resource lexicon:only_o : lexicon:LexicalEntry {
    core:description = "grammatical: pre-nominal exclusive focus particle on an object NP ('involve only four residues').";
    lexicon:form     = "only";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:only_obj_sem;
    lexicon:sem_type = type_expr( ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "only";
}

// ── Comparative `than` marker (D63 §8.12 Slice 6-cmp) ─────────────────
// "X is larger than Y": `than` marks the comparison STANDARD `Y`. It consumes the
// standard NP and yields a `cat_pp_than` (⟦·⟧ = Entity), semantically the identity on the
// standard entity (`λy. y`); the comparative adjective `(S[adj]\NP)/cat_pp_than` then
// builds `λx. gt(deg_A(x), deg_A(y))`. A distinct `cat_pp_than` (not a bare NP) forces
// the `than`, so `*X is larger Y` has no parse.
resource lexicon:than_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (y : lexicon:Entity) => y : lexicon:Entity -> lexicon:Entity ) );
}
resource lexicon:than_marker : lexicon:LexicalEntry {
    core:description = "grammatical: comparative complementiser ('larger than').";
    lexicon:form     = "than";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_than, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:than_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "than";
}
// `compared to` / `compared with` mark the standard as `than` does (D95 slice 9, decision 4): `a median
// 0.56-fold fewer deletion mutations … compared to typical lineages`. Only a comparative takes
// `cat_pp_than`; the verb `compared` keeps its own entries (`were compared to negative controls`).
resource lexicon:compared_to_marker : lexicon:LexicalEntry {
    core:description = "grammatical: comparison standard marker ('fewer deletion mutations compared to typical lineages').";
    lexicon:form     = "compared to";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_than, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:than_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "compared to";
}
