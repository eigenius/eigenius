// ════════════════════════════════════════════════════════════════════
// closed-class — the determiner lexicon (D63 §8.3 Phase 1-2).
// ════════════════════════════════════════════════════════════════════
//
// The closed-class function words English's grammar provides (vs. the open-class
// WordNet content). Built on the bootstrapped `lexicon` schema (`cat_forall`,
// `SemTerm`, `lexicon:Entity`) + `logic` (`logic:False` for `no`). Domain-
// independent: every determiner is polymorphic in the noun type `T:Set`
// (CN-as-types), and the verb-subject position uses the schema entity top
// `lexicon:Entity` (D63 §8.3 decision ii), with specific types reaching slots by
// coercive subtyping. SUBJECT determiners denote `(A→Prop)→Prop`; OBJECT
// determiners are type-raised, denoting `(T→E→Prop)→(E→Prop)`.

namespace lexicon   = "urn:eigenius:lexicon";
namespace logic     = "urn:eigenius:logic";
namespace ontology  = "urn:eigenius:ontology";
namespace measurements = "urn:eigenius:measurements";
namespace core         = "urn:eigenius:core";
namespace eigentt      = "urn:eigenius:eigentt";   // D99 §10 identity forms (the identity copula)
namespace units        = "urn:eigenius:units";

// ── Quantifier cores (factored; D63 §8.3 Phase 1) ─────────────────────

// Universal (subject): λA. λV. ∀x:A. V(x).
resource lexicon:forall_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => forall (x : A) => V(x)
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Existential (subject): λA. λV. ∃x:A. V(x)   (impredicative ∃).
resource lexicon:exists_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) =>
            forall (C : Prop) => (forall (x : A) => (V(x) -> C)) -> C
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Negative (subject): λA. λV. ∀x:A. ¬V(x)   (¬P := P -> logic:False).
resource lexicon:no_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => forall (x : A) => (V(x) -> logic:False)
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Universal (object): λT. λTV. λsubj. ∀x:T. TV(x, subj).
resource lexicon:obj_forall_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : T) => TV(x, subj)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// Existential (object): λT. λTV. λsubj. ∃x:T. TV(x, subj).
resource lexicon:obj_exists_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : T) => (TV(x, subj) -> C)) -> C
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// Negative (object): λT. λTV. λsubj. ∀x:T. ¬TV(x, subj).
resource lexicon:obj_no_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : T) => (TV(x, subj) -> logic:False)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

// ── Definite determiner `the` — REFERENTIAL, not existential ──────────────────────────
// The plain definite denotes a fixed, presupposed referent `ontology:the(A) : A` (the ι
// operator), NOT an existential quantifier. Referential ⇒ SCOPELESS: `¬require(the(A), subj)`
// is one reading, whereas reusing the existential (`obj_exists_sem`, a documented first-cut)
// spuriously split into `¬∃x.P` / `∃x.¬P` under negation — equivalent for a unique referent
// (the WRN-paper "did not require the exonuclease activity of WRN"). Genuine existentials
// (`a`/`an`/`some`) and cardinals keep the quantifier sems above, whose negation-scope split is
// real. DEMONSTRATIVES ("this"/"that"/"these"/"those") are NOT ι — they are anaphoric
// (`dem_ref_*_sem` below, D64): their referent is a discourse antecedent, carried as a
// restrictor-typed hole.
// Subject definite: λA. λV. V(the(A)).
resource lexicon:the_ref_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => V(ontology:the(A))
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Object definite: λT. λTV. λsubj. TV(the(T), subj).
resource lexicon:the_ref_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            TV(ontology:the(T), subj)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// Plain definite NP: λA. the(A) — the same ι term standing ALONE, at the noun's own type. The two
// sems above wrap `ontology:the` in a predicate slot and so yield TYPE-RAISED categories; this one
// yields a plain `cat_np` argument (`the_plain_np` below).
resource lexicon:the_plain_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => ontology:the(A) : forall (A : Set) => A )
    );
}

// ── Demonstratives are ANAPHORIC, not ι (D64, docs/notes/d64-demonstratives-as-holes.md) ──────
// "these findings" refers back into the discourse; denoting it `ontology:the(A)` (as above) was a
// misparse this corpus had been blessing — the discourse link was unrepresented. A demonstrative
// NP now carries a RESTRICTOR-TYPED referent hole: `lexicon:anaphor_of : ∀(A:Set) → A` is the
// polymorphic sibling of `lexicon:anaphor` (pronouns, below). It cannot be freshened at seed time
// (the determiner has not met its noun, so the hole's type is unknown); the applied form rides
// the derivation as a closed constant and the FELICITY GATE freshens `anaphor_of(A)` — the
// restrictor concrete after β — into a hole typed AT `A`, so the resolution re-gate vetoes a
// type-wrong antecedent ("these findings" resolves only to findings; subclass antecedents
// accepted via `Layer::is_subclass_of`). Plain `the` STAYS ι — "the MLH1 promoter" is genuinely
// unique-referential.
axiom lexicon:anaphor_of : forall (A : Set) => A
// Subject demonstrative: λA. λV. V(anaphor_of(A)).
resource lexicon:dem_ref_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => V(lexicon:anaphor_of(A))
          : forall (A : Set) => (A -> Prop) -> Prop )
    );
}
// Object demonstrative: λT. λTV. λsubj. TV(anaphor_of(T), subj).
resource lexicon:dem_ref_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            TV(lexicon:anaphor_of(T), subj)
          : forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

// ── wh-question semantics (D63 §8.5, Slice 5b — subject wh) ───────────
// A wh-question denotes its **answer-property** ⟦Q(T)⟧ = T → Prop. A SUBJECT wh
// has its gap adjacent to the VP (`S\NP_T`), so it composes by plain application
// (no extraction): the wh-word is the identity on the VP, narrowing the answer to
// the queried type T via the category `cat_q(T)`. (Object/embedded extraction —
// `cat_q(T)/(S/NP_T)` + composition B + Eisner — is Slice 5c.)

// what — unrestricted subject wh (T = Entity): λV. λx:Entity. V(x).
// (η-expanded — the answer-property is a λ, so the felicity check pushes the
// queried type into the binder; cf. `which`, where this is what makes the
// restrictor narrow without needing contravariant function subtyping.)
resource lexicon:wh_what_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) => fun (x : lexicon:Entity) => V(x)
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// which — restricted subject wh, polymorphic in the noun type T: λA. λV. λx:A. V(x).
// The η-expansion binds `x:A` (= the queried type T), so the answer-property is
// `λx:T. V(x) : T → Prop` checked against ⟦Q(T)⟧; the Entity-typed VP `V` accepts
// the T-typed `x` by the COVARIANT application coercion (`T ≤ Entity`) the kernel
// supports — no contravariant function subtyping needed.
resource lexicon:wh_which_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) => fun (x : A) => V(x)
          : forall (A : Set) => (A -> Prop) -> (A -> Prop) )
    );
}

// what — subject wh, unrestricted. `cat_q(Entity)/(S\NP_Entity)`: takes the VP on
// its right, yields the Entity-ranged answer-property.
resource lexicon:what_subj : lexicon:LexicalEntry {
    core:description = "grammatical: interrogative/relative pronoun.";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_q(lexicon:Entity), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:wh_what_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "what";
}
// which — subject wh, restricted by a common noun. `cat_forall(λT. cat_q(T)/(S\NP_T))`:
// consumes the noun (binding T), then the VP, yielding the T-ranged answer-property.
// The VP's `S\NP_Entity` fills the `S\NP_T` slot by the contravariant functor
// subsumption (§8.2 item 4), so `Entity`-typed verbs answer `which gene` queries.
resource lexicon:which_subj : lexicon:LexicalEntry {
    core:description = "grammatical: relative pronoun introducing a relative clause ('genes which are essential').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_q(T), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:wh_which_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> (A -> Prop) );
    lexicon:sense    = "which";
}

// ── Object wh — extraction (D63 §8.5, Slice 5c) ───────────────────────
// The OBJECT gap is non-adjacent ("what does HeLa affect [gap]?"), so the wh-word
// consumes a sentence-missing-its-object `S[q]/NP` (built by forward composition B:
// `does HeLa ∘ affect`). Distinct category from the subject wh (`/(S\NP_T)`); same
// answer-property sems (reused). CCG uses both categories side by side — context
// (the presence of the `S[q]/NP` vs the `S\NP` VP) selects which fires.

// what — object wh, unrestricted. `cat_q(Entity)/(S[q]/NP_Entity)`.
resource lexicon:what_obj : lexicon:LexicalEntry {
    core:description = "grammatical: interrogative/relative pronoun.";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_q(lexicon:Entity), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:wh_what_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "what";
}
// which — object wh, restricted. `cat_forall(λT. cat_q(T)/(S[q]/NP_T))`: consumes
// the noun (binding T), then the `S[q]/NP` (the gapped sentence), yielding the
// T-ranged answer-property. The composed `S[q]/NP_Entity` fills the `S[q]/NP_T`
// slot by the contravariant functor subsumption (§8.2 item 4).
resource lexicon:which_obj : lexicon:LexicalEntry {
    core:description = "grammatical: relative pronoun introducing a relative clause ('genes which are essential').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_q(T), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:wh_which_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> (A -> Prop) );
    lexicon:sense    = "which";
}

// ── Free relatives: `what` as a headless relative NP (2026-10-28) ──────
// «The study reported what affects cells.» / «what the check returned» — a clause missing one NP,
// used as an ARGUMENT. `what` is "the thing(s) which": one token supplying the silent head, the
// relativization, and the definiteness.
//
// It is the DECLARATIVE TWIN of the two interrogative entries above, and deliberately shaped to
// say so: the same body in each gap position, differing only in the result and the sem.
// `what_subj` yields `cat_q(Entity)` over the answer-property `λV.λx. V(x)`; this yields
// `cat_np(Entity, sg)` over the maximal satisfier. The object-gap body is `S[dcl]/NP` rather than
// `what_obj`'s `S[q]/NP` — a free relative embeds a declarative, and `S[dcl]/NP` is already built,
// since it is what `relativize` takes for an object relative.
//
// This needs NO rule, which is why it is here and not in `constructions.rs`. `relativize` must be
// a rule because a HEADED relative's result TYPE is built from the body's sem
// (`cat_n(Σx:C. body(x), num)`) and a lexical category is static. A free relative has no head to
// refine, so its category is the fixed `cat_np(Entity, sg)`; only the SEM depends on the body, and
// a sem is a λ-term. `⟦S\NP⟧ = ⟦S/NP⟧ = Entity → Prop`, so ONE term serves both gaps.
//
// DEFINITE, not existential: a free relative is maximal — "what affects cells" is everything that
// does — so it takes the ι operator over the Σ and projects. `the(Σ).1` is the same shape
// `the_plain_np` builds over a refined noun, with the Σ built here instead of by the relativizer.
resource lexicon:free_rel_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) =>
            eigentt:fst(ontology:the(exists x : lexicon:Entity => V(x)))
          : (lexicon:Entity -> Prop) -> lexicon:Entity )
    );
}
// what — free relative over a SUBJECT gap. `cat_np(Entity,sg)/(S[dcl]\NP_Entity)`.
resource lexicon:what_free_rel_subj : lexicon:LexicalEntry {
    core:description = "grammatical: free relative pronoun, subject gap ('what affects cells').";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_np(lexicon:Entity, lexicon:sg), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:free_rel_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> lexicon:Entity );
    lexicon:sense    = "what_free_rel";
}
// what — free relative over an OBJECT gap. `cat_np(Entity,sg)/(S[dcl]/NP_Entity)`.
resource lexicon:what_free_rel_obj : lexicon:LexicalEntry {
    core:description = "grammatical: free relative pronoun, object gap ('what the check returned').";
    lexicon:form     = "what";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_np(lexicon:Entity, lexicon:sg), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:free_rel_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> lexicon:Entity );
    lexicon:sense    = "what_free_rel";
}

// ── Determiner free relatives / embedded `which`-clauses (2026-11-05) ──
// Declarative NP twins of `lexicon:which_subj` and `lexicon:which_obj`, mirroring how
// `lexicon:what_free_rel_subj` and `lexicon:what_free_rel_obj` pair with `what_subj` /
// `what_obj` above. Consumes the restrictor noun `T : Set` via `cat_forall`, then the
// gapped declarative body (`S[dcl]\NP_T` for a subject gap, `S[dcl]/NP_T` for an object
// gap, filled by contravariant functor subsumption from an `Entity`-typed verb), and
// yields a singular definite NP `cat_np(T, sg)` denoting the maximal satisfier
// `the(Σx:T. V(x)).1 : T`. Returning at `T` (rather than `Entity`) lets coercive
// subtyping (`T ≤ Entity`) fire at the governing verb or preposition's argument slot
// once `T` is instantiated to a concrete class.
resource lexicon:which_free_rel_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (A : Set) => fun (V : A -> Prop) =>
            eigentt:fst(ontology:the(exists x : A => V(x)))
          : forall (A : Set) => (A -> Prop) -> A )
    );
}
resource lexicon:which_fr_s : lexicon:LexicalEntry {
    core:description = "grammatical: determiner free relative / embedded interrogative, subject gap ('turns on which cutoff is used').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_np(T, lexicon:sg), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:which_free_rel_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> A );
    lexicon:sense    = "which";
}
resource lexicon:which_fr_o : lexicon:LexicalEntry {
    core:description = "grammatical: determiner free relative / embedded interrogative, object gap ('reported which cutoff the study used').";
    lexicon:form     = "which";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_np(T, lexicon:sg), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:cat_np(T, lexicon:num_any)))) );
    lexicon:sem      = lexicon:which_free_rel_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> A );
    lexicon:sense    = "which";
}

// ── Auxiliary `do`-support (D63 §8.5, Slice 5a — polar questions) ─────
// `does`/`do`/`did` invert to form a yes/no question: `aux + subject + base-VP`.
// Category `(S[q,fin] / (S[dcl,bse]\NP)) / NP` — takes the subject, then the BASE
// VP, yields a finite question `S[q]`. ⟦S[q]⟧ = Prop (the queried proposition,
// `denote_mood(q) = Prop`), so a polar question denotes the same `Prop` as the
// declarative, `mood`-tagged `q`. `do`-support is semantically vacuous (tense
// erased): the sem is `λsubj. λV. V(subj)`. The `bse` complement slot makes the
// `Fin`-meet reject `*does HeLa affects …`.
//
// These three and the declarative three below share ONE sense, `do`: a question and a
// declarative differ in category, not in meaning, and the sense ranker chooses among
// meanings. With a key per category, «does» offered the ranker two senses under one
// gloss, and keeping only `does` (the question entry) dropped every declarative reading
// of «Each event alone does not lead to cell death.»

resource lexicon:do_aux_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (subj : lexicon:Entity) => fun (V : lexicon:Entity -> Prop) => V(subj)
          : lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop )
    );
}

// does — present, 3sg do-support.
resource lexicon:does_aux : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular DO-support auxiliary, carrying tense in negation and questions ('does not lead to cell death').";
    lexicon:form     = "does";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:sg)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "do";
}
// do — present, non-3sg do-support.
resource lexicon:do_aux : lexicon:LexicalEntry {
    core:description = "grammatical: DO-support auxiliary, carrying tense in negation and questions ('do not lead').";
    lexicon:form     = "do";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:pl)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "do";
}
// did — past do-support (tense erased in v1).
resource lexicon:did_aux : lexicon:LexicalEntry {
    core:description = "grammatical: past DO-support auxiliary ('did not respond').";
    lexicon:form     = "did";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:q, lexicon:fin), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:do_aux_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "do";
}

// ── Copula `be` — predicative (D63 §8.5, Slice 3a) ────────────────────
// `is`/`are` link a subject to a **predicative adjective**: `HeLa is primary`.
// Category `(S[dcl,fin]\NP) / (S[dcl,adj]\NP)` — it takes the **adjectival** (`adj`)
// predicate and supplies finiteness, yielding the finite VP. The `adj` complement
// slot makes the copula REQUIRED for adjectives (`*HeLa primary` is not a finite
// root), selects ONLY adjectives — not finite verbal VPs (`*HeLa is affects HeLa`)
// nor base verbs — and is what do-support (`bse`) correctly *won't* accept
// (`*does HeLa primary`). Semantically vacuous: `λP. P` (it only lifts finiteness).
resource lexicon:copula_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => P
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// is — copula, 3sg.
resource lexicon:am_copula : lexicon:LexicalEntry {
    core:description = "grammatical: first-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "am";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
resource lexicon:is_copula : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula or auxiliary.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
// are — copula, plural / non-3sg.
resource lexicon:are_copula : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
// was/were — PAST copula (predicate nominal/adjective): "WRN was a vulnerability", "WRN was
// essential", "cell lines were distinct". Mirror is/are_copula (over the `adj` complement) with past
// finiteness. The past copula KEEPS number agreement (was = sg, were = pl) — unlike past lexical
// verbs, which are number-agnostic. Tense is erased by ⟦·⟧, so the sem is the same vacuous `λP.P`.
resource lexicon:was_copula : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula or auxiliary.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
resource lexicon:were_copula : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula or auxiliary.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
// be — base-form copula over predicative adjective / nominal (`to be essential`, `may be a target`).
resource lexicon:be_copula : lexicon:LexicalEntry {
    core:description = "grammatical: base/infinitive form of BE — copula over a predicative adjective or nominal.";
    lexicon:form     = "be";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}

// ── IDENTITY COPULA (D99 §10's identity form; D63 §8.5's membership `a` is its counterpart) ──
// "The NOD2-to-NF-kB axis is the inflammatory-bowel-disease arm." Both sides are REFERRING
// expressions and the claim is that they denote the same entity. `is a Y` gives
// `ontology:is_a(s, T)` — MEMBERSHIP, which cannot express this: `is the lever` is not `is a lever`,
// and encoding the definite as the indefinite drops the uniqueness the claim asserts (R2).
//
// **Takes the complement as an ordinary NP rather than binding the noun's Set.** The natural shape,
// a predicative `the` at `fun (T : Set) => ... eigentt:Eq(Entity, s, ontology:the(T))`, does NOT
// type-check: `ontology:the : forall (A : Set) => A` gives `the(T) : T`, and coercive subtyping
// (Luo 2012) reaches `Entity` from a CONCRETE class the chain knows is a subclass — never from a
// bound variable, for which nothing says `T ≤ Entity`. Ascription does not help and ESL has no
// bounded quantification. Of the 147 entries here that bind `T`, every one uses it as a Set
// ARGUMENT or returns at `T`; none takes `the(T)` as an Entity-typed term. Letting the definite NP
// form normally and putting the identity on the COPULA sidesteps it: both sides arrive at their own
// concrete classes and coerce at the argument slots.
//
// Written with `eigentt:Eq`, the ESL surface spelling of the kernel's `Id` (D99 §10), so the
// proposition COMPUTES — `refl` inhabits it, `J` eliminates it, `apart` refutes it. An opaque
// 2-place axiom would parse the same sentences and prove nothing with them, the defect the WordNet
// importer records for opaque `be`.
//
// Measured over the 1,056-sentence CNL corpus on `wordnet-umls-hpo-aligned-2026-10-24-identity`
// (provenance 38,391 / 20,533 / 864): parsed **501 → 557**, grammar-gap 555 → 499, source units
// fully covered **41 → 51** of 274, **0 sentences lost**. Sems verified on its targets —
// `ni_p_ile380thr = the(Σsubject. prep_of(…)).1`.
//
// **IT COSTS A SECOND DERIVATION ON THE INDEFINITE, AND THAT IS A DELIBERATE STANCE** (2026-10-24).
// `HeLa is a cell line` now has two parses: `is_a(hela, CellLine)` and
// `∃x:CellLine. hela = x` — LOGICALLY EQUIVALENT, not a wrong reading. ENF would refuse the second,
// as `ObliqueParticipial` refuses a route that "re-derives a reading plain application already
// gives", and two uniqueness pins enforced it. They are relaxed to 2 here because ENF is a strong
// default and COVERAGE is the non-negotiable: the alternative was losing the construction entirely,
// at 56 sentences and 10 units, to avoid a redundant spelling of a proposition the grammar already
// gets right. The cost is ranking and chart size, never a distorted claim.
//
// Narrowing it properly needs a way to say "do not fire where the predicate-nominal route already
// covers it" — a DEFINITENESS feature in the category system (today `the_subj` and `a_subj` are
// byte-identical, definiteness living only in the sem), or recasting the copula as a RULE so it can
// carry a `ProvGuard`, which is per-rule and cannot key on an entry. Either is real design work.
resource lexicon:identity_copula_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => eigentt:Eq(lexicon:Entity, x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:is_identity : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — IDENTITY between two referring expressions.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:identity_copula_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "be";
}
resource lexicon:are_identity : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — IDENTITY between two referring expressions.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:identity_copula_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "be";
}
resource lexicon:was_identity : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — IDENTITY between two referring expressions.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:identity_copula_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "be";
}
resource lexicon:were_identity : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — IDENTITY between two referring expressions.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:identity_copula_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "be";
}

// ── Copula over a DIMENSIONLESS MEASURED VALUE (D95 slice 7, decision 6's gloss, 2026-10-22) ──
// "The observed-to-expected ratio is 0.94." The complement is `cat_numpred`, the category a bare
// numeral seeds alongside `cat_num` and its cardinal determiners, over
// `λx. ontology:has_quantity(x, u"1", q)`. ⟦cat_numpred⟧ = Entity → Prop, the same denotation the
// `adj` complement carries, so these are the is/are/was/were copula entries with one argument
// swapped and `copula_sem` (`λP.P`) unchanged.
//
// These four entries are the ONLY consumers of `cat_numpred`, and that is what makes the category
// the fix rather than a guard. Decision 6 removed the numeral's measure-phrase seeding because a
// bound marker took it and the modifier lift made it prenominal, giving `at least 1,000 cells` a
// second reading over cells with a quantity of at least 1000. Restoring the predicate at `S[adj]\NP`
// behind a provenance guard measured that defect straight back (2026-10-21): `at least` composed
// with the leaf first, the composed adjective carried the combinator's provenance rather than the
// leaf's, and the lift took it anyway. At `cat_numpred` nothing lifts it, no adjective-modifying
// adverb composes with it, and no measure consumer sees it — only the copula.
resource lexicon:is_copula_numpred : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular present of BE — copula over a dimensionless measured value.";
    lexicon:form     = "is";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:cat_numpred) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
resource lexicon:are_copula_numpred : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula over a dimensionless measured value.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:cat_numpred) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
resource lexicon:was_copula_numpred : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular past of BE — copula over a dimensionless measured value.";
    lexicon:form     = "was";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:cat_numpred) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}
resource lexicon:were_copula_numpred : lexicon:LexicalEntry {
    core:description = "grammatical: plural past of BE — copula over a dimensionless measured value.";
    lexicon:form     = "were";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:cat_numpred) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "be";
}

// ── Predicate-nominal `a` (D63 §8.5, Slice 3c) ────────────────────────
// The PREDICATIVE indefinite article: "HeLa is **a cell line**". Distinct from the
// existential determiner `a` — here `a` is semantically the membership former, not a
// quantifier. It consumes the common noun (binding its type T) and yields an
// **predicate nominal** `S[dcl,pred]\NP` `λs. is_a(s, T)`, which the copula then
// lifts to a finite VP. It used to yield `S[dcl,adj]\NP` and reuse the adjectival
// copula outright ("no new copula"); that is what this feature split changes. It
// costs NO extra entry — `feat_meets` admits `pred ⊑ adj`, so the ordinary `adj`
// copula selects a predicate nominal unchanged (see the note above the copula
// section). The reason for the split is that
// `adj` licenses ATTRIBUTIVE use and a predicate nominal must not have it: sharing
// the feature let `a promising drug target for MSI` modify `cancers`, splitting the
// compound "MSI cancers" and asserting `is_a(WRN, cancer)` (d44dfda). Subject
// dispatch is by type-checking: an instance subject (`hela : CellLine ≤ Entity`)
// makes `is_a(hela, CellLine)` felicitous. (The `subclass_of` reading for KIND
// subjects awaits bare-plural/generic subjects — deferred.)
resource lexicon:pred_nominal_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (s : lexicon:Entity) => ontology:is_a(s, T)
          : forall (T : Set) => lexicon:Entity -> Prop )
    );
}
resource lexicon:a_pred : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('a gene').";
    lexicon:form     = "a";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:pred_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => lexicon:Entity -> Prop );
    lexicon:sense    = "a";
}
// `an` — the ORTHOGRAPHIC ALLOMORPH of the predicative `a`, and it must exist wherever `a` does.
// It did not: `a` carried three entries (a_pred / a_subj / a_obj) and `an` only two, so "X is AN
// interaction between two genetic events" had NO predicate-nominal route. The NP was forced to be an
// existential quantifier, and the between-PP — with nowhere to land inside it — attached at the VP
// level and ended up on the SUBJECT, in every reading. Witnessed 2026-07-25 by a minimal pair that
// differs only in the article:
//   "… is A relationship between two genetic events."  → is_a(SL, ΣG#0. … prep_between(G#0, …))  ✓ nests
//   "… is AN interaction between two genetic events."  → prep_between(SL, …) in ALL readings      ✗
// Same defect class as the missing plural `some` (2026-07-24): an entry present for one surface form
// and absent for its variant, which reads as a GRAMMAR gap rather than the lexical hole it is.
resource lexicon:an_pred : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('an interaction').";
    lexicon:form     = "an";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:pred), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:pred_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => lexicon:Entity -> Prop );
    lexicon:sense    = "a";
}

// ── Kind-subject predicate nominal: `are` (D63 §8.5, Slice 3c kind subjects) ──
// "Genes are cell lines" → subclass_of(Gene, CellLine). The KIND copula `are`
// consumes the predicate noun (binding its type T), yielding a finite VP over a
// KIND subject `S[dcl,fin]\Kind`, sem `λK:Set. subclass_of(K, T)`. A bare-plural
// kind subject (`cat_kind`, ⟦·⟧ = Set) then applies. Distinct from the predicative
// adjective copula `are` (over `cat_np`) — the categories don't overlap.
resource lexicon:kind_nominal_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (k : Set) => ontology:subclass_of(k, T)
          : forall (T : Set) => Set -> Prop )
    );
}
resource lexicon:are_kind : lexicon:LexicalEntry {
    core:description = "grammatical: plural present of BE — copula or auxiliary.";
    lexicon:form     = "are";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_kind)) );
    lexicon:sem      = lexicon:kind_nominal_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => Set -> Prop );
    lexicon:sense    = "be";
}

// ── Negation (D63 §8.6 Slice 6-neg) ──────────────────────────────────
// Verbal: "HeLa does not affect BRCA1" → affect(brca1, hela) → logic:False.
// Copular: "HeLa is not primary" → is_primary(hela) → logic:False.
// `¬P := P -> logic:False` (reusing logic:False). Verbal negation uses
// DECLARATIVE do-support (the non-inverted counterpart of the 5a question aux):
// `do/does/did : (S[dcl,fin]\NP)/(S[dcl,bse]\NP)`, sem `λP.P` (reuses `copula_sem`,
// just `λP.P`). `not` is a predicate-modifier `λP.λs. ¬P(s)`, in two forms (over
// `bse` verbal VPs and over `adj` adjectival predicates — no feature-polymorphism).

resource lexicon:neg_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (P : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) => (P(s) -> logic:False)
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
// not — over a base verbal VP ("does not affect …").
resource lexicon:not_vp : lexicon:LexicalEntry {
    core:description = "grammatical: sentential negation ('does not lead to').";
    lexicon:form     = "not";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:neg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "not";
    lexicon:scope_bearing = true;
}
// not — over an adjectival predicate ("is not primary").
resource lexicon:not_adj : lexicon:LexicalEntry {
    core:description = "grammatical: sentential negation ('does not lead to').";
    lexicon:form     = "not";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:neg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "not";
    lexicon:scope_bearing = true;
}
// very — degree modifier over an adjectival predicate ("is very essential", "a very weak signal").
// Positive-degree counterpart of `not_adj` (`(S[dcl,adj]\NP)/(S[dcl,adj]\NP)`). One entry covers
// both predicative (consumed by `is_adj`) and attributive (lifted to `cat_mod` via `UnaryKind::ModLift`
// after forward application) positions without licensing verbal modification (*«very affects»).
axiom lexicon:very_deg : (lexicon:Entity -> Prop) -> lexicon:Entity -> Prop
resource lexicon:very_deg_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) => fun (s : lexicon:Entity) =>
            logic:And(V(s), lexicon:very_deg(V, s))
          : (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:very_adj : lexicon:LexicalEntry {
    core:description = "grammatical: degree modifier over an adjectival predicate ('is very essential', 'a very weak signal').";
    lexicon:form     = "very";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:very_deg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "very";
}
// Declarative do-support (verbal negation / emphatic) — finiteness-lifting `λP.P`. Sense
// `do`, shared with the question entries (see `lexicon:does_aux`).
resource lexicon:does_decl : lexicon:LexicalEntry {
    core:description = "grammatical: third-person singular DO-support auxiliary, carrying tense in negation and questions ('does not lead to cell death').";
    lexicon:form     = "does";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:sg)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "do";
    lexicon:scope_bearing = true;
}
resource lexicon:do_decl : lexicon:LexicalEntry {
    core:description = "grammatical: DO-support auxiliary, carrying tense in negation and questions ('do not lead').";
    lexicon:form     = "do";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:pl)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
    lexicon:sem      = lexicon:copula_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "do";
    lexicon:scope_bearing = true;
}
resource lexicon:did_decl : lexicon:LexicalEntry {
    core:description = "grammatical: past DO-support auxiliary ('did not respond').";
    lexicon:form     = "did";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any))) );
