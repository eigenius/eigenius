    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_arg(lexicon:prep_upon), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:argmarker_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "upon";
    lexicon:grade    = epistemic:declared;
}
