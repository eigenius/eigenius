            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:approx(u"1", q, b), ontology:has_count(T, fun (x : T) => TV(x, subj), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
}
resource lexicon:less_than_count_subj : lexicon:LexicalEntry {
    core:description = "grammatical: bound on a count ('less than 5 cells').";
    lexicon:form     = "less than";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:num_any)))), lexicon:cat_num) );
    lexicon:sem      = lexicon:lt_bound_count_subj_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") -> forall (T : Set) => (T -> Prop) -> Prop );
    lexicon:sense    = "less than";
}
resource lexicon:less_than_count_obj : lexicon:LexicalEntry {
    core:description = "grammatical: bound on a count ('less than 5 cells').";
    lexicon:form     = "less than";
