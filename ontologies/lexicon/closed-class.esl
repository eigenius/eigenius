// ── Exclusive-focus particle: post-nominal `alone` (D61 faithfulness) ──
// "each event alone" / "this event alone" — `alone` is a BARE post-nominal `cat_pp` (⟦·⟧ = Entity →
// Prop), unlike the preposition noun-modifiers above which are `cat_pp / NP` (they still need an
// object). Adjacent to the head noun, it fires the SAME post-nominal refine rule (parser.rs,
// `RefineKind::PpMod`): `[cat_n(C)] [cat_pp]` → `Σx:C. sole(x)`; the determiner then wraps the
// refined noun, so `each event alone` → `∀x:(Σy:event. sole(y)). …` under ANY determiner. The
// exclusive `ontology:sole` operator is the "= only" reading (`this event alone` ≡ `only this
// event`), kept opaque. Closed-class ⇒ cap-EXEMPT (the pooled-cap split), so the faithful reading is
// seeded at the tight cap and need not be widened in — where the correct senses rank #0/#1 — instead
// of losing to a widen-admitted noun pile. The WordNet PREDICATIVE adjective `alone` ("the child is
// alone") stays a separate open-class entry; this adds only the post-nominal focus reading.
// NB: pre-nominal `only`/`just` ("only this event") are the same `sole` operator but attach OUTSIDE
// the determiner (NP-level focus), a distinct rule from this N-level refine — deferred.
resource lexicon:sole_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (x : lexicon:Entity) => ontology:sole(x)
          : lexicon:Entity -> Prop )
    );
}
resource lexicon:alone_focus : lexicon:LexicalEntry {
    core:description = "grammatical: exclusive focus particle — by itself, to the exclusion of others; 'X alone' means 'only X' ('each event alone').";
    lexicon:form     = "alone";
    lexicon:cat      = type_expr( lexicon:cat_pp );
    lexicon:sem      = lexicon:sole_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> Prop );
    lexicon:sense    = "alone";
    lexicon:grade    = epistemic:declared;
}

// ── Comparative `than` marker (D63 §8.12 Slice 6-cmp) ─────────────────
// "X is larger than Y": `than` marks the comparison STANDARD `Y`. It consumes the
// standard NP and yields a `cat_pp_than` (⟦·⟧ = Entity), semantically the identity on the
// standard entity (`λy. y`); the comparative adjective `(S[adj]\NP)/cat_pp_than` then
// builds `λx. gt(deg_A(x), deg_A(y))`. A distinct `cat_pp_than` (not a bare NP) forces
// the `than`, so `*X is larger Y` has no parse.
resource lexicon:than_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (y : lexicon:Entity) => y : lexicon:Entity -> lexicon:Entity ) );
}
resource lexicon:than_marker : lexicon:LexicalEntry {
    core:description = "grammatical: comparative complementiser ('larger than').";
    lexicon:form     = "than";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_than, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:than_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "than";
    lexicon:grade    = epistemic:declared;
}

// ── PHRASAL / predicative comparative OPERATORS (D63 §8.12, d63-comparative-phrasal.md §5) ──
// Closed-class function words over the scale category `cat_measure` (⟦·⟧ = Entity→float) / any `cat_n`.
// The SCALE SOURCE (measure nouns, gradable adjectives) is content-word data — importer-emitted or demo
// scaffolding, NOT here. `than`/`cat_pp_than` (above) supplies the standard. (Moved from the demo lexicon
// in B1; #9 cardinality then closes at scale over existing `cat_n` with no importer emission.)
// (6b) `greater` — degree-MORE over a MEASURE noun (noun/object frame); sem `λμ.λV.λy.λx. gt(μ(x),μ(y))`.
resource lexicon:greater_cmp_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (mu : lexicon:Entity -> core:float) => fun (v : lexicon:Entity -> lexicon:Entity -> Prop) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(mu(x), mu(y))
          : (lexicon:Entity -> core:float) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:greater_cmp : lexicon:LexicalEntry {
    core:description = "grammatical: comparative degree marker of a larger degree.";
    lexicon:form     = "greater";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_pp_than), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_measure))) );
    lexicon:sem      = lexicon:greater_cmp_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> core:float) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "wn:great.a.01";
    lexicon:grade    = epistemic:declared;
}
// (6c) `less` — degree-LESS over a MEASURE noun (mirror of `greater`); sem `gt(μ(y),μ(x))`.
resource lexicon:less_cmp_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (mu : lexicon:Entity -> core:float) => fun (v : lexicon:Entity -> lexicon:Entity -> Prop) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(mu(y), mu(x))
          : (lexicon:Entity -> core:float) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:less_cmp : lexicon:LexicalEntry {
    core:description = "grammatical: comparative degree marker of a lesser degree.";
    lexicon:form     = "less";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_pp_than), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_measure))) );
    lexicon:sem      = lexicon:less_cmp_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> core:float) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "less.deg";
    lexicon:grade    = epistemic:declared;
}
// (6d) `fewer` / `more` — CARDINALITY over ANY count noun `cat_n` (the noun is consumed by the
// `cat_forall`+`cat_n` rule; `card : Set → Entity → float` is the opaque per-noun cardinality). Sem
// `λT.λV.λy.λx. gt(card(T,y), card(T,x))` (fewer). The noun-type `cat_forall` sits UNDER the fin/num
// binders so `strip_feature_binders` exposes it at the top (lexicon.rs:152).
axiom lexicon:card : Set -> lexicon:Entity -> core:float
resource lexicon:fewer_card_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (v : lexicon:Entity -> lexicon:Entity -> Prop) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(lexicon:card(T, y), lexicon:card(T, x))
          : forall (T : Set) => (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:fewer_card : lexicon:LexicalEntry {
    core:description = "grammatical: comparative quantifier over count nouns.";
    lexicon:form     = "fewer";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_pp_than), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:fewer_card_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "wn:few.a.01";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:more_card_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (T : Set) => fun (v : lexicon:Entity -> lexicon:Entity -> Prop) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(lexicon:card(T, x), lexicon:card(T, y))
          : forall (T : Set) => (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:more_card : lexicon:LexicalEntry {
    core:description = "grammatical: comparative degree marker or quantifier ('more sensitive', 'more cells').";
    lexicon:form     = "more";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:num_any, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_pp_than), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:more_card_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (lexicon:Entity -> lexicon:Entity -> Prop) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "wn:more.a.01";
    lexicon:grade    = epistemic:declared;
}
// (6e) `more` / `less` — ANALYTIC degree on a gradable ADJECTIVE (predicative
// `((S[adj]\NP)/cat_pp_than)/cat_measure`); the adjective supplies `cat_measure` (its `deg_A`).
resource lexicon:more_deg_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (mu : lexicon:Entity -> core:float) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(mu(x), mu(y))
          : (lexicon:Entity -> core:float) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:more_deg : lexicon:LexicalEntry {
    core:description = "grammatical: comparative degree marker or quantifier ('more sensitive', 'more cells').";
    lexicon:form     = "more";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_pp_than), lexicon:cat_measure) );
    lexicon:sem      = lexicon:more_deg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> core:float) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "wn:more.a.01";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:less_deg_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (mu : lexicon:Entity -> core:float) => fun (y : lexicon:Entity) => fun (x : lexicon:Entity) =>
            measurements:gt(mu(y), mu(x))
          : (lexicon:Entity -> core:float) -> lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:less_deg : lexicon:LexicalEntry {
    core:description = "grammatical: comparative degree marker of a lesser degree.";
    lexicon:form     = "less";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:cat_pp_than), lexicon:cat_measure) );
    lexicon:sem      = lexicon:less_deg_sem;
    lexicon:sem_type = type_expr( (lexicon:Entity -> core:float) -> lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "less.deg";
    lexicon:grade    = epistemic:declared;
}
// (6e′) ELIDED-`than` is a GRAMMAR SHIFT, not a lexical entry (D63 §8.12;
// d63-single-skeleton-defects.md). "more/less X" with no `than` is complete on its own: the comparative
// `((S[adj]\NP)/cat_pp_than)/cat_measure` above takes its measure to `(S[adj]\NP)/cat_pp_than`, and the
// `elided_than` unary shift (kernel: dcg::rules::constructions + the UnaryKind::ElidedThan table entry)
// saturates the pending `cat_pp_than` standard with the anaphoric placeholder `lexicon:anaphor` (→ an
// OPEN parse the D64 resolver fills — the elided comparison target). One general rule over any
// `X/cat_pp_than` REPLACES the former per-word `more_deg_bare`/`less_deg_bare` entries; the explicit
// `than_marker` still supplies an overt standard for "more X than Y". (`than [PP]` — the RELATUM
// standard "more dependent on WRN than on MSI" — is a separate two-measure relational-comparative slice,
// not a `than` widening; see kernel/tests/comparative_than.rs.)

// ── Argument-PP markers: prepositions as VERB/ADJECTIVE-subcategorized oblique complements ──
// "contributes TO cancers", "results FROM X", "dependent ON WRN", "associated WITH Z": the head
// *requires* the PP. The marker consumes the object NP and yields a `cat_pp_arg(prep)` (⟦·⟧ = Entity),
// transparently exposing the object (`λy. y`); a subcategorizing verb `(S\NP) / cat_pp_arg(any)` or a
// gloss-governed adjective `cat_measure / cat_pp_arg(prep_on)` binds it. A distinct `cat_pp_arg` (not a
// bare NP) FORCES the preposition — a plain transitive verb `(S\NP)/NP` (e.g. `affect`) cannot absorb
// `to X`. The **Prep feature** (D63 §5.3 C3-precision) tags each marker with its preposition, so a
// governed adjective selects the RIGHT one: `dependent` (prep_on) composes with `on` but not `to`
// (`*dependent to`). These are IN ADDITION to each preposition's VP-adjunct + noun-modifier entries
// above (the argument reading is a third parse, selected only by a subcategorizing head). The set
// mirrors `governed_preposition`'s extracted vocabulary (crates/eigenius-wordnet/src/convert.rs).
resource lexicon:argmarker_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (y : lexicon:Entity) => y : lexicon:Entity -> lexicon:Entity ) );
}
resource lexicon:to_arg : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking a goal or recipient, or the infinitival marker ('lead to death', 'to test').";
    lexicon:form     = "to";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_arg(lexicon:prep_to), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:argmarker_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "to";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:from_arg : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking origin or source ('arise from mutations').";
    lexicon:form     = "from";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp_arg(lexicon:prep_from), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:argmarker_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity );
    lexicon:sense    = "from";
    lexicon:grade    = epistemic:declared;
}
resource lexicon:on_arg : lexicon:LexicalEntry {
