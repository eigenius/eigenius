// 3. Count determiners (the_count_plain, all_count_plain, all_count_subj, all_count_obj, of_numpred)
resource lexicon:the_count_plain_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (q : units:Quantity(u"1")) => fun (A : Set) => ontology:the_count(A, q)
          : units:Quantity(u"1") -> (forall (A : Set) => A) )
    );
}
resource lexicon:the_count_plain : lexicon:LexicalEntry {
    core:description = "grammatical: definite determiner before a cardinal numeral, plain NP.";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:cat_np(T, lexicon:pl)), lexicon:cat_num) );
    lexicon:sem      = lexicon:the_count_plain_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") -> (forall (A : Set) => A) );
    lexicon:sense    = "the";
}
resource lexicon:all_count_plain : lexicon:LexicalEntry {
