            forall (P : Prop) => (forall (q : units:Quantity(u"1")) => (logic:And(units:le(u"1", q, b), ontology:has_count(T, fun (x : T) => TV(x, subj), q)) -> P)) -> P
        : units:Quantity(u"1") -> forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) ) );
