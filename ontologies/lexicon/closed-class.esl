// ── Reserved construct tokens (D63 §11 3g.3 / B10) ────────────────────
// The reserved-word FORM set as DATA (see `lexicon:ReservedConstruct` in the schema).
// The CKY keys its reserved-word rules on `construct_kind`; the parser loads these into
// a `ReservedTable` index-driven at build. Adding a coordinator/relativizer here needs
// no code change. NB `that`/`which`/`but` ALSO have LexicalEntry senses (complementizer,
// wh-determiner, `but_subord`) — a form can be both a reserved construct and a lexeme.
resource lexicon:rc_and : lexicon:ReservedConstruct {
    lexicon:construct_form = "and";
    lexicon:construct_kind = lexicon:rk_coord_and;
}
resource lexicon:rc_or : lexicon:ReservedConstruct {
    lexicon:construct_form = "or";
    lexicon:construct_kind = lexicon:rk_coord_or;
}
resource lexicon:rc_comma : lexicon:ReservedConstruct {
    lexicon:construct_form = ",";
    lexicon:construct_kind = lexicon:rk_comma;
}
resource lexicon:rc_that : lexicon:ReservedConstruct {
    lexicon:construct_form = "that";
    lexicon:construct_kind = lexicon:rk_relativizer;
}
resource lexicon:rc_which : lexicon:ReservedConstruct {
    lexicon:construct_form = "which";
    lexicon:construct_kind = lexicon:rk_wh_relativizer;
}
// `who` — the PERSONAL relativizer, `rk_relativizer` and NOT `rk_wh_relativizer` (2026-10-31).
// The two kinds differ in exactly one respect: the wh- kind ALSO keys pied-piping (`prep which`,
// `dcg/parse/unpacked.rs`). `who` does not pied-pipe — *«the reviewer of who» — it is `whom` that
// does, and `whom` is a separate form. Declaring `who` as the wh- kind would license a
// construction English does not have at this form. Measured as a layer before promotion: claim
// units 66 → 67, grammar-gap 457 → 456, one unit converted, battery unchanged at 83 of 89.
resource lexicon:rc_who : lexicon:ReservedConstruct {
    lexicon:construct_form = "who";
    lexicon:construct_kind = lexicon:rk_relativizer;
}
resource lexicon:rc_but : lexicon:ReservedConstruct {
    lexicon:construct_form = "but";
    lexicon:construct_kind = lexicon:rk_contrastive_but;
}
resource lexicon:rc_not : lexicon:ReservedConstruct {
    lexicon:construct_form = "not";
    lexicon:construct_kind = lexicon:rk_negator;
}
// `rather than` — the excluding coordinator, one construct over TWO tokens. `X rather than Y` is
// `X ∧ ¬Y`, which is `but not`'s truth condition, so it shares that builder; what differs is the
// correction it conveys, and that is not truth-conditional. The pair is declared rather than its
// halves because neither half means this alone — `rather` is a degree adverb (`rather clear`) and
// `than` is the comparative marker (`larger than`), and both readings must survive.
resource lexicon:rc_rather_than : lexicon:ReservedConstruct {
    lexicon:construct_form = "rather than";
    lexicon:construct_kind = lexicon:rk_coord_rather_than;
}
resource lexicon:rc_each : lexicon:ReservedConstruct {
    lexicon:construct_form = "each";
    lexicon:construct_kind = lexicon:rk_reciprocal_each;
}
resource lexicon:rc_other : lexicon:ReservedConstruct {
    lexicon:construct_form = "other";
    lexicon:construct_kind = lexicon:rk_reciprocal_other;
}

// ── Unit spellings (D95) ──────────────────────────────────────────────
// The spellings the WRN methods write after a numeral that are not the units layer's own symbols
// (D95 implementation plan, slice 3). `g` is the gram's symbol and here also standard gravity's:
// `931g` is g-force, and the recogniser reads both. `RCF` is how the PMC manuscript writes it.
resource lexicon:us_litre_l : lexicon:UnitSurface {
    lexicon:unit_form = "l";
    lexicon:unit      = units:litre;
}
resource lexicon:us_gravity_g : lexicon:UnitSurface {
    lexicon:unit_form = "g";
    lexicon:unit      = units:standard_gravity;
}
resource lexicon:us_gravity_rcf : lexicon:UnitSurface {
    lexicon:unit_form = "RCF";
    lexicon:unit      = units:standard_gravity;
}
resource lexicon:us_hour : lexicon:UnitSurface {
    lexicon:unit_form = "hour";
    lexicon:unit      = units:hour;
}
resource lexicon:us_hours : lexicon:UnitSurface {
    lexicon:unit_form = "hours";
    lexicon:unit      = units:hour;
}
resource lexicon:us_day : lexicon:UnitSurface {
    lexicon:unit_form = "day";
    lexicon:unit      = units:day;
}
resource lexicon:us_days : lexicon:UnitSurface {
    lexicon:unit_form = "days";
    lexicon:unit      = units:day;
}
resource lexicon:us_minute : lexicon:UnitSurface {
    lexicon:unit_form = "minute";
    lexicon:unit      = units:minute;
}
resource lexicon:us_minutes : lexicon:UnitSurface {
    lexicon:unit_form = "minutes";
    lexicon:unit      = units:minute;
}
resource lexicon:us_week : lexicon:UnitSurface {
    lexicon:unit_form = "week";
    lexicon:unit      = units:week;
}
resource lexicon:us_weeks : lexicon:UnitSurface {
    lexicon:unit_form = "weeks";
    lexicon:unit      = units:week;
}
// Typographic variants of °C: the masculine ordinal indicator (U+00BA), the ring above (U+02DA) and
// the single-character degree Celsius sign (U+2103).
resource lexicon:us_celsius_ordinal : lexicon:UnitSurface {
    lexicon:unit_form = "ºC";
    lexicon:unit      = units:degree_celsius;
}
resource lexicon:us_celsius_ring : lexicon:UnitSurface {
    lexicon:unit_form = "˚C";
    lexicon:unit      = units:degree_celsius;
}
resource lexicon:us_celsius_sign : lexicon:UnitSurface {
    lexicon:unit_form = "℃";
    lexicon:unit      = units:degree_celsius;
}

// ── Preposition coverage holes (2026-07-26) ──────────────────────────
// Found by `probe_preposition_role_coverage`, a 0-reading sweep over every preposition x role. The
// page-based `grammar-gap 0` is blind to a construction the 62-sentence corpus does not contain, so
// these sat undetected: `without`/`among`/`beyond` had NO entry in ANY role, and
// at/into/upon/against/about/by had no noun-post-modifier form. Confirmed on natural sentences
// ("Cells survive without oxygen." 0 -> 4; "The paper by the authors was clear." 0 -> 2) and
// page-NEUTRAL (578 skeletons / 2473 readings / 44 pins, all unchanged) -- a fix the page could
// neither motivate nor validate.
resource lexicon:nmod_at_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (y : lexicon:Entity) => fun (x : lexicon:Entity) => ontology:prep_at(x, y)
          : lexicon:Entity -> lexicon:Entity -> Prop )
    );
}
resource lexicon:at_nmod : lexicon:LexicalEntry {
    core:description = "grammatical: preposition as a noun post-modifier ('the change at X').";
    lexicon:form     = "at";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_pp, lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:nmod_at_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> lexicon:Entity -> Prop );
    lexicon:sense    = "at";
}
resource lexicon:nmod_into_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
