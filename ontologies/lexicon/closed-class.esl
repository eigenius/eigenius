// ── `when` — temporal/generic, BOTH orders (measured 2026-10-28) ────────────────
// No new axiom: `if_sem` is `λs2. λs1. (s2 -> s1)`, which is what generic `when` means here.
//
// CONDITIONAL, NOT FACTIVE, and the corpus makes the choice asymmetric. Four of the five `when`
// units on the CNL page are generic and one is episodic. A factive treatment (`Because`'s shape)
// would ASSERT the subordinate clause, which is FALSE on the four — «Efficiency is high when the
// locus cooperates.» does not claim the locus cooperates. The conditional under-commits on the one
// episodic unit but asserts nothing untrue; losing a fact is recoverable, asserting a falsehood is
// not.
//
// DROPPED, and stated: temporality. Generic `when` quantifies over OCCASIONS and the event-free
// design has no occasion variable to bind, so `when` denotes identically to `if` and
// `lexicon:sense` keeps the surfaces apart — as `whereas` reuses `but_sem` and `though` reuses
// `although_sem`. If the design acquires occasions, `when` and `if` separate there, together.
resource lexicon:when_subord : lexicon:LexicalEntry {
    core:description = "grammatical: temporal/generic subordinator ('the study fails when the assay works').";
    lexicon:form     = "when";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:if_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "when";
}
resource lexicon:when_subord_fronted : lexicon:LexicalEntry {
    core:description = "grammatical: FRONTED temporal/generic subordinator ('when the assay works, the study fails').";
    lexicon:form     = "when";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_s(lexicon:dcl, lexicon:fin)), lexicon:cat_s(lexicon:dcl, lexicon:fin)) );
    lexicon:sem      = lexicon:if_sem;
    lexicon:sem_type = type_expr( Prop -> Prop -> Prop );
    lexicon:sense    = "when";
}

// ── Indefinite pronouns (paradigm completion) ────────────────────────────────
// An indefinite pronoun IS a quantified NP: `something` = "some thing", `everyone` = "every
// person". So its category is the determiner's RESULT with the restrictor already fixed —
// `S/(S\NP)` in subject position, the object-determiner shape in object position — and its
// semantics is the determiner's sem with `A` instantiated at `lexicon:Entity`. These restate the
// three quantifier sems at that instance rather than quantify over `Set`, because the restrictor
// is no longer an argument.
//
// Measured need: `nothing` occurs 15 times in the XIAP report, the most frequent indefinite there
// by a wide margin, and it "parsed" before this only because WordNet carries a NOUN `nothing` — a
// wrong reading rather than a working one. `someone`, `somebody` and `nobody` were the same shape.
//
// `person` is NOT distinguished from `thing`: both restrict to `lexicon:Entity`. The one-/-body
// forms should restrict to a person class; there is none in the chain to point at, so the
// restriction is dropped rather than faked, and `everyone` is `every entity` here.
resource lexicon:exists_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) =>
            forall (C : Prop) => (forall (x : lexicon:Entity) => (V(x) -> C)) -> C
          : (lexicon:Entity -> Prop) -> Prop )
    );
}
resource lexicon:forall_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) => forall (x : lexicon:Entity) => V(x)
          : (lexicon:Entity -> Prop) -> Prop )
    );
}
resource lexicon:no_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (V : lexicon:Entity -> Prop) => forall (x : lexicon:Entity) => (V(x) -> logic:False)
          : (lexicon:Entity -> Prop) -> Prop )
    );
}
resource lexicon:obj_exists_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : lexicon:Entity) => (TV(x, subj) -> C)) -> C
          : (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:obj_forall_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : lexicon:Entity) => TV(x, subj)
          : (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}
resource lexicon:obj_no_entity_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (x : lexicon:Entity) => (TV(x, subj) -> logic:False)
          : (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

