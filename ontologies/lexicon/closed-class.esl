// ── Possessive clitic `'s` (OpenCCG `core-en` `det.xsl` `PossS`) ────────────
// Clitic counterpart of `PossPro` (`its`/`my`/`your`/`their`): where `PossPro` fixes the
// possessor to `lexicon:anaphor`, `'s` takes the preceding noun phrase `cat_np(Entity, num_any)`
// as a backward argument `p` and yields a `cat_forall` possessive determiner over
// `lexicon:poss_of(A, x, p)`.
resource lexicon:poss_s_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (p : lexicon:Entity) => fun (A : Set) => fun (V : A -> Prop) =>
            forall (C : Prop) => (forall (x : A) => (lexicon:poss_of(A, x, p) -> V(x) -> C)) -> C
          : lexicon:Entity -> (forall (A : Set) => (A -> Prop) -> Prop) )
    );
}
resource lexicon:poss_s_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (p : lexicon:Entity) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : T) => (lexicon:poss_of(T, x, p) -> TV(x, subj) -> C)) -> C
          : lexicon:Entity -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) )
    );
}
resource lexicon:poss_s_subj_sg : lexicon:LexicalEntry {
