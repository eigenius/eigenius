// ── Cardinal numerals as plural determiners (D62 §2 #4) ──────────────────────
// `two genes affect HeLa`, `HeLa affects two genes`. Categorially numerals ARE plural
// determiners (core-en `det.xsl`: `np[X]/n[X]` + a `<Card>` value). FIRST-CUT SEMANTICS:
// existential, count DROPPED (`exists_sem` / `obj_exists_sem`, same as `these`/`some` plural)
// — so `two genes …` PARSES as `∃ genes …`; the exact cardinality is a faithfulness refinement
// (a `Card`/measure predicate, tying to D52 measurements). The word forms `two`..`ten` are seeded
// here; DIGIT numerals (`14`, `37`) need a generative numeral tokenizer hook — a follow-on. Each
// numeral mirrors the `these` (subject) / `these_obj` (in-situ object) plural-existential shape.
resource lexicon:two_subj : lexicon:LexicalEntry {
    core:description = "grammatical: cardinal numeral determiner (2).";
    lexicon:form     = "two";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "two";
    lexicon:grade    = epistemic:declared;
}
