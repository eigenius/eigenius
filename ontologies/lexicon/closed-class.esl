    core:description = "grammatical: plural distal demonstrative determiner ('those lines').";
    lexicon:form     = "those";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:dem_ref_subj_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "those";
}
resource lexicon:those_obj : lexicon:LexicalEntry {
    core:description = "grammatical: plural distal demonstrative determiner ('those lines').";
    lexicon:form     = "those";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:dem_ref_obj_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "those";
}

// ── Cardinal numerals (D62 §2 #4; D95 slice 7) ─────────────────────────────────
// A numeral — digits, or one of the words `one` … `ten` — is a preprocessor token, and seeding builds
// its items from its value (D95 slice 7d, decision 11): the bare number `cat_num`, and a cardinal
// determiner stating the exact count, `has_count(T, fun (x : T) => V(x), n)`, in the categories of
// `a` (for 1) and of `these` (for any other whole number). No entry here states a number.

// ── A determiner before a numeral (D95 slice 7d, decision 13) ──────────────────
// `the four other RecQ DNA helicases`, `these two genetic events`: `the`, `these` and `those` take a
// bare number and yield the plural determiner categories `these` has. The definite states its count
// on the ι-term, `ontology:the_count(A, q)`; a demonstrative carries `anaphor_of_count(A, q)`, which the
// felicity gate freshens into a referent hole typed at `A` with the count recorded on it, so
// resolution vetoes an antecedent of another size (a set of `q` members, or one antecedent when
// `q` is 1).
axiom lexicon:anaphor_of_count : forall (A : Set) => units:Quantity(u"1") -> A
resource lexicon:the_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (A : Set) => fun (V : A -> Prop) => V(ontology:the_count(A, q))
        : units:Quantity(u"1") -> (forall (A : Set) => (A -> Prop) -> Prop) ) );
}
resource lexicon:the_count_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            TV(ontology:the_count(T, q), subj)
        : units:Quantity(u"1") -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) ) );
}
resource lexicon:dem_count_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (A : Set) => fun (V : A -> Prop) => V(lexicon:anaphor_of_count(A, q))
        : units:Quantity(u"1") -> (forall (A : Set) => (A -> Prop) -> Prop) ) );
}
resource lexicon:dem_count_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr( ( fun (q : units:Quantity(u"1")) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            TV(lexicon:anaphor_of_count(T, q), subj)
        : units:Quantity(u"1") -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) ) );
}
resource lexicon:the_count_subj : lexicon:LexicalEntry {
    core:description = "grammatical: definite determiner before a numeral ('the four helicases').";
    lexicon:form     = "the";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))), lexicon:cat_num) );
    lexicon:sem      = lexicon:the_count_subj_sem;
    lexicon:sem_type = type_expr( units:Quantity(u"1") -> (forall (A : Set) => (A -> Prop) -> Prop) );
    lexicon:sense    = "the";
}
