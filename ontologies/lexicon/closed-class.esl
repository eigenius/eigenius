// ── Determiner entries (D63 §8.3 Phase 2) ─────────────────────────────
// Subject category:  cat_forall(num, λT. S/(S\NP_T))
// Object category:   cat_forall(num, λT. (S\NP_E)\((S\NP_E)/NP_T)),  E = lexicon:Entity
// `every`/`each` sg, `all` pl universal; `a` sg, `some` sg existential; `no` sg
// negative. (Plural `some`/`no` and the definite `the` are follow-ons — D63 §8.3.)

// every — universal, singular.
resource lexicon:every_subj : lexicon:LexicalEntry {
    core:description = "grammatical: universal determiner — predicates of all members of a group ('every cell').";
    lexicon:form     = "every";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "every"; 
}
resource lexicon:every_obj : lexicon:LexicalEntry {
    core:description = "grammatical: universal determiner — predicates of all members of a group ('every cell').";
    lexicon:form     = "every";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_forall_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "every"; 
}
// each — universal, singular (≈ every truth-conditionally).
resource lexicon:each_subj : lexicon:LexicalEntry {
    core:description = "grammatical: distributive universal determiner — predicates of every member of a group, taken one at a time ('each gene was tested').";
    lexicon:form     = "each";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "each";
}
// `each` in OBJECT position — the type-raised counterpart of `each_subj`, mirroring `every_obj`
// (truth-conditionally `each` ≈ `every`, so it takes the same `obj_forall_sem`). Its absence was a
// COVERAGE gap, not merely a missing reading: every other determiner in this lexicon carries a
// subj/obj pair, and `each` carried only the subject entry, so a `each`-object sentence had NO parse
// at all. Witnessed 2026-07-25 — "WRN affects each gene." → 0 readings, while the structurally
// identical "WRN affects every gene." → 4. Found by sweeping the determiner inventory for
// subj/obj asymmetries after the `an_pred` hole (same defect class: an entry present for one form
// and absent for its sibling, which reads as a grammar gap rather than the lexical hole it is).
resource lexicon:each_obj : lexicon:LexicalEntry {
    core:description = "grammatical: distributive universal determiner in object position ('WRN affects each gene').";
    lexicon:form     = "each";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_forall_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "each";
}
// all — universal, plural.
resource lexicon:all_subj : lexicon:LexicalEntry {
    core:description = "grammatical: universal determiner/quantifier over a whole group ('all cells').";
    lexicon:form     = "all";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))) );
    lexicon:sem      = lexicon:forall_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "all"; 
}
resource lexicon:all_obj : lexicon:LexicalEntry {
    core:description = "grammatical: universal determiner/quantifier over a whole group ('all cells').";
    lexicon:form     = "all";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_forall_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "all"; 
}
// a — existential, singular.
resource lexicon:a_subj : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('a gene').";
    lexicon:form     = "a";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "a"; 
}
resource lexicon:a_obj : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner introducing a singular noun ('a gene').";
    lexicon:form     = "a";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_exists_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "a";
}
// an — the pre-vocalic spelling of the indefinite article `a` (same sense/semantics).
resource lexicon:an_subj : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner before a vowel sound ('an event').";
    lexicon:form     = "an";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "a";
}
resource lexicon:an_obj : lexicon:LexicalEntry {
    core:description = "grammatical: indefinite article/determiner before a vowel sound ('an event').";
    lexicon:form     = "an";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:obj_exists_sem;
    lexicon:sem_type = type_expr( forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "a";
}
// some — existential, singular.
resource lexicon:some_subj : lexicon:LexicalEntry {
    core:description = "grammatical: existential determiner — at least one member ('some cells died').";
    lexicon:form     = "some";
    lexicon:cat      = type_expr( lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))) );
    lexicon:sem      = lexicon:exists_sem;
    lexicon:sem_type = type_expr( forall (A : Set) => (A -> Prop) -> Prop );
    lexicon:sense    = "some"; 
}
