// D66 — `eigentt:Definition` and its properties, as an ADDITIVE layer.
//
// These four resources belong in `ontologies/eigentt/eigentt-type-fragment.json`, which is a
// BOOTSTRAP ontology: the kernel carries it via `include_str!` and seeds it as a root-adjacent
// layer (`kernel/src/bootstrap/mod.rs`). A store seeded before D66 therefore does not have them,
// and bootstrap does not re-seed an existing store — so `is_a: eigentt:Definition` fails Rule 22
// (reference integrity) on any pre-D66 snapshot.
//
// A full reseed is the correct fix and puts these where they belong. This file exists for the
// cheap path: `scripts/add-layer-to-snapshot.sh` stages a base snapshot, loads this through the
// kernel (so it still passes the validator and the commit gate), and writes a new snapshot without
// touching the base.
//
//   scripts/add-layer-to-snapshot.sh \
//     --base ../db-snapshot/wordnet-umls-aligned-2026-08-03-specpoly \
//     --out  ../db-snapshot/wordnet-umls-aligned-d66-definitions \
//     ontologies/eigentt/definition-layer.esl
//
// **This is a transitional artifact.** The resulting snapshot has a chain shape no reseed would
// produce — the definition vocabulary sits above the lexicon layers instead of beside the rest of
// the eigentt fragment. Fine for exercising the demo; not something to keep. Delete this file once
// a reseed has folded the four resources into the seed, and note that only the JSON is the source
// of truth: the two must not drift.

namespace core    = "urn:eigenius:core";
namespace eigentt = "urn:eigenius:eigentt";

resource eigentt:Definition : core:Class {
    core:short_name = "Definition";
    core:description = "A named, chain-resident TRANSPARENT definition (D66). Unlike an `eigentt:Axiom`, whose IRI evaluates to a rigid neutral and never unfolds, a Definition names a body that decode substitutes at the use site. `definition_body` holds the body as a lambda chain `Lam(x1, T1, Lam(x2, T2, … B))`; arity and parameter types are read off `definition_type`, so nothing is stored twice. The body is stored ALREADY NORMALIZED — a definition's identity for equality and hashing is the normal form of its right-hand side (D66 D9), which is what lets a use decode to a normal term without evaluating. Recursive bodies are rejected at commit: decode would not terminate.";
    core:requires = [eigentt:definition_type, eigentt:definition_body];
    core:recommends = [eigentt:definition_opaque, core:description];
}

resource eigentt:definition_type : core:Property {
    core:short_name = "definition_type";
    core:description = "The declared type of the definition, e.g. `Set -> Set -> Set -> Prop`. Arity and parameter types are read from here rather than duplicated, so a stored arity can never contradict the type. D47-encoded (eigentt:TypeExpr).";
    core:data_type = core:inductive;
    core:class_types = [eigentt:TypeExpr];
    core:domain = [eigentt:Definition];
}

resource eigentt:definition_body : core:Property {
    core:short_name = "definition_body";
    core:description = "The right-hand side as a lambda chain, stored in NORMAL FORM (D66 D9). Decode peels one leading `Lam` per supplied argument and substitutes, never forming a beta-redex, so a use decodes straight to a normal term. D47-encoded (eigentt:TypeExpr).";
    core:data_type = core:inductive;
    core:class_types = [eigentt:TypeExpr];
    core:domain = [eigentt:Definition];
}

resource eigentt:definition_opaque : core:Property {
    core:short_name = "definition_opaque";
    core:description = "When true, decode does NOT unfold this definition: the IRI stays a rigid constant, like an axiom, and the definition's identity is the folded name rather than the normal form of its body (the D66 D9 carve-out). This is the strict-vs-unrestricted decode mode of issue #95. Absent means transparent.";
    core:data_type = core:boolean;
    core:domain = [eigentt:Definition];
}
