  },
  {
    "@id": "urn:eigenius:institution:property_kinds:symmetric",
    "urn:eigenius:core:is_a": ["urn:eigenius:institution:PropertyKind"],
    "urn:eigenius:core:description": "The morphism is symmetric: if a→b then b→a.",
    "urn:eigenius:core:short_name": "symmetric"
  },
  {
    "@id": "urn:eigenius:institution:property_kinds:antisymmetric",
    "urn:eigenius:core:is_a": ["urn:eigenius:institution:PropertyKind"],
    "urn:eigenius:core:description": "The morphism is antisymmetric: if a→b and b→a then a=b.",
