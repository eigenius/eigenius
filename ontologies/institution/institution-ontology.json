    "urn:eigenius:core:class_types": ["urn:eigenius:institution:PropertyKind"],
    "urn:eigenius:core:allows_only": [
      "urn:eigenius:institution:property_kinds:reflexive",
      "urn:eigenius:institution:property_kinds:transitive",
      "urn:eigenius:institution:property_kinds:symmetric",
      "urn:eigenius:institution:property_kinds:antisymmetric"
    ],
    "urn:eigenius:core:domain": ["urn:eigenius:institution:StructuralProperty"]
  },

  {
    "@id": "urn:eigenius:institution:PropertyKind",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A kind of structural property that a morphism type can have.",
    "urn:eigenius:core:short_name": "PropertyKind"
  },
  {
    "@id": "urn:eigenius:institution:property_kinds:reflexive",
