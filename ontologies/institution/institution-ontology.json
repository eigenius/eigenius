  {
    "@id": "urn:eigenius:institution:property_kinds:transitive",
    "urn:eigenius:core:is_a": ["urn:eigenius:institution:PropertyKind"],
    "urn:eigenius:core:description": "The morphism is transitive: if a→b and b→c then a→c.",
