[
  {
    "@id": "urn:eigenius:institution:Institution",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "A registered domain institution that provides fiber reasoning over the shared Eigon signature category.",
    "urn:eigenius:core:short_name": "Institution",
    "urn:eigenius:core:requires": [
      "urn:eigenius:institution:institution_iri",
      "urn:eigenius:institution:institution_name"
    ]
  },

  {
    "@id": "urn:eigenius:institution:FiberMorphism",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "Base class for fiber morphisms. Each institution defines subclasses with domain-specific properties. A morphism relates two resources within an institution's fiber and carries domain-specific structure (e.g., convergence delta, RMSD, Pareto dominance).",
    "urn:eigenius:core:short_name": "FiberMorphism",
    "urn:eigenius:core:requires": [
      "urn:eigenius:institution:source",
      "urn:eigenius:institution:target",
      "urn:eigenius:institution:institution_ref"
    ]
  },

  {
    "@id": "urn:eigenius:institution:FiberQuery",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "Base class for fiber queries. Each institution defines subclasses representing domain-specific queries it can answer (e.g., convergence analysis, ensemble robustness, Pareto front computation).",
    "urn:eigenius:core:short_name": "FiberQuery",
    "urn:eigenius:core:requires": [
      "urn:eigenius:institution:institution_ref"
    ]
  },

  {
    "@id": "urn:eigenius:institution:StructuralProperty",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:description": "An advisory structural property of a morphism type (e.g., reflexive, transitive, symmetric). The kernel stores but does not enforce these; the institution enforces its own invariants via validate_morphism.",
    "urn:eigenius:core:short_name": "StructuralProperty",
    "urn:eigenius:core:requires": [
      "urn:eigenius:institution:morphism_class",
      "urn:eigenius:institution:property_kind"
    ]
  },

  {
    "@id": "urn:eigenius:institution:institution_iri",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:description": "The IRI identifying this institution.",
    "urn:eigenius:core:short_name": "institution_iri",
    "urn:eigenius:core:data_type": "urn:eigenius:core:string",
    "urn:eigenius:core:format": "urn:eigenius:core:formats:iri",
    "urn:eigenius:core:domain": ["urn:eigenius:institution:Institution"]
  },
  {
    "@id": "urn:eigenius:institution:institution_name",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:description": "Human-readable name of the institution.",
