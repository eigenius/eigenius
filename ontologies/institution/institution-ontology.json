    "urn:eigenius:core:domain": ["urn:eigenius:institution:FiberMorphism"]
  },
  {
    "@id": "urn:eigenius:institution:target",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:description": "The target resource of a fiber morphism.",
    "urn:eigenius:core:short_name": "target",
    "urn:eigenius:core:data_type": "urn:eigenius:core:resource",
    "urn:eigenius:core:domain": ["urn:eigenius:institution:FiberMorphism"]
