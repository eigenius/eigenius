    "urn:eigenius:core:data_type": "urn:eigenius:core:resource",
    "urn:eigenius:core:class_types": ["urn:eigenius:institution:Institution"]
  },

  {
    "@id": "urn:eigenius:institution:morphism_class",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:description": "The morphism class this structural property applies to.",
