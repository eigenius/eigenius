// objective — the D58 objective-framing layer: a typed obligation graph that
// makes "is this unit of work well-posed?" a mechanical question before any
// deriving begins.
//
// DESIGN (D58 §5, grounded in the D57 dogfood harvest, not speculation):
// the three planning nodes are STRUCTURAL, not epistemic. They reference
// propositions and witnesses; the claims themselves stay in the existing
// epistemic stack — the `Prop`, the reasoning:ReasoningSentence that discharges
// it, and the Observed/Declared/Citation witness. So `objective:` is a thin
// planning layer over the reasoning stack, never a parallel epistemics.
//
// An Objective is a DAG: a thesis Milestone, intermediate Milestones (each a
// proposition to derive, with acceptance criteria), and Axioms (pointers to
// admitted premises). Completion is a QUERY — a Milestone is satisfied iff a
// Holds reasoning:ReasoningSentence carries its proposition. Frame revision is
// first-class (objective:supersedes): reframing is the normal case, and the
// admissibility gates re-run on each version.
//
// Stacks above core + reasoning (it references reasoning:proposition's encoding).

namespace core       = "urn:eigenius:core";
namespace reasoning  = "urn:eigenius:reasoning";
namespace reflection = "urn:eigenius:reflection";
namespace epistemic  = "urn:eigenius:reflection:epistemic";
namespace eigentt    = "urn:eigenius:eigentt";
namespace objective  = "urn:eigenius:objective";

// ── Classes ──────────────────────────────────────────────────────────

class objective:Objective {
    description = "The root planning node for a unit of science/engineering work — the obligation graph as a typed resource. Holds the thesis (objective:thesis → the root Milestone), a version + a supersedes edge to the prior version (reframing is the normal case; gates re-run on revision), the working branch, and an overall well-posedness status. Distinct from D21 kernel tasks / bench:TaskOutput (D58 §6): this is the reasoning FRAME, not a program run.";
    requires   objective:thesis;
    recommends objective:version, objective:supersedes, objective:branch,
               objective:status;
}

class objective:Milestone {
    description = "A proposition to establish, with acceptance criteria. Carries the Prop (objective:proposition — the same value the discharging reasoning:ReasoningSentence will carry), the acceptance grade + witness kind + falsifier, and the intended-warrant edges (objective:depends_on → other Milestones/Axioms). Completion is a query: the milestone is satisfied iff a Holds reasoning:ReasoningSentence carries its proposition (objective:satisfied_by records which). The thesis is just the root Milestone. The Checkable gate (D58 §3) is a TYPE CHECK, not a runtime query: proposition + acceptance_grade + witness_kind + falsifier are all required, so the structural validator rejects any milestone whose acceptance is undefined at commit — a non-checkable milestone cannot be recorded.";
    requires   objective:proposition, objective:acceptance_grade,
               objective:witness_kind, objective:falsifier;
    recommends objective:depends_on, objective:status,
               objective:frontier_gate, objective:satisfied_by;
}

class objective:Axiom {
    description = "A premise admitted WITHOUT derivation — a pointer to an already-admitted witness, not the witness itself. Carries the Prop, the axiom kind (observed | declared; a 'cited' premise is just declared with a reference:Citation witness), and objective:witness (the IsObservedAs / IsDeclaredAs / reference:Citation IRI). objective:witness is REQUIRED: an axiom that names no witness is an unjustified assumption, and the structural validator rejects it at commit — so the presence half of the Anchored gate (D58 §3) is a type check. The residual (does the named witness actually resolve to an admitted IsObservedAs/IsDeclaredAs/Citation) is the open-world part left to a query.";
    requires   objective:proposition, objective:axiom_kind, objective:witness;
}

// ── D61 decision layer (typed discovery / decision-making nodes; D61 §5) ──
// The descent (D61 §3) emits these. Each carries its CONTENT as a typed Prop
// (objective:proposition / objective:option_claim), never prose — the faithfulness
// bridge: typed content is queryable/verifiable, prose is only human-judgeable.
// Structural, like the D58 nodes: they reference Props + witnesses, never a
// parallel epistemics.

class objective:CompetencyQuestion {
    description = "A discovery target AND a runnable falsifier — the typed form of objective:falsifier (D58 left it a prose string). A question the grounding must answer before a dependent Milestone may conclude: the question as a Prop (objective:proposition), a runnable EigenQL falsifier (objective:query) with its expected result (objective:expected_answer), and what it probes (objective:probes). GROUNDED when objective:grounded_by names the witness/verdict answering it; OPEN otherwise — an open CQ blocks its Milestone via the Discovered gate (D61 §6).";
    requires   objective:proposition, objective:query, objective:expected_answer;
    recommends objective:probes, objective:grounded_by, objective:status;
}
class objective:DecisionPoint {
    description = "A decision any instance of a task-type must make (descent move 1): the decision as a Prop (objective:proposition), a TYPED option space (objective:options -> objective:Option), the selected option (objective:selected), and the warrant. Recording DecisionPoints makes a task-type's decision structure retrievable & reusable (move-1 retrieve-first).";
    requires   objective:proposition, objective:options, objective:selected;
    recommends objective:warrant, objective:status;
}
class objective:Option {
    description = "A typed alternative inside a DecisionPoint's option space; its claim is a Prop (objective:option_claim) — what lets a DesirableProperty be checked against it.";
    requires   objective:option_claim;
    recommends objective:warrant;
}
class objective:Hypothesis {
    description = "A formulated conjecture (descent): a Prop asserted as a Declared hypothesis, with the path to a DECISIVE OUTCOME — objective:resolved_by names the sentence/verdict that discharges it (Derived/Verified) or refutes it (a recorded finding); objective:outcome records held|refuted|open. Unlike a Milestone, a Hypothesis MAY turn out false — refutation is a valid outcome.";
    requires   objective:proposition;
    recommends objective:resolved_by, objective:outcome, objective:status;
}
class objective:DesirableProperty {
    description = "A property a good instance should have (descent move 3). Content is a Prop (objective:proposition) that becomes a CompetencyQuestion (objective:checked_by) and/or a DecisionPoint warrant. Carries a priority.";
    requires   objective:proposition;
    recommends objective:priority, objective:checked_by, objective:status;
}
class objective:Limitation {
    description = "A property the target CANNOT satisfy, with reason (descent move 4). Content is a Prop stating the inexpressibility (objective:proposition) + a reason + the consequence (objective:consequence -> a CutItem / demoted DesirableProperty). Limitations locate where faithfulness is at risk.";
    requires   objective:proposition, objective:reason;
    recommends objective:consequence, objective:status;
}
class objective:Tension {
    description = "Two DesirableProperties that cannot be jointly maximized (descent move 4): objective:between -> the two, objective:resolved_by -> the DecisionPoint that trades them off. The sharpest CompetencyQuestions sit on a Tension's resolution.";
    requires   objective:between;
    recommends objective:resolved_by, objective:status;
}
class objective:CutItem {
    description = "An item the artifact does not cover, recorded with reason + disposition (descent move 5). Makes 'nothing silently dropped' a query.";
    requires   objective:proposition, objective:reason, objective:disposition;
}

// ── Enumerations (resource vocabularies; allows_only constrains to these) ──
//
// The grade fields REUSE reflection:EpistemicStatus (the canonical four-grade
// vocabulary: epistemic:{observed,declared,derived,verified}) rather
// than minting a parallel enum — objective: is a thin layer over the reflection
// epistemic stack. The only objective-specific enum is WitnessKind (operational
// "how", no reflection analog). Plain-string fields (status, frontier_gate)
// carry mutable progress state and are not enumerated.

class objective:WitnessKind {
    description = "How a Milestone is expected to be witnessed — operational planning metadata with no reflection analog (reflection's Trace family records the realized 'how'; this is the expected one).";
}
resource objective:wk_layer_commit : objective:WitnessKind {
    core:description = "The witness is the layer commit itself (the resource loaded).";
}
resource objective:wk_query : objective:WitnessKind {
    core:description = "The witness is a query result over the chain.";
}
resource objective:wk_generator_output : objective:WitnessKind {
    core:description = "The witness is the deterministic output of a generator/program run.";
}
resource objective:wk_citation : objective:WitnessKind {
    core:description = "The witness is a reference:Citation carrying the claim.";
}

// CutItem disposition — how an uncovered item is handled (D61 §5).
class objective:Disposition {
    description = "How a CutItem is handled — a resource enum (allows_only-constrained).";
}
resource objective:disp_residual_recorded : objective:Disposition {
    core:description = "Recorded as inert residual / provenance (e.g. D57 Tier-3 relations).";
}
resource objective:disp_excluded : objective:Disposition {
    core:description = "Out of scope by an explicit layer/scope rule (e.g. pending/attic).";
}
resource objective:disp_deferred : objective:Disposition {
    core:description = "Deferred to a future pass.";
}

// ── Properties ───────────────────────────────────────────────────────

property objective:thesis : core:resource {
    description = "The root Milestone of the objective — its thesis proposition + acceptance grade.";
    class_types objective:Milestone;
    domain objective:Objective;
}
property objective:version : core:integer {
    description = "Monotonic version of this objective frame; bumped on each reframing.";
    domain objective:Objective;
}
property objective:supersedes : core:string {
    description = "IRI of the prior objective version this one replaces (frame revision). On a new version, the admissibility gates re-run.";
    domain objective:Objective;
}
property objective:branch : core:string {
    description = "The branch this objective is developed on (branch-per-objective isolation).";
    domain objective:Objective;
}
property objective:status : core:string {
    description = "Well-posedness / progress status: open | blocked | admissible | satisfied. On the Objective (overall) and on each Milestone. Mutable progress state — a plain string, not part of the type contract.";
}
property objective:proposition : core:resource {
    description = "The Prop-typed proposition (eigentt:TypeExpr, encoded as for reasoning:proposition) this Milestone TARGETS or this Axiom admits. Distinct in role from reflection:canonical_proposition: this is the goal an OPEN milestone has not yet established; the discharging reasoning:ReasoningSentence ASSERTS it (carries it as canonical_proposition). On completion the two coincide — objective:satisfied_by links the milestone to that sentence.";
    class_types eigentt:TypeExpr;
}
property objective:acceptance_grade : core:resource {
    description = "The grade this Milestone must reach to count as done — the SAME reflection:EpistemicStatus the rest of the epistemic stack uses (not a parallel enum). allows_only enforces the grade vocabulary at commit — a value-level type check, part of Checkable. (Distinct property from reflection:epistemic_status: this is the TARGET grade of an open goal; epistemic_status is the ACTUAL grade of a produced resource.)";
    class_types reflection:EpistemicStatus;
    allows_only epistemic:observed, epistemic:declared,
                epistemic:derived, epistemic:verified;
    domain objective:Milestone;
}
property objective:witness_kind : core:resource {
    description = "How the Milestone is expected to be witnessed (an objective:WitnessKind). allows_only enforces the kind vocabulary at commit — part of Checkable.";
    class_types objective:WitnessKind;
    allows_only objective:wk_layer_commit, objective:wk_query,
                objective:wk_generator_output, objective:wk_citation;
    domain objective:Milestone;
}
property objective:falsifier : core:string {
    description = "What evidence would refute this Milestone — the Checkable gate's requirement.";
    domain objective:Milestone;
}
property objective:depends_on : core:resource_array {
    description = "Intended-warrant edges: the Milestones/Axioms expected to discharge this Milestone. The plan's dependency graph, before any certificate exists.";
    class_types objective:Milestone, objective:Axiom;
    domain objective:Milestone;
}
property objective:frontier_gate : core:string {
    description = "While status=open, the admissibility gate pending on this Milestone: expressible | anchored | reachable | checkable. Makes the grounding frontier queryable. Mutable progress state — a plain string.";
    domain objective:Milestone;
}
property objective:satisfied_by : core:string {
    description = "IRI of the Holds reasoning:ReasoningSentence that discharged this Milestone's proposition (filled on completion).";
    domain objective:Milestone;
}
property objective:axiom_kind : core:resource {
    description = "The grade of the witness backing this admitted premise — reflection:EpistemicStatus restricted to observed | declared (an axiom is recorded data or an asserted premise; derived/verified things are Milestones, not Axioms). A 'cited' premise is simply DECLARED with a reference:Citation witness — reference:Citation is itself a DeclaredResource — so it needs no separate kind; objective:witness names the Citation.";
    class_types reflection:EpistemicStatus;
    allows_only epistemic:observed, epistemic:declared;
    domain objective:Axiom;
}
property objective:witness : core:string {
    description = "IRI of the admitted witness backing this Axiom (an IsObservedAs / IsDeclaredAs witness, or a reference:Citation).";
    domain objective:Axiom;
}

// ── D61 decision-layer properties (D61 §5.4) ─────────────────────────
property objective:query : core:string {
    description = "A runnable EigenQL falsifier for a CompetencyQuestion. Its expected result is objective:expected_answer; the actual result grounds the CQ (objective:grounded_by) or leaves it OPEN (Discovered gate, D61 §6). This is what types D58's prose objective:falsifier.";
    domain objective:CompetencyQuestion;
}
property objective:expected_answer : core:string {
    description = "The result objective:query must return for the CQ to be grounded (e.g. the empty set, or a specific count).";
    domain objective:CompetencyQuestion;
}
property objective:probes : core:resource {
    description = "The DecisionPoint / DesirableProperty / Limitation this CQ checks.";
    class_types objective:DecisionPoint, objective:DesirableProperty, objective:Limitation;
    domain objective:CompetencyQuestion;
}
property objective:grounded_by : core:string {
    description = "IRI of the witness / verdict / ReasoningSentence answering this CQ (filled when the falsifier returns its expected_answer). Empty => the CQ is OPEN.";
    domain objective:CompetencyQuestion;
}
property objective:discovery_target : core:resource_array {
    description = "The CompetencyQuestions a Milestone must have GROUNDED before it may conclude (the Discovered gate, D61 §6, joins on this). The typed successor to D58's prose falsifier on a Milestone.";
    class_types objective:CompetencyQuestion;
    domain objective:Milestone;
}
property objective:options : core:resource_array {
    description = "A DecisionPoint's option space.";
    class_types objective:Option;
    domain objective:DecisionPoint;
}
property objective:selected : core:resource {
    description = "The chosen Option of a DecisionPoint.";
    class_types objective:Option;
    domain objective:DecisionPoint;
}
property objective:option_claim : core:resource {
    description = "An Option's claim, as a Prop (eigentt:TypeExpr) — never prose.";
    class_types eigentt:TypeExpr;
    domain objective:Option;
}
property objective:warrant : core:resource_array {
    description = "Why a selection holds: the DesirableProperties / CompetencyQuestions / Axioms that justify it.";
    class_types objective:DesirableProperty, objective:CompetencyQuestion, objective:Axiom;
}
property objective:resolved_by : core:string {
    description = "IRI of the ReasoningSentence/verdict (Hypothesis) or DecisionPoint (Tension) that resolved this node.";
}
property objective:outcome : core:string {
    description = "held | refuted | open — a Hypothesis's decisive outcome (refuted is a recorded finding, not a failure).";
    domain objective:Hypothesis;
}
property objective:priority : core:integer {
    description = "Relative importance of a DesirableProperty.";
    domain objective:DesirableProperty;
}
property objective:checked_by : core:resource {
    description = "The CompetencyQuestion that checks a DesirableProperty.";
    class_types objective:CompetencyQuestion;
    domain objective:DesirableProperty;
}
property objective:reason : core:string {
    description = "Why a Limitation holds / why a CutItem is cut.";
}
property objective:consequence : core:resource {
    description = "What a Limitation forces.";
    class_types objective:CutItem, objective:DesirableProperty;
    domain objective:Limitation;
}
property objective:between : core:resource_array {
    description = "The two DesirableProperties in tension.";
    class_types objective:DesirableProperty;
    domain objective:Tension;
}
property objective:disposition : core:resource {
    description = "How a CutItem is handled.";
    class_types objective:Disposition;
    allows_only objective:disp_residual_recorded, objective:disp_excluded,
                objective:disp_deferred;
    domain objective:CutItem;
}
