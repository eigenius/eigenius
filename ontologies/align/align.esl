// Post-parse entity alignment, direct table-row claims, and certification boundary records
// (D103 §4.2, §6.1, §7.2).
//
// Keeps entity resolution out of Stage-A tokenization (preserving D70's syntax/denotation split
// and keeping recorded LLM draws invariant to database re-ingestion), provides direct typed
// anchors for `kind_table` rows without passing through the DCG prose parser, and models the
// `compressed` (non-droppable qualifiers) and `exempt` certification boundaries explicitly.
//
// Chain-loaded over bootstrap (`core`, `eigentt`, `lexicon`, `prov`, `encoding`) + `variant`.

namespace core    = "urn:eigenius:core";
namespace eigentt = "urn:eigenius:eigentt";
namespace lexicon = "urn:eigenius:lexicon";
namespace prov    = "urn:eigenius:prov";
namespace enc     = "urn:eigenius:encoding";
namespace variant = "urn:eigenius:variant";
namespace align   = "urn:eigenius:align";

// ── Direct table-row claims (D103 Decision D3) ───────────────────────────────────────────────

class align:TableRowClaim : lexicon:Entity {
    description = "A structured claim derived directly from a `kind_table` enc:DiscourseUnit without passing through the DCG prose parser. Carries its document-tree anchor, closed eigentt:proposition, and accountable agent attribution.";
    requires align:source_unit, eigentt:proposition, prov:was_attributed_to;
    recommends core:short_name, core:description;
}

property align:source_unit : core:resource {
    description = "The D101 enc:DiscourseUnit (typically kind_table) from which this structured claim was derived.";
    class_types enc:DiscourseUnit;
    domain align:TableRowClaim;
}

// ── Certification boundary records: `compressed` & `exempt` (D103 §7.2) ──────────────────────

class align:CompressionRecord : lexicon:Entity {
    description = "Explicit record for a `compressed` summary or section-heading claim. Logical entailment admits dropping caveats (A ∧ Q → A); this record binds the summary claim to the body claims it compresses and the non-droppable qualifier resources that must survive or be explicitly discharged.";
    requires align:summary_claim, align:compresses, align:required_qualifiers, prov:was_attributed_to;
    recommends align:discharged_qualifiers, align:supersedes, core:short_name, core:description;
}

property align:summary_claim : core:resource {
    description = "The heading or summary claim resource being evaluated under the compression rule.";
    domain align:CompressionRecord;
}

property align:compresses : core:resource_array {
    description = "The body claim resources that the summary compresses.";
    domain align:CompressionRecord;
}

property align:required_qualifiers : core:resource_array {
    description = "Qualifier or caveat resources carried by compressed premises that must not be silently dropped by the summary.";
    domain align:CompressionRecord;
}

property align:discharged_qualifiers : core:resource_array {
    description = "Subset of align:required_qualifiers preserved in the summary or explicitly discharged with attribution. The structural non-droppable-qualifier gate requires every resource in align:required_qualifiers to appear here.";
    domain align:CompressionRecord;
}

property align:supersedes : core:resource {
    description = "Multi-pass revision link: names an earlier-pass claim, conclusion, or certification record superseded by this revised resource.";
}

class align:RetirementRecord : lexicon:Entity {
    description = "Explicit multi-pass provenance record marking an earlier-pass claim or certification record as retired upon document amendment, optionally naming its successor.";
    requires align:retired_resource, align:retirement_reason, prov:was_attributed_to;
    recommends align:superseded_by_resource, core:short_name, core:description;
}

property align:retired_resource : core:resource {
    description = "The earlier-pass resource retired by an amendment.";
    domain align:RetirementRecord;
}

property align:superseded_by_resource : core:resource {
    description = "Optional replacement resource that supersedes the retired resource in the amended pass.";
    domain align:RetirementRecord;
}

property align:retirement_reason : core:string {
    description = "Explicit rationale for retiring the earlier-pass resource.";
    domain align:RetirementRecord;
}

class align:ExemptionRecord : lexicon:Entity {
    description = "Explicit record for an `exempt` document unit (e.g. scope caveat or navigational framing) placed deliberately outside the warrant gate with a stated reason and accountable agent.";
    requires align:exempt_unit, align:exemption_reason, prov:was_attributed_to;
    recommends core:short_name, core:description;
}

property align:exempt_unit : core:resource {
    description = "The D101 enc:DiscourseUnit explicitly exempted from factual warranting.";
    class_types enc:DiscourseUnit;
    domain align:ExemptionRecord;
}

property align:exemption_reason : core:string {
    description = "Explicit rationale explaining why this unit is exempt from factual certification.";
    domain align:ExemptionRecord;
}

// ── Post-parse entity alignment predicates (D103 Decision D2) ────────────────────────────────

// 1-to-1 same-resolution alignment from a Stage-A document-local individual (`doc:ni_*`) to
// an ingested domain entity (`variant:*`, `structure:*`, `clinvar:*`, etc.).
axiom align:DenotesEntity : lexicon:Entity -> lexicon:Entity -> Prop

// Non-injective cross-resolution editorial bridge: in this claim, a protein-level designation
// denotes a specific nucleotide allele whose genotypes were counted.
axiom align:DesignationDenotes : variant:ProteinAllele -> variant:NucleotideAllele -> Prop

// Non-injective residue-to-allele editorial bridge: a coarse residue location designates a
// specific allele.
axiom align:LocationDesignates : variant:Location -> variant:Allele -> Prop
