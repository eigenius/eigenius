  {
    "@id": "urn:eigenius:formulas:Operator",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Class"],
    "urn:eigenius:core:short_name": "Operator",
    "urn:eigenius:core:description": "A function symbol in the FormulaTerm language. Carries a typed EigenTT signature so chain validation can rank-check App invocations at commit time and so cross-institution comorphisms can type-check at the chain boundary. The signature is itself a FormulaTerm value (via `Pi` ctors) so the type language dogfoods its own metasystem — types are nullary functions in this view. See D32 §5.",
    "urn:eigenius:core:requires": [
      "urn:eigenius:core:is_a",
      "urn:eigenius:core:short_name",
      "urn:eigenius:formulas:operator_signature"
    ],
    "urn:eigenius:core:recommends": [
      "urn:eigenius:core:description",
      "urn:eigenius:formulas:operator_arity",
      "urn:eigenius:formulas:operator_associativity",
      "urn:eigenius:formulas:operator_commutativity"
    ]
  },

  {
    "@id": "urn:eigenius:formulas:operator_signature",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:short_name": "operator_signature",
    "urn:eigenius:core:description": "The operator's EigenTT type, encoded as a FormulaTerm value. Non-dependent operators use `Pi` with unnamed binders (`_`) chained left-to-right. Example for binary `add: Real -> Real -> Real`: `Pi(_, OpRef(formulas:types:Real), Pi(_, OpRef(formulas:types:Real), OpRef(formulas:types:Real)))`. The chain validator rank-checks `App(OpRef, args)` invocations against this signature.",
    "urn:eigenius:core:data_type": "urn:eigenius:core:inductive",
    "urn:eigenius:core:class_types": ["urn:eigenius:formulas:FormulaTerm"],
    "urn:eigenius:core:domain": ["urn:eigenius:formulas:Operator"]
  },
  {
    "@id": "urn:eigenius:formulas:operator_arity",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:short_name": "operator_arity",
    "urn:eigenius:core:description": "Number of arguments the operator takes. Redundant with `operator_signature` for non-dependent operators; the validator may use it as a fast-path arity check before walking the full signature.",
    "urn:eigenius:core:data_type": "urn:eigenius:core:integer",
    "urn:eigenius:core:domain": ["urn:eigenius:formulas:Operator"]
  },
  {
    "@id": "urn:eigenius:formulas:operator_associativity",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:short_name": "operator_associativity",
    "urn:eigenius:core:description": "Algebraic associativity discipline. Allowed string values: `left`, `right`, `none`, `n_ary`. `n_ary` lets institutions internally flatten nested App spines (e.g. `App(App(add, a), b), c -> Add([a, b, c])`); the chain shape stays curried regardless. v1 doesn't add an `allows_only` constraint here because that property's `data_type: resource_array` would force the four values to be declared as separate Resources — overkill for a v1 enumeration.",
    "urn:eigenius:core:data_type": "urn:eigenius:core:string",
    "urn:eigenius:core:domain": ["urn:eigenius:formulas:Operator"]
  },
  {
    "@id": "urn:eigenius:formulas:operator_commutativity",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:Property"],
    "urn:eigenius:core:short_name": "operator_commutativity",
    "urn:eigenius:core:description": "Whether the operator is commutative under its declared algebra. Convenience for normal-form computation; not enforced by the validator.",
    "urn:eigenius:core:data_type": "urn:eigenius:core:boolean",
    "urn:eigenius:core:domain": ["urn:eigenius:formulas:Operator"]
  },

