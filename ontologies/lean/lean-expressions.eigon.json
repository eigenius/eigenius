  {
    "@id": "urn:eigenius:lean:LeanLevelList",
    "urn:eigenius:core:is_a": ["urn:eigenius:core:InductiveType"],
    "urn:eigenius:core:short_name": "LeanLevelList",
    "urn:eigenius:core:description": "Cons-list carrier for the universe-instantiation array on `LeanExpr.Const`. Two ctors — `Nil` and `Cons(head: LeanLevel, tail: LeanLevelList)`. Carries `Const`'s positional universe parameters in source order: a `Const` with no universe params encodes as `Nil`; `Const \"List\" [u]` encodes as `Cons(u, Nil)`; `Const \"PProd\" [u, v]` as `Cons(u, Cons(v, Nil))`. v1 uses a cons-list rather than `core:value_array<LeanLevel>` because the chain's `core:element_type` is constrained to primitive types (`core:allows_only: [string, integer, float, boolean, json]`), so a value-array of inductive elements wouldn't validate. The translator (D40 §4.1, eigenius-lean Phase 20a.4) converts to/from nanoda's flat `Arc<[LevelPtr]>` shape via `iter().rev().fold(Nil, |acc, l| Cons(l, acc))` and back.",
    "urn:eigenius:core:ctors": [
      {
        "urn:eigenius:core:is_a": ["urn:eigenius:core:InductiveCtor"],
        "urn:eigenius:core:ctor_name": "Nil"
      },
      {
        "urn:eigenius:core:is_a": ["urn:eigenius:core:InductiveCtor"],
        "urn:eigenius:core:ctor_name": "Cons",
        "urn:eigenius:core:arg_types": [
          {
            "urn:eigenius:core:is_a": ["urn:eigenius:core:InductiveArgType"],
