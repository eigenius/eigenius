// @eigenius/client — TypeScript SDK for the Eigenius platform.
//
// Browser-side and Deno-side consumers; uses Connect-Web transport
// against the orchestrator's NotebookService and EigeniusKernel routes.
// See D22 §5.

{
  "name": "@eigenius/client",
  "version": "0.0.1",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "smoke": "deno run --allow-net --allow-env examples/smoke-test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2",
    "@connectrpc/connect-web": "npm:@connectrpc/connect-web@^2"
  },
  "lint": {
    "exclude": ["generated/"]
  },
  "fmt": {
    "exclude": ["generated/"]
  },
  "compilerOptions": {
    "strict": true
  }
}
