// ════════════════════════════════════════════════════════════════════
// COMPANION to vpadj-enumerate-verbal.esl — the `adj` member of the enumeration.
//
// The verbal-only enumeration (skeletons 179 -> 165, gap 0) lost exactly ONE pin:
// «MSI is associated with notable responses to immune checkpoint blockade.», whose expected
// reading And(P(x), prep_with(x, ...)) adjoins `with` to the ADJECTIVAL VP of `is associated`.
//
// Excluding `adj` outright was too strong. The false-identity defect is not that `adj` is
// admitted — it is that `fin_any` LAUNDERS it: an adjectival VP goes in and a clause-rootable
// VP comes out. An adj -> adj entry cannot launder, because `is_finite_clause` does not accept
// `adj`, so the result still requires the copula. The restriction that matters is that the
// result feature EQUALS the argument feature, not that `adj` be absent.
//
// ─────────────────────────────────────────────────────────────────────
// RESULT 2026-08-01: REFUTED. gap 0, skeletons 165 -> 207, readings 852 -> 978, encoded 13 -> 12,
// expected-hits 59 -> 58. It did NOT recover the pin it was built for, and lost «We hypothesized ...
// would give rise to synthetic-lethal relationships.» on top.
//
// So the pinned `with` does not adjoin to an adjectival VP: its `associated` is the VERB synset
// `v02589245_i`, and the reading survives under `fin_any` for a reason no feature pair reproduces
// (vpadj-crossproduct.esl). What this layer DOES establish is the size of the `adj` member --
// 207 - 165 = 42 skeletons, matching the ledger's PP-attachment `available` family.
// ─────────────────────────────────────────────────────────────────────
// ════════════════════════════════════════════════════════════════════

namespace lexicon   = "urn:eigenius:lexicon";
namespace logic     = "urn:eigenius:logic";
namespace ontology  = "urn:eigenius:ontology";
namespace epistemic = "urn:eigenius:reflection:epistemic";
namespace measurements = "urn:eigenius:measurements";
namespace core         = "urn:eigenius:core";

resource lexicon:between_prep_adj : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking a relation between two things.";
    lexicon:form     = "between";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:adj), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:prep_between_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "between";
    lexicon:grade    = epistemic:declared;
}
