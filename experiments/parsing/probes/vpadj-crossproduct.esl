// ════════════════════════════════════════════════════════════════════
// VP-ADJUNCT PREPOSITION — FULL 7x7 FEATURE CROSS-PRODUCT (11 preps x 49 = 539 entries).
//
// DISCRIMINATOR, not a proposed fix. `fin_any` on both sides does two things at once:
//   (a) it permits every (result, argument) feature pair, including MIXED ones;
//   (b) it LAUNDERS — `is_finite_clause` accepts `fin_any`, so an adjunction over a
//       non-finite VP yields a VP the root gate takes as a finite clause.
// The verbal-only enumeration (result == argument, no `adj`) removed BOTH at once: skeletons
// 179 -> 165, gap 0, but «MSI is associated with notable responses...» fell 56 -> 16 readings
// and lost its pin. Restoring `adj` as adj -> adj did not recover it (165 -> 207, pins 59 -> 58),
// so the reading needs a MIXED pair.
//
// This layer keeps (a) and removes only (b): every pair is expressible, but no entry carries
// `fin_any`, so no result is root-acceptable unless it is literally `fin`. If the pin returns,
// laundering is the whole defect and the fix is a concrete result feature. If it does not, the
// enumeration is losing something structural and the diagnosis is wrong.
//
// ─────────────────────────────────────────────────────────────────────
// RESULT 2026-08-01. gap 0, encoded 12 -> 11, readings 988 -> 975, skeletons 179 -> 207,
// expected-hits 60 -> 57. Bit-identical at CELL_BEAM 256, so this is NOT beam eviction.
//
// THE DISCRIMINATOR ANSWERS AGAINST THE ENUMERATION. Every (result, argument) pair is expressible
// here and the pin «MSI is associated with notable responses to immune checkpoint blockade.» is STILL
// lost, along with «MSI can arise from Lynch syndrome.» and «We hypothesized ... would give rise to ...».
// So the reading `fin_any` licenses is not any concrete pair: `fin_any` does not stand for "some pair",
// it ERASES the feature, and the erasure is load-bearing.
//
// This closes the whole "replace `fin_any` with concrete features" family on the VP-adjunct preposition.
// Measured, all coverage-preserving (gap 0):
//     fin_any (base)          179 skeletons   60/62 pins
//     require `fin`           160             55/62      0d9d72c
//     `cat_fin_forall` bind   207             59/62      980e5c8
//     `fin_verbal`            135             GAP 2      0c08504  (root gate rejects it)
//     enumerate 6 verbal      165             59/62      vpadj-enumerate-verbal.esl
//     enumerate 7 (incl adj)  207             58/62
//     cross-product 7x7       207             57/62      this file
//
// Reading the table: 207 is the UN-COLLAPSED ambiguity -- `fin_any` masks distinct derivations under one
// skeleton, so the 179 baseline understates what the grammar actually admits. Against 207, dropping the
// `adj` member removes 42 skeletons, which is the size of the ledger's PP-attachment `available` family.
// The cost of dropping it is exactly one pin, and no feature assignment recovers that pin.
// ─────────────────────────────────────────────────────────────────────
// ════════════════════════════════════════════════════════════════════

namespace lexicon   = "urn:eigenius:lexicon";
namespace logic     = "urn:eigenius:logic";
namespace ontology  = "urn:eigenius:ontology";
namespace epistemic = "urn:eigenius:reflection:epistemic";
namespace measurements = "urn:eigenius:measurements";
namespace core         = "urn:eigenius:core";

resource lexicon:between_prep : lexicon:LexicalEntry {
    core:description = "grammatical: preposition marking a relation between two things.";
    lexicon:form     = "between";
    lexicon:cat      = type_expr( lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:prep_between_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "between";
    lexicon:grade    = epistemic:declared;
}
