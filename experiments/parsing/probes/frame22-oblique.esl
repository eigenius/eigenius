// ════════════════════════════════════════════════════════════════════
// PATCH LAYER — WordNet sentence-frame 22 reclassified, for ONE synset.
//
// HYPOTHESIS UNDER TEST. `convert.rs::classify` maps WordNet frames as
//     1 | 2 | 3 | 22 => Intransitive
//     4 | 12 | 23 | 27 => PpOblique
// but the authoritative list (doc/man/wninput.5) says
//     22  Somebody ----s PP              <- a PP frame, classified Intransitive
//     23  Somebody's (body part) ----s   <- an intransitive, classified PpOblique
// i.e. 22 and 23 are SWAPPED. `give rise` (synset 01752884, {produce, bring about, give rise})
// carries frames 11 and 22, so today it emits Transitive + Intransitive and NO oblique-PP slot.
// `give rise TO X` therefore cannot consume its `to`-PP as an argument; the PP can only attach as
// an ADJUNCT, and an adjunct can attach anywhere — including the matrix subject, across a finite
// `that`-clause. That is the last `invalid` row on the WRN page:
//     And(hypothesize(Would(give_rise(defects)), speaker), prep_to(speaker, relationships))
//     "we hypothesize [that defects would give rise] and we to a synthetic-lethal relationship"
// The reading uses `wn:v01752884_i` — the intransitive frame — which is the lexical fingerprint.
//
// THIS LAYER SIMULATES THE CORRECTED CLASSIFICATION FOR THAT ONE SYNSET, so the diagnosis can be
// tested WITHOUT a reseed. The real change is one line and reaches 1113 synsets; measuring THAT
// needs a reseed. This measures only whether the missing frame is the cause.
//
// Two halves, because the fix is a REPLACEMENT and not an addition:
//   (1) SUPPRESS the intransitive entries. A closer layer redefines each with a non-matching
//       `lexicon:form`; the lazy index skips an entry whose resolved form no longer normalizes to
//       the queried key ("Shadow safety" in `dcg::lexicon`), so the surface stops reaching it.
//   (2) ADD the oblique-PP entries the corrected classification would emit —
//       `(S\NP)/cat_pp_arg(prep_any)`, the same shape `FrameKind::PpOblique` produces.
// ════════════════════════════════════════════════════════════════════
namespace core      = "urn:eigenius:core";
namespace epistemic = "urn:eigenius:reflection:epistemic";
namespace lexicon   = "urn:eigenius:lexicon";
namespace wn        = "urn:eigenius:wn";

// The oblique-PP frame's denotation: `⟦(S\NP)/cat_pp_arg⟧ = Entity -> Entity -> Prop`, the same
// arity as the transitive, since `⟦cat_pp_arg⟧ = Entity`.
axiom wn:v01752884_p : lexicon:Entity -> lexicon:Entity -> Prop desc: "cause to happen, occur or exist (oblique-PP frame; WordNet sentence frame 22)"


// (1) suppressed: frame 22 is not an intransitive frame.
resource wn:e_v01752884_i_0_b : lexicon:LexicalEntry {
    lexicon:form       = "__frame22_suppressed__";
    lexicon:cat        = type_expr( lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:bse), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem        = wn:v01752884_i;
    lexicon:sem_type   = type_expr( lexicon:Entity -> Prop );
    lexicon:sense      = "wn:produce.v.01752884";
    lexicon:grade      = epistemic:declared;
    lexicon:in_lexicon = lexicon:wordnet;
}

