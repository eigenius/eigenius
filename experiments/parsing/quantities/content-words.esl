// Content words for the D95 quantity corpus (corpus.tsv): the nouns and verbs around its quantities,
// in the shapes the WordNet importer emits — a singular, plural or mass noun; a transitive past
// participle `(S[pss]\NP)/NP`, which the short passive `be` takes; a finite transitive verb. A verb
// is named as the importer names it, `v{offset}_{frame}` with sense `wn:{lemma}.v.{offset}`, so it
// verbalizes; the offsets are made up. The closed class supplies everything else. Loaded by
// kernel/tests/quantity_corpus.rs.

namespace lexicon = "urn:eigenius:lexicon";
namespace corpus  = "urn:eigenius:quantity-corpus";

class corpus:Flask : lexicon:Entity { }
resource corpus:flask_n : lexicon:LexicalEntry {
    lexicon:form     = "flask";
    lexicon:cat      = type_expr( lexicon:cat_n(corpus:Flask, lexicon:sg) );
    lexicon:sem      = corpus:Flask;
    lexicon:sem_type = type_expr( Set );
    lexicon:sense    = "flask";
}
