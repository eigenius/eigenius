resource pmi:SYN_25_003_outcome_details : enc:DiscourseUnit {
    enc:prose = "Research report delivered to treating neurologist 2025-10-21, proposing a repurposing candidate on a cofactor-supplementation rationale. Neurologist initiated a 12-week trial. Participant reported subjective improvement in exercise tolerance at follow-up survey; no objective measure was collected. Reported outcome is participant-reported and uncontrolled -- recorded as such.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Outcome (Details)";
}

