}

resource pmi:SYN_25_003_medications : enc:DiscourseUnit {
    enc:prose = "no disease-directed therapy\ncreatine monohydrate 5 g daily (self-initiated)\ncholecalciferol 2000 IU daily";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Medications";
