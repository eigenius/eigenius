resource pmi:SYN_25_003_diagnosis : enc:DiscourseUnit {
    enc:prose = "Confirmed autosomal recessive metabolic myopathy (compound heterozygous, SYNMET). Diagnosis established 2019; no disease-modifying therapy available.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Diagnosis";
}

