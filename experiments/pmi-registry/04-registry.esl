// PMI Case Registry records as registry declarations (D99 step 4).
// Generated by `pmi-registry-convert` from experiments/uab/UAB Round 1/02-synthetic-pmi-registry/synthetic-cases.json; HPO 2026-09-01 with 17 earlier releases. Do not edit.

namespace core          = "urn:eigenius:core";
namespace lexicon       = "urn:eigenius:lexicon";
namespace logic         = "urn:eigenius:logic";
namespace eigentt       = "urn:eigenius:eigentt";
namespace justification = "urn:eigenius:justification";
namespace prov          = "urn:eigenius:prov";
namespace enc           = "urn:eigenius:encoding";
namespace ontology      = "urn:eigenius:ontology";
namespace variant       = "urn:eigenius:variant";
namespace clinical      = "urn:eigenius:clinical";
namespace hp            = "urn:obo:HP";
namespace wn            = "urn:eigenius:wn";
namespace pmi           = "urn:eigenius:pmi";
namespace gene          = "urn:eigenius:pmi:gene";
namespace allele        = "urn:eigenius:variant:allele";
namespace seqref        = "urn:eigenius:variant:reference";

resource pmi:registry : prov:Organization {
    core:description = "The PMI Case Registry (UAB Precision Medicine Institute): the party that transcribed each registry value from a case's records.";
    core:short_name = "pmi_registry";
}

// ── SYN-26-001 ──────────────────────────────────────────

resource pmi:SYN_26_001_medical_records : prov:Source {
    core:description = "SYN-26-001's medical records: clinic notes and lab reports (tier 3, UAB ShareFile). Not held; the registry's Medical Records field links them.";
}

resource pmi:SYN_26_001_case_notes : prov:Source {
    core:description = "SYN-26-001's analyst notes (tier 2, Google Drive). Not held; the registry's Case Notes field links them.";
}

resource pmi:SYN_26_001_proband : clinical:Individual {
    core:description = "The individual SYN-26-001 is about.";
    clinical:birth_year = 2021;
    clinical:sex = clinical:male;
}

resource pmi:SYN_26_001_proband_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_proband;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001 : clinical:Case {
    clinical:case_id = "SYN-26-001";
    clinical:subject = [pmi:SYN_26_001_proband];
}

resource pmi:SYN_26_001_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001_diagnosis : enc:DiscourseUnit {
    enc:prose = "Undiagnosed. Global developmental delay, hypotonia, intractable epilepsy with onset at 7 months, cortical visual impairment, feeding intolerance requiring G-tube, recurrent respiratory infections. Trio exome non-diagnostic (2024); three VUS reported. Trio genome pending reanalysis.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-001 Diagnosis";
}

resource pmi:SYN_26_001_diagnosis_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_diagnosis;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001_symptoms : enc:DiscourseUnit {
    enc:prose = "seizures (multiple types, poorly controlled on 3 AEDs), developmental delay, hypotonia, poor visual tracking, dysphagia, failure to thrive";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-001 Symptoms";
}

resource pmi:SYN_26_001_symptoms_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_symptoms;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001_case_history : enc:DiscourseUnit {
    enc:prose = "Term birth, uncomplicated pregnancy, no NICU stay. Development reportedly normal until approximately 5 months, when parents noted decreased head control and poor visual tracking. First seizure at 7 months, initially focal, later with generalized tonic-clonic events. Trialed on levetiracetam, then valproate, then added clobazam; partial response only. Two unaffected older siblings. No consanguinity. Maternal cousin with unspecified 'seizure disorder' in childhood, records not available.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-001 Case History";
}

resource pmi:SYN_26_001_case_history_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_case_history;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001_family_goal : enc:DiscourseUnit {
    enc:prose = "A diagnosis if one exists. Failing that, anything that might improve seizure control -- parents specifically asked whether there are treatments that target the underlying biology rather than just suppressing seizures.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-001 Participant/Family Goal";
}

resource pmi:SYN_26_001_family_goal_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_family_goal;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

resource pmi:SYN_26_001_medications : enc:DiscourseUnit {
    enc:prose = "levetiracetam 30 mg/kg/day divided BID\nvalproate 25 mg/kg/day divided BID\nclobazam 0.5 mg/kg/day\nomeprazole 1 mg/kg/day\ncholecalciferol 400 IU daily";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-001 Medications";
}

resource pmi:SYN_26_001_medications_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_001_medications;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    prov:timestamp = "2026-02-11";
}

