resource pmi:SYN_26_002_diagnosis : enc:DiscourseUnit {
    enc:prose = "X-linked tubulopathy with polyuria and polydipsia. Hemizygous variant in SYNGENE identified on renal gene panel, classified Likely Pathogenic. Two trials of the standard first-line agent without response.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-002 Diagnosis";
}

resource pmi:SYN_26_002_diagnosis_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_002_diagnosis;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_002_medical_records;
    prov:timestamp = "2026-05-19";
}

resource pmi:SYN_26_002_symptoms : enc:DiscourseUnit {
    enc:prose = "polyuria, polydipsia, recurrent hypernatremic dehydration, poor weight gain, irritability, disrupted sleep from nocturia";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-002 Symptoms";
}

resource pmi:SYN_26_002_symptoms_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_002_symptoms;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_002_medical_records;
    prov:timestamp = "2026-05-19";
}

resource pmi:SYN_26_002_case_history : enc:DiscourseUnit {
    enc:prose = "Presented at 4 months with failure to thrive and two admissions for hypernatremic dehydration. Water deprivation testing consistent with a nephrogenic rather than central mechanism. Renal gene panel returned a hemizygous missense variant in SYNGENE, maternally inherited; mother is an asymptomatic carrier. Treating nephrologist trialed the standard first-line agent twice, at escalating dose, on the basis of published reports that the variant at this codon is responsive. Neither trial produced a measurable reduction in urine output. Family was referred to PMI after the second failure.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-002 Case History";
}

resource pmi:SYN_26_002_case_history_trace : prov:DeclarationTrace {
    prov:resource = pmi:SYN_26_002_case_history;
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_002_medical_records;
    prov:timestamp = "2026-05-19";
}

resource pmi:SYN_26_002_family_goal : enc:DiscourseUnit {
    enc:prose = "Understand why the medication did not work, and whether there is an alternative. Mother specifically asked whether the published reports the nephrologist relied on were about the same variant her son has.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-002 Participant/Family Goal";
}

