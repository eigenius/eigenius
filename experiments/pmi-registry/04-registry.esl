resource pmi:SYN_26_001_carries_NM_000001_1_1234_A : justification:Declaration {
    core:description = "SYN-26-001's subject carries NM_000001.1:c.1234G>A, heterozygous, de novo.";
    prov:was_attributed_to = pmi:registry;
    prov:had_primary_source = pmi:SYN_26_001_medical_records;
    eigentt:proposition = type_expr(logic:And(clinical:Carries(pmi:SYN_26_001_proband, allele:NM_000001_1_1234_A, clinical:heterozygous), clinical:DeNovo(pmi:SYN_26_001_proband, allele:NM_000001_1_1234_A)));
}

