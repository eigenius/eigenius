resource pmi:SYN_25_003_case_history : enc:DiscourseUnit {
    enc:prose = "Symptom onset in late adolescence, initially attributed to deconditioning. Diagnosis established at age 21 on a metabolic myopathy panel following a rhabdomyolysis admission. Two variants in trans, both classified Pathogenic. Managed supportively since. Participant contacted PMI after a public talk, asking specifically about repurposing candidates rather than a diagnostic question.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Case History";
}

