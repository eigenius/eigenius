    prov:timestamp = "2025-06-03";
}

resource pmi:SYN_25_003_family_goal : enc:DiscourseUnit {
    enc:prose = "Identify any approved drug with a plausible mechanism against the specific enzymatic deficit, so it can be discussed with her neurologist. Explicitly not looking for a diagnosis -- she has one.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Participant/Family Goal";
}

