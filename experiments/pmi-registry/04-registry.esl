resource pmi:SYN_26_002_gene_1_notes : enc:DiscourseUnit {
    enc:prose = "Maternally inherited; mother is a heterozygous carrier, asymptomatic. Absent from ClinVar. Functional data in the literature for this specific nucleotide change report <4% of wild-type ligand binding sites reaching the membrane. NOTE: a DIFFERENT variant at the same codon (c.130C>T, p.Leu44Phe) is in ClinVar as pathogenic and IS reported as responsive to the first-line agent. These are one nucleotide apart and are routinely written the same way in prose ('the Leu44 variant'). Do not conflate.";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-26-002 Gene Info 1 Notes";
}

