}

resource pmi:SYN_25_003_symptoms : enc:DiscourseUnit {
    enc:prose = "exercise intolerance, proximal muscle weakness, episodic rhabdomyolysis (3 episodes since 2021), chronic fatigue";
    enc:unit_kind = enc:kind_prose;
    enc:section = "SYN-25-003 Symptoms";
}

