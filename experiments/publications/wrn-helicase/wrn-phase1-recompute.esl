    bench:extraction_columns    = "avg_WRN_dep";
    bench:extraction_filter     = "common_MSI_lineage=1 & CCLE_MSI in {MSI,MSS} & avg_WRN_dep real (NaN/NA dropped); group A=MSI (n=37), B=MSS (n=91); each sorted ascending";
    bench:extraction_recipe     = "extract/extract_samplesets.py#wrn:wrn_dep_sampleset";

    stats:sample_set_value = stats:IID(
