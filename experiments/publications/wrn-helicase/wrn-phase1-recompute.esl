resource wrn:wrn_recq_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:wrn_recq_sampleset;
    reflection:source    = "depmap:18Q4 Achilles gene_effect.csv + Supp Table 1 (pinned snapshot)";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:wrn_recq_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set = wrn:wrn_recq_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "dependency_score");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:msi_directionality_witness");
    stats:variance_assumption = RankBased();
    stats:outlier_exclusion   = Identity();
}

resource wrn:wrn_recq_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:wrn_recq_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

// The uniqueness rule. Its antecedent is the kernel-recomputed WRN result
// (MSI mean dependency strictly below MSS in the RecQ cohort); its
// rationale records the three other RecQ helicases' kernel-computed,
// non-significant p-values as the declared basis for "only WRN".
resource wrn:recq_uniqueness_rule : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:recq-family-specificity";
    reflection:rationale   = "Among the RecQ helicases tested MSI-vs-MSS in the same Achilles CRISPR-CERES cohort (32 MSI / 413 MSS, all lineages): only WRN has a significant MSI-selective dependency (Wilcoxon P = 1.1e-8, median -0.49 vs -0.11; kernel-recomputed via wrn_recq_plan). BLM (P = 0.65), RECQL (P = 0.58) and RECQL5 (P = 0.11) are all non-significant (kernel-computed against the same pinned snapshot); RECQL4 is absent from the 18Q4 CERES matrix (paper Ext Data 1c: n.s.). A null is not derivable, so the non-selectivity of the other three is a declared scientific judgment — at this n and effect scale, their non-significance indicates no MSI-selective dependency. Given WRN's significant selective dependency, WRN is therefore the only MSI-selective RecQ helicase.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:wrn_recq_sampleset"), 0.0)
        ->
        onco:OnlyMSISelectiveInFamily("WRN", "RecQ_helicases")
    );
}

resource wrn:recq_uniqueness_rule_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:recq_uniqueness_rule;
    reflection:declared_by = "wrn-paper:recq-family-specificity";
    reflection:timestamp   = "2026-06-12T14:45:00Z";
}

resource wrn:concl_recq_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    reasoning:proposition = type_expr(
        onco:OnlyMSISelectiveInFamily("WRN", "RecQ_helicases")
    );

    reasoning:justification = App(
        DeclaredEvidence("urn:eigenius:pub:wrn:recq_uniqueness_rule"),
        DerivedEvidence("urn:eigenius:pub:wrn:wrn_recq_plan:result:main_effect")
    );

    reasoning:certificate = type_expr(
        alias
            SS     = "urn:eigenius:pub:wrn:wrn_recq_sampleset",
            RULE   = "urn:eigenius:pub:wrn:recq_uniqueness_rule",
            RESULT = "urn:eigenius:pub:wrn:wrn_recq_plan:result:main_effect",
            STAT   = stats:lt(stats:mean_diff_of(SS), 0.0),
            OM     = onco:OnlyMSISelectiveInFamily("WRN", "RecQ_helicases")
        in
        app(
            STAT, OM,
            DeclaredEvidence(RULE), DerivedEvidence(RESULT),
            declared(RULE, STAT -> OM),
            derived(RESULT, STAT)
        )
    );
}

// ════════════════════════════════════════════════════════════════════
// D-BIOM (recomputed): MSI is a strong biomarker for WRN dependency
// ════════════════════════════════════════════════════════════════════
// A threshold classifier over the SAME wrn_dep_sampleset (37 MSI = group A
// = test-positive, 91 MSS = group B; condition-positive = WRN-dependent =
// avg dependency < -0.5). The statistics institution (ClassificationAnalysisPlan,
// D52 §2.2) recomputes PPV = 27/37 = 0.73 and sensitivity = 27/27 = 1.00,
// emitting two results carrying stats:ge(stats:ppv(s), 0.7) and
// stats:ge(stats:sensitivity(s), 0.9). A declared bridge composes both into
// onco:StrongBiomarker. Thresholds 0.7 / 0.9 are the "strong biomarker"
// criterion (comparable to KRAS/BRAF dependency biomarkers; paper Ext Data 1d,e).

resource wrn:biomarker_plan : stats:ClassificationAnalysisPlan {
    stats:sample_set               = wrn:wrn_dep_sampleset;
    stats:classification_threshold = -0.5;
    stats:min_ppv                  = 0.7;
    stats:min_sensitivity          = 0.9;
}

resource wrn:biomarker_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:biomarker_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:bridge_biomarker : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:biomarker-criterion";
    reflection:rationale   = "If MSI status predicts WRN dependency with PPV >= 0.7 AND sensitivity >= 0.9 (at the dependency < -0.5 threshold), MSI is a strong biomarker for WRN dependency — a predictive relationship comparable to established oncogene dependency biomarkers (KRAS/BRAF). The two classifier-quality facts are the warrant.";

    reflection:canonical_proposition = type_expr(
        stats:ge(stats:ppv("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.7)
        ->
        stats:ge(stats:sensitivity("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.9)
        ->
        onco:StrongBiomarker("MSI", "WRN_dependency")
    );
}

resource wrn:bridge_biomarker_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_biomarker;
    reflection:declared_by = "wrn-paper:biomarker-criterion";
    reflection:timestamp   = "2026-06-12T15:00:00Z";
}

resource wrn:concl_biomarker_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    reasoning:proposition = type_expr(
        onco:StrongBiomarker("MSI", "WRN_dependency")
    );

    reasoning:justification = App(
        App(
            DeclaredEvidence("urn:eigenius:pub:wrn:bridge_biomarker"),
            DerivedEvidence("urn:eigenius:pub:wrn:biomarker_plan:result:ppv")
        ),
        DerivedEvidence("urn:eigenius:pub:wrn:biomarker_plan:result:sensitivity")
    );

    reasoning:certificate = type_expr(
        alias
            SS      = "urn:eigenius:pub:wrn:wrn_dep_sampleset",
            BRIDGE  = "urn:eigenius:pub:wrn:bridge_biomarker",
            R_PPV   = "urn:eigenius:pub:wrn:biomarker_plan:result:ppv",
            R_SENS  = "urn:eigenius:pub:wrn:biomarker_plan:result:sensitivity",
            PPVP    = stats:ge(stats:ppv(SS), 0.7),
            SENSP   = stats:ge(stats:sensitivity(SS), 0.9),
            SB      = onco:StrongBiomarker("MSI", "WRN_dependency"),
            bridge_cert = declared(BRIDGE, PPVP -> SENSP -> SB),
            cert1 = app(PPVP, SENSP -> SB, DeclaredEvidence(BRIDGE), DerivedEvidence(R_PPV), bridge_cert, derived(R_PPV, PPVP))
        in
        app(SENSP, SB, reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_PPV)), DerivedEvidence(R_SENS), cert1, derived(R_SENS, SENSP))
    );
}

// ════════════════════════════════════════════════════════════════════
// C-MECH (recomputed sub-warrant): p53 status modulates WRN dependence
// ════════════════════════════════════════════════════════════════════
// The mechanism phase rests largely on linked-external wet-lab readouts
// (DSB foci, GSEA, IF), but one sub-claim IS recomputable from the pinned
// slice: WRN dependence is stronger in p53-intact than p53-impaired MSI
// lines (paper: P = 0.02, n = 23 vs 13, common-MSI lineages). Group A =
// p53-intact (TP53_proficient, more dependent), Group B = p53-impaired
// (TP53_null). One-sided in the stated direction (intact more dependent;
// paper two-sided P = 0.02 ⇒ one-sided ~0.01). Lifts to the domain claim
// that p53 status MODULATES (contributes to, not solely determines) WRN
// dependence — the "p53 contributes" half of C-MECH's p53 dissection.

resource wrn:p53_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:p53-contribution-directionality";
    reflection:rationale   = "The mechanistic hypothesis is that WRN loss activates p53, so p53-proficient MSI cells are predicted MORE dependent on WRN than p53-impaired ones. That directional prediction (intact more dependent) is the claim under test; the inverse is not, licensing the one-sided p-value (paper reports two-sided P = 0.02; one-sided ~0.01).";
}

resource wrn:p53_dep_sampleset : stats:SampleSetResource {
    reflection:source      = "depmap:18Q4 avg WRN dependency, common-MSI MSI lines by TP53 status (Supp Table 1)";
    reflection:observed_at = "2019-01-01T00:00:00Z";

    // Tier-1 extraction pin (verified by extract/extract_samplesets.py).
    bench:extracted_from_slice  = "data/slices/wrn_supplementary_table_1.csv";
    bench:extracted_from_sha256 = "eebd460257982a98cf6ce9f14e189ae0c4398a686f4181bc037c5591e87243f2";
    bench:extraction_columns    = "avg_WRN_dep,TP53_status";
    bench:extraction_filter     = "common_MSI_lineage=1 & CCLE_MSI=MSI & avg_WRN_dep real; group A=TP53_proficient (n=23), B=TP53_null (n=13); each sorted ascending (the 1 NA-TP53 line of the 37 dropped)";
    bench:extraction_recipe     = "extract/extract_samplesets.py#wrn:p53_dep_sampleset";

    stats:sample_set_value = stats:IID(
        [-2.225778, -1.826026, -1.801462, -1.775366, -1.570166, -1.505872, -1.492430, -1.477463,
         -1.274070, -1.184914, -1.096147, -1.047139, -0.993197, -0.910127, -0.830779, -0.810157,
         -0.770493, -0.744374, -0.677736, -0.674509, -0.520890, -0.415037, -0.012400],
        [-2.623081, -2.056004, -1.344363, -0.738790, -0.697405, -0.618785, -0.395224, -0.347907,
         -0.236841, -0.209223, -0.199727, -0.145768, 0.020318],
        BiologicalReplication(),
    );
}

resource wrn:p53_dep_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:p53_dep_sampleset;
    reflection:source    = "depmap:18Q4 (Supp Table 1)";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:p53_dep_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set = wrn:p53_dep_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "dependency_score");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:p53_directionality_witness");
    stats:variance_assumption = RankBased();
    stats:outlier_exclusion   = Identity();
}

resource wrn:p53_dep_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:p53_dep_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:bridge_p53_modulates : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:p53-contribution-criterion";
    reflection:rationale   = "If WRN dependence differs by p53 status across MSI lines (p53-intact mean strictly below p53-impaired — more dependent), then p53 status modulates WRN dependence: it contributes to, but does not solely determine, the dependence (both strata remain dependent; DSBs are toxic independent of p53).";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:p53_dep_sampleset"), 0.0)
        ->
        onco:ModulatesDependence("TP53", "WRN")
    );
}

resource wrn:bridge_p53_modulates_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_p53_modulates;
    reflection:declared_by = "wrn-paper:p53-contribution-criterion";
    reflection:timestamp   = "2026-06-13T03:00:00Z";
}

resource wrn:concl_p53_modulates : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    reasoning:proposition = type_expr(
        onco:ModulatesDependence("TP53", "WRN")
    );

    reasoning:justification = App(
        DeclaredEvidence("urn:eigenius:pub:wrn:bridge_p53_modulates"),
        DerivedEvidence("urn:eigenius:pub:wrn:p53_dep_plan:result:main_effect")
    );

    reasoning:certificate = type_expr(
        alias
            SS     = "urn:eigenius:pub:wrn:p53_dep_sampleset",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_p53_modulates",
            RESULT = "urn:eigenius:pub:wrn:p53_dep_plan:result:main_effect",
            STAT   = stats:lt(stats:mean_diff_of(SS), 0.0),
            MD     = onco:ModulatesDependence("TP53", "WRN")
        in
        app(
            STAT, MD,
            DeclaredEvidence(BRIDGE), DerivedEvidence(RESULT),
            declared(BRIDGE, STAT -> MD),
            derived(RESULT, STAT)
        )
    );
}
