resource wrn:wrn_dep_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:wrn_dep_sampleset;
    reflection:source    = "depmap:18Q4 (Supp Table 1)";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

// ─── The StatisticalAnalysisPlan (institution recomputes it) ──────────
// RankBased → Wilcoxon rank-sum; OneSidedWitnessed → directional lt.
// On commit the statistics institution emits
//   wrn:wrn_dep_plan:result:main_effect
// carrying canonical_proposition = stats:lt(stats:mean_diff_of(sampleset), 0)
// and an IsDerivedAs witness against it.

resource wrn:wrn_dep_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set = wrn:wrn_dep_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "dependency_score");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:msi_directionality_witness");
    stats:variance_assumption = RankBased();
    stats:outlier_exclusion   = Identity();
}

resource wrn:wrn_dep_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:wrn_dep_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

// ─── Declared: the statistical→domain bridge ─────────────────────────
// Lifts the recomputed statistical claim into the domain conclusion.
// Monomorphic (specialised to this sample set + WRN/MSI), mirroring the
// drug_screening.esl bridge.

resource wrn:bridge_msi_selective : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:selective-essentiality-criterion";
    reflection:rationale   = "If a sample set measuring WRN dependency by MSI status has its MSI-group mean strictly below its MSS-group mean (MSI more dependent), WRN is selectively essential in MSI. The directional statistical claim is the warrant.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.0)
        ->
        onco:SelectivelyEssential("WRN", "MSI")
    );
}

resource wrn:bridge_msi_selective_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_msi_selective;
    reflection:declared_by = "wrn-paper:selective-essentiality-criterion";
    reflection:timestamp   = "2026-06-12T14:00:00Z";
}

// ─── C-WRN (recomputed): SelectivelyEssential(WRN, MSI) ──────────────
// Justified by the bridge applied to the institution-recomputed result.

resource wrn:concl_wrn_selective_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    reasoning:proposition = type_expr(
        onco:SelectivelyEssential("WRN", "MSI")
    );

    reasoning:justification = App(
        DeclaredEvidence("urn:eigenius:pub:wrn:bridge_msi_selective"),
        DerivedEvidence("urn:eigenius:pub:wrn:wrn_dep_plan:result:main_effect")
    );

    reasoning:certificate = type_expr(
        alias
            SS     = "urn:eigenius:pub:wrn:wrn_dep_sampleset",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_msi_selective",
            RESULT = "urn:eigenius:pub:wrn:wrn_dep_plan:result:main_effect",
            STAT   = stats:lt(stats:mean_diff_of(SS), 0.0),
            SE     = onco:SelectivelyEssential("WRN", "MSI")
        in
        app(
            STAT, SE,
            DeclaredEvidence(BRIDGE), DerivedEvidence(RESULT),
            declared(BRIDGE, STAT -> SE),
            derived(RESULT, STAT)
        )
    );
}

// ════════════════════════════════════════════════════════════════════
// D-REFINE (recomputed): WRN dependency tracks mutator load
// ════════════════════════════════════════════════════════════════════
// The Spearman correlation between #MS-deletions and WRN dependency
// across the 51 MSI cell lines (rho = -0.74, the corrected n = 51 —
// finding F1), kernel-recomputed. Same two-institution pattern: the
// statistics institution recomputes the correlation and emits the
// IsDerivedAs witness; the reasoning institution composes it through a
// bridge into onco:DependencyCorrelatesWithMutatorLoad(WRN, MSI).
// Pairs: (x = ms_deletions_normed, y = avg_WRN_dep).

resource wrn:mutator_load_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:mutator-load-directionality";
    reflection:rationale   = "The hypothesis is that accumulating MSI deletions increase WRN dependence — a negative correlation between #MS-deletions and WRN dependency score (more deletions ⇒ more negative ⇒ more dependent). The inverse direction is not the claim, licensing the one-sided test.";
}

