resource wrn:wrn_corr_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:wrn_corr_sampleset;
    reflection:source    = "depmap:18Q4 (Supp Table 1)";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:wrn_corr_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set = wrn:wrn_corr_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "spearman_rho");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:mutator_load_directionality_witness");
    stats:variance_assumption = RankBased();
    stats:outlier_exclusion   = Identity();
}

resource wrn:wrn_corr_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:wrn_corr_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:bridge_mutator_load : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:mutator-load-criterion";
    reflection:rationale   = "If WRN dependency negatively correlates with mutator load (#MS deletions) across MSI lines, WRN dependency tracks mutator load — supporting the refinement that a stronger mutator phenotype drives WRN dependence.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:spearman_rho("urn:eigenius:pub:wrn:wrn_corr_sampleset"), 0.0)
        ->
        onco:DependencyCorrelatesWithMutatorLoad("WRN", "MSI")
    );
}

resource wrn:bridge_mutator_load_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_mutator_load;
    reflection:declared_by = "wrn-paper:mutator-load-criterion";
    reflection:timestamp   = "2026-06-12T14:30:00Z";
}

resource wrn:concl_refine_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    reasoning:proposition = type_expr(
        onco:DependencyCorrelatesWithMutatorLoad("WRN", "MSI")
    );

    reasoning:justification = App(
        DeclaredEvidence("urn:eigenius:pub:wrn:bridge_mutator_load"),
        DerivedEvidence("urn:eigenius:pub:wrn:wrn_corr_plan:result:main_effect")
    );

    reasoning:certificate = type_expr(
        alias
            SS     = "urn:eigenius:pub:wrn:wrn_corr_sampleset",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_mutator_load",
            RESULT = "urn:eigenius:pub:wrn:wrn_corr_plan:result:main_effect",
            STAT   = stats:lt(stats:spearman_rho(SS), 0.0),
            DC     = onco:DependencyCorrelatesWithMutatorLoad("WRN", "MSI")
        in
        app(
            STAT, DC,
            DeclaredEvidence(BRIDGE), DerivedEvidence(RESULT),
            declared(BRIDGE, STAT -> DC),
            derived(RESULT, STAT)
        )
    );
}

// ════════════════════════════════════════════════════════════════════
// D-RECQ (recomputed): WRN is the only MSI-selective RecQ helicase
// ════════════════════════════════════════════════════════════════════
// The RecQ-family comparison (Achilles CRISPR-CERES, all lineages, the
// recorded artifact's cohort: 32 MSI / 413 MSS). The kernel
// recomputes WRN's MSI-vs-MSS Wilcoxon here (P = 1.1e-8, median -0.49 vs
// -0.11) and lifts it to the family-uniqueness claim through a Declared
// rule. The other three RecQ helicases (BLM P=0.65, RECQL P=0.58,
// RECQL5 P=0.11) are NON-significant and RECQL4 is absent from the 18Q4
// CERES matrix — their non-selectivity is a Declared scientific judgment,
// NOT a derived warrant: a null cannot be derived (you cannot prove "no
// effect" from "failed to find an effect"). So uniqueness composes one
// kernel-derived positive (WRN selective) with the declared interpretation
// of the three kernel-computed n.s. p-values cited in the rule's rationale.

