                       observed("urn:eigenius:ingest:file:d8da9e9535f0f863e8ca541c63982804fa1e0fb9e9a9d3d721650c08ef625f95", core:Asserts("urn:eigenius:ingest:file:d8da9e9535f0f863e8ca541c63982804fa1e0fb9e9a9d3d721650c08ef625f95"))),
