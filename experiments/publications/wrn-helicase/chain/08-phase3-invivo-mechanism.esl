            c_apoptosis_re_3_OBSP_1 = core:Asserts("urn:eigenius:pub:wrn:apop_SW48_sampleset"),
            c_apoptosis_re_3_js_1 = justification:App(Declared(c_apoptosis_re_3_CLAIM_1), Observed("urn:eigenius:pub:wrn:apop_SW48_sampleset")),
            c_apoptosis_re_3_cs_1 = app(c_apoptosis_re_3_OBSP_1, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_SW48_sampleset"), 0.0), Declared(c_apoptosis_re_3_CLAIM_1), Observed("urn:eigenius:pub:wrn:apop_SW48_sampleset"),
                        declared(c_apoptosis_re_3_CLAIM_1, c_apoptosis_re_3_OBSP_1 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_SW48_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:apop_SW48_sampleset", c_apoptosis_re_3_OBSP_1)),
            c_apoptosis_re_3_CLAIM_2 = "urn:eigenius:pub:wrn:apop_OVK18_plan_yields_main_effect",
            c_apoptosis_re_3_OBSP_2 = core:Asserts("urn:eigenius:pub:wrn:apop_OVK18_sampleset"),
            c_apoptosis_re_3_js_2 = justification:App(Declared(c_apoptosis_re_3_CLAIM_2), Observed("urn:eigenius:pub:wrn:apop_OVK18_sampleset")),
            c_apoptosis_re_3_cs_2 = app(c_apoptosis_re_3_OBSP_2, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_OVK18_sampleset"), 0.0), Declared(c_apoptosis_re_3_CLAIM_2), Observed("urn:eigenius:pub:wrn:apop_OVK18_sampleset"),
                        declared(c_apoptosis_re_3_CLAIM_2, c_apoptosis_re_3_OBSP_2 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_OVK18_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:apop_OVK18_sampleset", c_apoptosis_re_3_OBSP_2)),
            c_apoptosis_re_3_BRIDGE = "urn:eigenius:pub:wrn:bridge_apoptosis",
            c_apoptosis_re_3_R_K = "urn:eigenius:pub:wrn:apop_KM12_plan:result:main_effect",
            c_apoptosis_re_3_R_S = "urn:eigenius:pub:wrn:apop_SW48_plan:result:main_effect",
            c_apoptosis_re_3_R_O = "urn:eigenius:pub:wrn:apop_OVK18_plan:result:main_effect",
            c_apoptosis_re_3_K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_KM12_sampleset"), 0.0),
            c_apoptosis_re_3_S = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_SW48_sampleset"), 0.0),
            c_apoptosis_re_3_O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_OVK18_sampleset"), 0.0),
            c_apoptosis_re_3_CA = onco:CausesApoptosis("WRN", "MSI"),
            c_apoptosis_re_3_RULE_P = c_apoptosis_re_3_K -> c_apoptosis_re_3_S -> c_apoptosis_re_3_O -> c_apoptosis_re_3_CA,
            c_apoptosis_re_3_cert1 = app(c_apoptosis_re_3_K, c_apoptosis_re_3_S -> c_apoptosis_re_3_O -> c_apoptosis_re_3_CA, Declared(c_apoptosis_re_3_BRIDGE), c_apoptosis_re_3_js_0,
                        declared(c_apoptosis_re_3_BRIDGE, c_apoptosis_re_3_RULE_P), c_apoptosis_re_3_cs_0),
            c_apoptosis_re_3_cert2 = app(c_apoptosis_re_3_S, c_apoptosis_re_3_O -> c_apoptosis_re_3_CA, justification:App(Declared(c_apoptosis_re_3_BRIDGE), c_apoptosis_re_3_js_0),
                        c_apoptosis_re_3_js_1, c_apoptosis_re_3_cert1, c_apoptosis_re_3_cs_1),
            RULE = "urn:eigenius:pub:wrn:mech_rule",
            ART  = "urn:eigenius:pub:wrn:mech_dsb",
            CC   = "urn:eigenius:pub:wrn:concl_cellcycle_recomputed",
            AP   = "urn:eigenius:pub:wrn:concl_apoptosis_recomputed",
            DSB  = onco:CausesDSBs("WRN", "MSI"),
            CA   = onco:CausesCellCycleArrest("WRN", "MSI"),
            AA   = onco:CausesApoptosis("WRN", "MSI"),
            DL   = onco:DSBDrivenLethality("WRN", "MSI"),
            RULE_P = DSB -> CA -> AA -> DL,
            jDSB = Declared(ART),
            jCA  = justification:App(
                       justification:App(
                           justification:App(
                               Declared("urn:eigenius:pub:wrn:bridge_cellcycle"),
                               c_cellcycle_re_0_js_0
                           ),
                           c_cellcycle_re_0_js_1
                       ),
                       c_cellcycle_re_0_js_2
                   ),
            jAA  = justification:App(
                       justification:App(
                           justification:App(
                               Declared("urn:eigenius:pub:wrn:bridge_apoptosis"),
                               c_apoptosis_re_1_js_0
                           ),
                           c_apoptosis_re_1_js_1
                       ),
                       c_apoptosis_re_1_js_2
                   ),
            cert1 = app(DSB, CA -> AA -> DL, Declared(RULE), jDSB,
                        declared(RULE, RULE_P), declared(ART, DSB)),
            cert2 = app(CA, AA -> DL, justification:App(Declared(RULE), jDSB),
                        jCA, cert1, app(c_cellcycle_re_0_O, c_cellcycle_re_0_CA, justification:App(justification:App(Declared(c_cellcycle_re_0_BRIDGE), c_cellcycle_re_0_js_0), c_cellcycle_re_0_js_1),
               c_cellcycle_re_0_js_2, c_cellcycle_re_0_cert2, c_cellcycle_re_0_cs_2))
        in
        holds( eigentt:logic_kernel,
               app(AA, DL, justification:App(justification:App(Declared(RULE), jDSB), jCA),
               jAA, cert2, app(c_apoptosis_re_1_O, c_apoptosis_re_1_CA, justification:App(justification:App(Declared(c_apoptosis_re_1_BRIDGE), c_apoptosis_re_1_js_0), c_apoptosis_re_1_js_1),
               c_apoptosis_re_1_js_2, c_apoptosis_re_1_cert2, c_apoptosis_re_1_cs_2)),
               justification:Certificate(
                   justification:App(
                       justification:App(
                           justification:App(
                               Declared("urn:eigenius:pub:wrn:mech_rule"),
                               Declared("urn:eigenius:pub:wrn:mech_dsb")
                           ),
                           justification:App(
                       justification:App(
                           justification:App(
                               Declared("urn:eigenius:pub:wrn:bridge_cellcycle"),
                               c_cellcycle_re_2_js_0
                           ),
                           c_cellcycle_re_2_js_1
                       ),
                       c_cellcycle_re_2_js_2
                   )
                       ),
                       justification:App(
                       justification:App(
                           justification:App(
                               Declared("urn:eigenius:pub:wrn:bridge_apoptosis"),
                               c_apoptosis_re_3_js_0
                           ),
                           c_apoptosis_re_3_js_1
                       ),
                       c_apoptosis_re_3_js_2
                   )
                   ),
                   onco:DSBDrivenLethality("WRN", "MSI") ) )
    );
}

// ── Telomere-defect hypothesis: tested and REJECTED ──────────────────
// Linked-external: telomere-FISH of metaphase spreads (2 MSI, 2 MSS) 96 h
// after shWRN1 induction directly showed diffuse chromosomal DSBs WITHOUT
// telomeric end-to-end fusions or signal loss — ruling out a telomere defect
// as the basis of the synthetic lethality.
resource wrn:fish_readout : bench:ToolArtifact {
    prov:was_attributed_to = wrn:authors;
    bench:tool            = "telomere PNA-FISH of metaphase spreads (± shWRN1)";
    bench:produced_from   = ["wrn-paper:Fig-4d", "wrn-paper:Fig-4e", "wrn-paper:ED-Fig-8a"];
    bench:tool_parameters = "WRN silencing induced DSB/fragmentation throughout chromosomes in MSI but not MSS cells, with NO specific telomeric defects (no increased end-to-end fusions, no telomeric signal loss). The synthetic lethality is not via a telomere defect — an explicitly tested-and-rejected hypothesis. LINKED-EXTERNAL.";
    // The artifact links to what produced it through the ACTIVITY. It used
    // `prov:derivation`, which is class_typed at prov:ProductionTrace and so
    // could not name the DeclarationTrace a transcription carries — the
    // linkability problem reflection:ExternalExecutionTrace was invented to
    // dodge. `prov:was_generated_by` is uniform across a kernel run and a
    // transcribed one, and the trace still points back through prov:resource.
    prov:was_generated_by = wrnact:ed_fig_8a;
    reflection:canonical_proposition = type_expr(
        onco:NotViaTelomereDefect("WRN", "MSI")
    );
}
resource wrn:fish_readout_trace : prov:DeclarationTrace {
    prov:was_attributed_to = wrn:authors;
    prov:resource  = wrn:fish_readout;
    prov:was_generated_by    = wrnact:ed_fig_8a;
    prov:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:concl_not_telomere : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";
    justification:judgement = type_expr(
        holds( eigentt:logic_kernel,
               declared("urn:eigenius:pub:wrn:fish_readout",
               onco:NotViaTelomereDefect("WRN", "MSI")),
               justification:Certificate(
                   Declared("urn:eigenius:pub:wrn:fish_readout"),
                   onco:NotViaTelomereDefect("WRN", "MSI") ) )
    );
}

