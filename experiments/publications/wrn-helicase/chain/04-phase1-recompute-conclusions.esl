resource wrn:concl_val_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";
    reasoning:proposition = type_expr(
        onco:SelectiveViabilityDependence("WRN", "MSI")
    );
    reasoning:justification = App(
        App(
            DeclaredEvidence("urn:eigenius:pub:wrn:bridge_viability"),
            DerivedEvidence("urn:eigenius:pub:wrn:viab_KM12_plan:result:main_effect")
        ),
        DerivedEvidence("urn:eigenius:pub:wrn:viab_OVK18_plan:result:main_effect")
    );
    reasoning:certificate = type_expr(
        alias
            BRIDGE = "urn:eigenius:pub:wrn:bridge_viability",
            R_KM12 = "urn:eigenius:pub:wrn:viab_KM12_plan:result:main_effect",
            R_OVK  = "urn:eigenius:pub:wrn:viab_OVK18_plan:result:main_effect",
            K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_KM12_sampleset"), 0.0),
            O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_OVK18_sampleset"), 0.0),
            SVD = onco:SelectiveViabilityDependence("WRN", "MSI"),
            cert1 = app(K, O -> SVD, DeclaredEvidence(BRIDGE), DerivedEvidence(R_KM12),
                        declared(BRIDGE, K -> O -> SVD), derived(R_KM12, K))
        in
        app(O, SVD, reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_KM12)),
            DerivedEvidence(R_OVK), cert1, derived(R_OVK, O))
    );
}

resource wrn:concl_cellcycle_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";
    reasoning:proposition = type_expr(
        onco:CausesCellCycleArrest("WRN", "MSI")
    );
    reasoning:justification = App(
        App(
            App(
                DeclaredEvidence("urn:eigenius:pub:wrn:bridge_cellcycle"),
                DerivedEvidence("urn:eigenius:pub:wrn:cc_KM12_plan:result:main_effect")
            ),
            DerivedEvidence("urn:eigenius:pub:wrn:cc_SW48_plan:result:main_effect")
        ),
        DerivedEvidence("urn:eigenius:pub:wrn:cc_OVK18_plan:result:main_effect")
    );
    reasoning:certificate = type_expr(
        alias
            BRIDGE = "urn:eigenius:pub:wrn:bridge_cellcycle",
            R_K = "urn:eigenius:pub:wrn:cc_KM12_plan:result:main_effect",
            R_S = "urn:eigenius:pub:wrn:cc_SW48_plan:result:main_effect",
            R_O = "urn:eigenius:pub:wrn:cc_OVK18_plan:result:main_effect",
            K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:cc_KM12_sampleset"), 0.0),
            S = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:cc_SW48_sampleset"), 0.0),
            O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:cc_OVK18_sampleset"), 0.0),
            CA = onco:CausesCellCycleArrest("WRN", "MSI"),
            RULE_P = K -> S -> O -> CA,
            cert1 = app(K, S -> O -> CA, DeclaredEvidence(BRIDGE), DerivedEvidence(R_K),
                        declared(BRIDGE, RULE_P), derived(R_K, K)),
            cert2 = app(S, O -> CA, reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_K)),
                        DerivedEvidence(R_S), cert1, derived(R_S, S))
        in
        app(O, CA, reasoning:App(reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_K)), DerivedEvidence(R_S)),
            DerivedEvidence(R_O), cert2, derived(R_O, O))
    );
}

