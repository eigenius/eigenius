resource wrn:concl_mmr_restoration_recomputed : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";
    reasoning:proposition = type_expr(
        onco:RestorationPartiallyRescues("dMMR", "WRN")
    );
    reasoning:justification = App(
        App(
            App(
                DeclaredEvidence("urn:eigenius:pub:wrn:bridge_mmr_restoration"),
                DerivedEvidence("urn:eigenius:pub:wrn:mmr_rescue_plan:result:main_effect")
            ),
            DerivedEvidence("urn:eigenius:pub:wrn:mmr_resens1_plan:result:main_effect")
        ),
        DerivedEvidence("urn:eigenius:pub:wrn:mmr_resens2_plan:result:main_effect")
    );
    reasoning:certificate = type_expr(
        alias
            BRIDGE = "urn:eigenius:pub:wrn:bridge_mmr_restoration",
            R_R = "urn:eigenius:pub:wrn:mmr_rescue_plan:result:main_effect",
            R_1 = "urn:eigenius:pub:wrn:mmr_resens1_plan:result:main_effect",
            R_2 = "urn:eigenius:pub:wrn:mmr_resens2_plan:result:main_effect",
            K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_rescue_sampleset"), 0.0),
            S = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0),
            O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0),
            RP = onco:RestorationPartiallyRescues("dMMR", "WRN"),
            RULE_P = K -> S -> O -> RP,
            cert1 = app(K, S -> O -> RP, DeclaredEvidence(BRIDGE), DerivedEvidence(R_R),
                        declared(BRIDGE, RULE_P), derived(R_R, K)),
            cert2 = app(S, O -> RP, reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_R)),
                        DerivedEvidence(R_1), cert1, derived(R_1, S))
        in
        app(O, RP, reasoning:App(reasoning:App(DeclaredEvidence(BRIDGE), DerivedEvidence(R_R)), DerivedEvidence(R_1)),
            DerivedEvidence(R_2), cert2, derived(R_2, O))
    );
}
