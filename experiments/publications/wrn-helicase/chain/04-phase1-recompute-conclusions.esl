// WRN Phase-1 recompute — CONCLUSIONS layer (consumers).
// The concl_*_recomputed ReasoningSentences. Each AutoOnLoad-gates on
// qc_validate_justification, citing the IsDerivedAs/IsDeclaredAs witnesses
// committed by wrn-phase1-recompute-plans.esl — load that FIRST.
//
// (Was wrn-phase1-recompute.esl; split for live two-phase loading.)
// WRN Phase-1 — institution-recomputed statistical warrants.
//
// The kernel-recomputed layer of the WRN Phase-1 chain: the statistics
// institution RECOMPUTES every headline statistic from chain-resident
// data (the pinned public-data snapshot, inlined as SampleSets) and emits
// StatisticalAnalysisResults whose IsDerivedAs the reasoning certificates
// consume. Declared statistical→domain bridges lift each statistical claim
// to its domain conclusion. This replaces the recorded bench:ToolArtifacts
// (agent-attested) of the narrative layer (wrn-phase1.esl, which stacks on
// top of this one) for the institution-recomputable tier (D50 §2.2):
//
//   C-WRN     SelectivelyEssential(WRN, MSI)                — Wilcoxon (37 vs 91)
//   D-REFINE  DependencyCorrelatesWithMutatorLoad(WRN, MSI) — Spearman (51 pairs)
//   D-RECQ    OnlyMSISelectiveInFamily(WRN, RecQ_helicases) — Wilcoxon (32 vs 413)
//                                                             + declared uniqueness
//   D-BIOM    StrongBiomarker(MSI, WRN_dependency)          — PPV/sensitivity classifier
//
// Only the limma moderated-t differential-dependency (D-DIFF) stays a
// linked-external bench:ToolArtifact in the narrative layer (Phase 2.5).
//
// Two institutions compose through the shared chain (the stats-and-
// reasoning.json pattern): statistics writes the IsDerivedAs witness;
// reasoning reads it. The result resource is emitted by the statistics
// institution at commit and added to the chain by the test
// (crates/eigenius-reasoning/tests/wrn_phase1_recompute.rs).
//
// Directionality: the SampleSet places MSI first (group_a), so
// mean_diff_of(s) = mean(MSI) − mean(MSS); the OneSidedWitnessed test
// (licensed by the synthetic-lethal directionality witness below) yields
// stats:lt(mean_diff_of(s), 0) — MSI strictly more WRN-dependent.

namespace core          = "urn:eigenius:core";
namespace formats       = "urn:eigenius:core:formats";
namespace reflection    = "urn:eigenius:reflection";
namespace stats         = "urn:eigenius:measurements";
namespace eigentt       = "urn:eigenius:eigentt";
namespace onco          = "urn:eigenius:benchmark:onco";
namespace bench         = "urn:eigenius:benchmark";
namespace wrn           = "urn:eigenius:pub:wrn";
namespace justification = "urn:eigenius:justification";

// ─── Directionality witness (D52 §7.1) ───────────────────────────────
// Licenses the one-sided test: the synthetic-lethal hypothesis is
// specifically that MSI cells are MORE WRN-dependent; the inverse
// direction (MSS more dependent) is not the biological claim under test.



// ─── C-WRN (recomputed): SelectivelyEssential(WRN, MSI) ──────────────
// Justified by the bridge applied to the institution-recomputed result.

resource wrn:concl_wrn_selective_recomputed : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    justification:judgement = type_expr(
        alias
            CLAIM = "urn:eigenius:pub:wrn:wrn_dep_plan_yields_main_effect",
            OBSP  = core:Asserts("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
            js    = justification:App(Declared(CLAIM), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset")),
            cs    = app(OBSP, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.0), Declared(CLAIM), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
                        declared(CLAIM, OBSP -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:wrn_dep_sampleset", OBSP)),
            SS     = "urn:eigenius:pub:wrn:wrn_dep_sampleset",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_msi_selective",
            RESULT = "urn:eigenius:pub:wrn:wrn_dep_plan:result:main_effect",
            STAT   = stats:lt(stats:mean_diff_of(SS), 0.0),
            SE     = onco:SelectivelyEssential("WRN", "MSI")
        in
        holds( eigentt:logic_kernel,
               app(
                   STAT, SE,
                   Declared(BRIDGE), js,
                   declared(BRIDGE, STAT -> SE),
                   cs
               ),
               justification:Certificate(
                   justification:App(
                       Declared("urn:eigenius:pub:wrn:bridge_msi_selective"),
                       js
                   ),
                   onco:SelectivelyEssential("WRN", "MSI") ) )
    );


}

resource wrn:concl_refine_recomputed : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    // P4 shape: the statistic is no longer a `DerivedEvidence` leaf citing the
    // institution's result by IRI. It is the APPLICATION of a declared plan to
    // an observed sample set — `App(Declared(plan), Observed(input))` — which is
    // what a computed conclusion actually rests on.
    //
    // The declaration is bound to THIS hash-pinned sample set, not universally
    // quantified over sample sets. A universal would have the team asserting
    // that any recorded set yields a negative rho, which is false; what is
    // assertable, and what reproducibility means for immutable data, is that
    // this exact input yields this result.
    justification:judgement = type_expr(
        alias
            SS     = "urn:eigenius:pub:wrn:wrn_corr_sampleset",
            CLAIM  = "urn:eigenius:pub:wrn:wrn_corr_plan_yields_main_effect",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_mutator_load",

            OBS    = core:Asserts(SS),
            STAT   = stats:lt(stats:spearman_rho(SS), 0.0),
            DC     = onco:DependencyCorrelatesWithMutatorLoad("WRN", "MSI"),

            js     = justification:App(Declared(CLAIM), Observed(SS)),
            cs     = app(OBS, STAT, Declared(CLAIM), Observed(SS),
                         declared(CLAIM, OBS -> STAT), observed(SS, OBS))
        in
        holds( eigentt:logic_kernel,
               app(STAT, DC, Declared(BRIDGE), js,
                   declared(BRIDGE, STAT -> DC), cs),
               justification:Certificate(
                   justification:App(Declared(BRIDGE), js),
                   DC ) )
    );
}


// ─── D-LINEAGE (recomputed, ED Fig 2b): common MSI lineages carry a higher
// mutator load than uncommon ones — the basis for the biomarker's lineage
// restriction. Two-sample Wilcoxon (mean_diff_of, group A uncommon below
// group B common), lifted through bridge_lineage_mutator.
resource wrn:concl_lineage_mutator_recomputed : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    justification:judgement = type_expr(
        alias
            CLAIM = "urn:eigenius:pub:wrn:mutator_load_plan_yields_main_effect",
            OBSP  = core:Asserts("urn:eigenius:pub:wrn:mutator_load_sampleset"),
            js    = justification:App(Declared(CLAIM), Observed("urn:eigenius:pub:wrn:mutator_load_sampleset")),
            cs    = app(OBSP, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mutator_load_sampleset"), 0.0), Declared(CLAIM), Observed("urn:eigenius:pub:wrn:mutator_load_sampleset"),
                        declared(CLAIM, OBSP -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mutator_load_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:mutator_load_sampleset", OBSP)),
            SS     = "urn:eigenius:pub:wrn:mutator_load_sampleset",
            BRIDGE = "urn:eigenius:pub:wrn:bridge_lineage_mutator",
            RESULT = "urn:eigenius:pub:wrn:mutator_load_plan:result:main_effect",
            STAT   = stats:lt(stats:mean_diff_of(SS), 0.0),
            EM     = onco:ElevatedMutatorLoadInCommonLineages("MSI_common", "MSI_uncommon")
        in
        holds( eigentt:logic_kernel,
               app(
                   STAT, EM,
                   Declared(BRIDGE), js,
                   declared(BRIDGE, STAT -> EM),
                   cs
               ),
               justification:Certificate(
                   justification:App(
                       Declared("urn:eigenius:pub:wrn:bridge_lineage_mutator"),
                       js
                   ),
                   onco:ElevatedMutatorLoadInCommonLineages("MSI_common", "MSI_uncommon") ) )
    );


}

