resource wrn:concl_biomarker_recomputed : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    justification:judgement = type_expr(
        alias
            CLAIM_0 = "urn:eigenius:pub:wrn:biomarker_plan_yields_ppv",
            OBSP_0  = core:Asserts("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
            js_0    = justification:App(Declared(CLAIM_0), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset")),
            cs_0    = app(OBSP_0, stats:ge(stats:ppv("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.7), Declared(CLAIM_0), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
                        declared(CLAIM_0, OBSP_0 -> stats:ge(stats:ppv("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.7)), observed("urn:eigenius:pub:wrn:wrn_dep_sampleset", OBSP_0)),
            CLAIM_1 = "urn:eigenius:pub:wrn:biomarker_plan_yields_sensitivity",
            OBSP_1  = core:Asserts("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
            js_1    = justification:App(Declared(CLAIM_1), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset")),
            cs_1    = app(OBSP_1, stats:ge(stats:sensitivity("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.9), Declared(CLAIM_1), Observed("urn:eigenius:pub:wrn:wrn_dep_sampleset"),
                        declared(CLAIM_1, OBSP_1 -> stats:ge(stats:sensitivity("urn:eigenius:pub:wrn:wrn_dep_sampleset"), 0.9)), observed("urn:eigenius:pub:wrn:wrn_dep_sampleset", OBSP_1)),
            SS      = "urn:eigenius:pub:wrn:wrn_dep_sampleset",
            BRIDGE  = "urn:eigenius:pub:wrn:bridge_biomarker",
            R_PPV   = "urn:eigenius:pub:wrn:biomarker_plan:result:ppv",
            R_SENS  = "urn:eigenius:pub:wrn:biomarker_plan:result:sensitivity",
            PPVP    = stats:ge(stats:ppv(SS), 0.7),
            SENSP   = stats:ge(stats:sensitivity(SS), 0.9),
            SB      = onco:StrongBiomarker("MSI", "WRN_dependency"),
            bridge_cert = declared(BRIDGE, PPVP -> SENSP -> SB),
            cert1 = app(PPVP, SENSP -> SB, Declared(BRIDGE), js_0, bridge_cert, cs_0)
        in
        holds( eigentt:logic_kernel,
               app(SENSP, SB, justification:App(Declared(BRIDGE), js_0), js_1, cert1, cs_1),
               justification:Certificate(
                   justification:App(
                       justification:App(
                           Declared("urn:eigenius:pub:wrn:bridge_biomarker"),
                           js_0
                       ),
                       js_1
                   ),
                   onco:StrongBiomarker("MSI", "WRN_dependency") ) )
    );


}

