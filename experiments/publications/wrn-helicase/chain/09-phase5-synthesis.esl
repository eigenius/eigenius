    justification:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";
    justification:judgement = type_expr(
        alias
            c_val_recomput_0_CLAIM_0 = "urn:eigenius:pub:wrn:viab_KM12_plan_yields_main_effect",
            c_val_recomput_0_OBSP_0 = core:Asserts("urn:eigenius:pub:wrn:viab_KM12_sampleset"),
            c_val_recomput_0_js_0 = justification:App(Declared(c_val_recomput_0_CLAIM_0), Observed("urn:eigenius:pub:wrn:viab_KM12_sampleset")),
            c_val_recomput_0_cs_0 = app(c_val_recomput_0_OBSP_0, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_KM12_sampleset"), 0.0), Declared(c_val_recomput_0_CLAIM_0), Observed("urn:eigenius:pub:wrn:viab_KM12_sampleset"),
                        declared(c_val_recomput_0_CLAIM_0, c_val_recomput_0_OBSP_0 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_KM12_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:viab_KM12_sampleset", c_val_recomput_0_OBSP_0)),
            c_val_recomput_0_CLAIM_1 = "urn:eigenius:pub:wrn:viab_OVK18_plan_yields_main_effect",
