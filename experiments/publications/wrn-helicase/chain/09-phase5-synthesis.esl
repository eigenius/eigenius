            c_mmr_restorat_0_cs_2 = app(c_mmr_restorat_0_OBSP_2, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0), Declared(c_mmr_restorat_0_CLAIM_2), Observed("urn:eigenius:pub:wrn:mmr_resens2_sampleset"),
                        declared(c_mmr_restorat_0_CLAIM_2, c_mmr_restorat_0_OBSP_2 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:mmr_resens2_sampleset", c_mmr_restorat_0_OBSP_2)),
            c_mmr_restorat_0_BRIDGE = "urn:eigenius:pub:wrn:bridge_mmr_restoration",
