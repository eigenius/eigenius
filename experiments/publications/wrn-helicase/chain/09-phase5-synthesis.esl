                        declared(c_mmr_restorat_1_CLAIM_2, c_mmr_restorat_1_OBSP_2 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:mmr_resens2_sampleset", c_mmr_restorat_1_OBSP_2)),
            c_mmr_restorat_1_BRIDGE = "urn:eigenius:pub:wrn:bridge_mmr_restoration",
            c_mmr_restorat_1_R_R = "urn:eigenius:pub:wrn:mmr_rescue_plan:result:main_effect",
            c_mmr_restorat_1_R_1 = "urn:eigenius:pub:wrn:mmr_resens1_plan:result:main_effect",
