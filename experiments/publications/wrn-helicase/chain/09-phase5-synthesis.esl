            c_mmr_restorat_0_R_2 = "urn:eigenius:pub:wrn:mmr_resens2_plan:result:main_effect",
            c_mmr_restorat_0_K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_rescue_sampleset"), 0.0),
            c_mmr_restorat_0_S = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0),
            c_mmr_restorat_0_O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0),
            c_mmr_restorat_0_RP = onco:RestorationPartiallyRescues("dMMR", "WRN"),
            c_mmr_restorat_0_RULE_P = c_mmr_restorat_0_K -> c_mmr_restorat_0_S -> c_mmr_restorat_0_O -> c_mmr_restorat_0_RP,
            c_mmr_restorat_0_cert1 = app(c_mmr_restorat_0_K, c_mmr_restorat_0_S -> c_mmr_restorat_0_O -> c_mmr_restorat_0_RP, Declared(c_mmr_restorat_0_BRIDGE), c_mmr_restorat_0_js_0,
                        declared(c_mmr_restorat_0_BRIDGE, c_mmr_restorat_0_RULE_P), c_mmr_restorat_0_cs_0),
            c_mmr_restorat_0_cert2 = app(c_mmr_restorat_0_S, c_mmr_restorat_0_O -> c_mmr_restorat_0_RP, justification:App(Declared(c_mmr_restorat_0_BRIDGE), c_mmr_restorat_0_js_0),
                        c_mmr_restorat_0_js_1, c_mmr_restorat_0_cert1, c_mmr_restorat_0_cs_1),
            c_mmr_restorat_1_CLAIM_0 = "urn:eigenius:pub:wrn:mmr_rescue_plan_yields_main_effect",
            c_mmr_restorat_1_OBSP_0 = core:Asserts("urn:eigenius:pub:wrn:mmr_rescue_sampleset"),
