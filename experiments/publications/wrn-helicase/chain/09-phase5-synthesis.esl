                        declared(c_mmr_restorat_1_CLAIM_1, c_mmr_restorat_1_OBSP_1 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:mmr_resens1_sampleset", c_mmr_restorat_1_OBSP_1)),
