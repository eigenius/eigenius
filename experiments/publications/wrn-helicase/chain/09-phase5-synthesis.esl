            c_val_recomput_0_cs_1 = app(c_val_recomput_0_OBSP_1, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_OVK18_sampleset"), 0.0), Declared(c_val_recomput_0_CLAIM_1), Observed("urn:eigenius:pub:wrn:viab_OVK18_sampleset"),
                        declared(c_val_recomput_0_CLAIM_1, c_val_recomput_0_OBSP_1 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_OVK18_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:viab_OVK18_sampleset", c_val_recomput_0_OBSP_1)),
            c_val_recomput_0_BRIDGE = "urn:eigenius:pub:wrn:bridge_viability",
            c_val_recomput_0_R_KM12 = "urn:eigenius:pub:wrn:viab_KM12_plan:result:main_effect",
            c_val_recomput_0_R_OVK = "urn:eigenius:pub:wrn:viab_OVK18_plan:result:main_effect",
            c_val_recomput_0_K = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_KM12_sampleset"), 0.0),
            c_val_recomput_0_O = stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_OVK18_sampleset"), 0.0),
            c_val_recomput_0_SVD = onco:SelectiveViabilityDependence("WRN", "MSI"),
            c_val_recomput_0_cert1 = app(c_val_recomput_0_K, c_val_recomput_0_O -> c_val_recomput_0_SVD, Declared(c_val_recomput_0_BRIDGE), c_val_recomput_0_js_0,
                        declared(c_val_recomput_0_BRIDGE, c_val_recomput_0_K -> c_val_recomput_0_O -> c_val_recomput_0_SVD), c_val_recomput_0_cs_0),
            c_helicase_req_2_RULE = "urn:eigenius:pub:wrn:helicase_rule",
            c_helicase_req_2_LIT = "urn:eigenius:pub:wrn:lit:lit_wrn_separable",
            c_helicase_req_2_ART = "urn:eigenius:pub:wrn:va_fail_k577m",
            c_helicase_req_2_SEP = litclaim:WRNActivitiesSeparable("WRN"),
            c_helicase_req_2_FR = onco:FailsToRescue("WRN_cDNA_K577M", "sgWRN_EIJ"),
            c_helicase_req_2_RA = onco:RequiresActivity("WRN", "helicase"),
            c_helicase_req_2_RULE_P = c_helicase_req_2_SEP -> c_helicase_req_2_FR -> c_helicase_req_2_RA,
            c_helicase_req_2_jSEP = Declared(c_helicase_req_2_LIT),
            c_helicase_req_2_jFR = Declared(c_helicase_req_2_ART),
            c_helicase_req_2_cert1 = app(c_helicase_req_2_SEP, c_helicase_req_2_FR -> c_helicase_req_2_RA, Declared(c_helicase_req_2_RULE), c_helicase_req_2_jSEP,
                        declared(c_helicase_req_2_RULE, c_helicase_req_2_RULE_P), declared(c_helicase_req_2_LIT, c_helicase_req_2_SEP)),
            c_mech_3_c_cellcycle_re_0_CLAIM_0 = "urn:eigenius:pub:wrn:cc_KM12_plan_yields_main_effect",
