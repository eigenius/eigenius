            c_mmr_restorat_0_cs_1 = app(c_mmr_restorat_0_OBSP_1, stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0), Declared(c_mmr_restorat_0_CLAIM_1), Observed("urn:eigenius:pub:wrn:mmr_resens1_sampleset"),
                        declared(c_mmr_restorat_0_CLAIM_1, c_mmr_restorat_0_OBSP_1 -> stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0)), observed("urn:eigenius:pub:wrn:mmr_resens1_sampleset", c_mmr_restorat_0_OBSP_1)),
            c_mmr_restorat_0_CLAIM_2 = "urn:eigenius:pub:wrn:mmr_resens2_plan_yields_main_effect",
            c_mmr_restorat_0_OBSP_2 = core:Asserts("urn:eigenius:pub:wrn:mmr_resens2_sampleset"),
