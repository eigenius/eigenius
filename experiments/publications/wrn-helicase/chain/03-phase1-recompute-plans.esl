    reflection:resource    = wrn:bridge_mutator_load;
    reflection:declared_by = "wrn-paper:mutator-load-criterion";
    reflection:timestamp   = "2026-06-12T14:30:00Z";
}

// ════════════════════════════════════════════════════════════════════
// D-LINEAGE (recomputed, ED Fig 2b): common MSI lineages carry a higher
// mutator load than uncommon MSI lineages
// ════════════════════════════════════════════════════════════════════
// Among MSI cell lines, those in the COMMON MSI lineages (colorectal /
// endometrial / gastric / ovarian — where the WRN-dependence biomarker holds)
// carry a higher microsatellite-deletion burden than the UNCOMMON MSI lineages.
// Wilcoxon rank-sum on ms_deletions_normed (group A = uncommon n=45, group B =
// common n=54), kernel-recomputed: P = 1.7e-9 (matching the paper). Group A
// below group B (uncommon fewer deletions) → the institution's directional
// stats:lt(mean_diff_of, 0). This is the mutator-load basis for why WRN
// dependence — and the biomarker — is restricted to the common MSI lineages.

resource wrn:lineage_mutator_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:lineage-mutator-directionality";
    reflection:rationale   = "The hypothesis is that the common MSI lineages carry MORE microsatellite deletions than the uncommon ones (higher mutator load drives the lineage-restricted WRN dependence). The inverse direction is not the claim, licensing the one-sided test.";
}

