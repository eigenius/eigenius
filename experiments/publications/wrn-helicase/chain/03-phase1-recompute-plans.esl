    bench:extraction_columns    = "Pearson's colocalization coefficient";
    bench:extraction_filter     = "sheet 'ED Figure 8d', 5 values/line; group A=MSI (KM12,SW48,OVK18; n=15), group B=MSS (SW620,ES2; n=10); each sorted ascending";
    bench:extraction_recipe     = "extract/extract_samplesets.py#wrn:coloc_sampleset";

    stats:sample_set_value = stats:IID(
        [0.072000, 0.215000, 0.233000, 0.274000, 0.290000, 0.401000, 0.404000, 0.408000,
         0.410000, 0.413000, 0.430000, 0.449000, 0.459000, 0.487000, 0.491000],
        [0.569000, 0.593000, 0.628000, 0.629000, 0.682000, 0.720000, 0.730000, 0.766000,
         0.781000, 0.796000],
        BiologicalReplication(),
