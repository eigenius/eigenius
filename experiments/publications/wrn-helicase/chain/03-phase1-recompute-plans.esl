resource wrn:bridge_apoptosis : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:apoptosis-induction-criterion";
    reflection:rationale   = "If WRN depletion significantly raises the apoptotic fraction (sgWRN apoptosis above negative controls) across MSI lines — recomputed for KM12 (two-way ANOVA P=3.4e-3), SW48 (P=3.6e-4), OVK18 (P=3.6e-5) — while sparing MSS lines (SW620 P=0.10, SW837 P=0.41, ES2 P=0.57, non-significant; recomputed to Fail, the declared 'spared' judgment since a null is not derivable), then WRN depletion causes MSI-selective apoptosis — a downstream consequence of DSB-driven DDR.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_KM12_sampleset"), 0.0)
        ->
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_SW48_sampleset"), 0.0)
        ->
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:apop_OVK18_sampleset"), 0.0)
        ->
        onco:CausesApoptosis("WRN", "MSI")
    );
}
resource wrn:bridge_apoptosis_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_apoptosis;
    reflection:declared_by = "wrn-paper:apoptosis-induction-criterion";
    reflection:timestamp   = "2026-06-13T06:30:00Z";
}

