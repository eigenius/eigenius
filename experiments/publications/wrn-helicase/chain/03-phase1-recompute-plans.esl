}

// ════════════════════════════════════════════════════════════════════
// C-MMR-FN (recomputed, ED Fig 10a): MMR restoration restores mismatch repair
// ════════════════════════════════════════════════════════════════════
// Flow-cytometric host-cell reactivation (repair of a G:G mismatch) in HCT116:
// parental (MMR-deficient, n=3, ~1.9) vs Ch3+5 (MLH1/MSH3 restored, n=3, ~35.8).
// Restoring MMR restores repair — the functional confirmation the model's WRN
// dependence rides on a real MMR defect. Two-sample t-test (group A = parental
// below group B = Ch3+5 → directional lt(mean_diff_of, 0)); paper t-test p≈2.3e-3.

resource wrn:hcr_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:mmr-restoration-directionality";
    reflection:rationale   = "The hypothesis is that restoring MMR (Ch3+5) INCREASES mismatch-repair capacity over the MMR-deficient parental — a directional increase. The inverse direction is not the claim, licensing the one-sided test.";
}

resource wrn:hcr_sampleset : stats:SampleSetResource {
    reflection:source      = "HCT116 host-cell reactivation, parental vs Ch3+5 (ED Fig 10a source data)";
    reflection:observed_at = "2019-01-01T00:00:00Z";

    bench:extracted_from_slice  = "data/slices/wrn_sourcedata_EDFig10_MOESM12.xlsx";
    bench:extracted_from_sha256 = "3fc08ebadbc282ac7bdb4f87d73e704e79e216b611e5357302d17e4e32cdb33c";
    bench:extraction_columns    = "host-cell reactivation (ED Fig 10a)";
    bench:extraction_filter     = "sheet 'ED Fig 10a', 3 values/condition; group A=HCT116 parental (MMR-deficient, n=3), group B=HCT116 Ch3+5 (MMR-restored, n=3); each sorted ascending";
    bench:extraction_recipe     = "extract/extract_samplesets.py#wrn:hcr_sampleset";

    stats:sample_set_value = stats:IID(
        [1.730713, 1.857164, 2.016017],
        [32.741693, 36.210852, 38.438682],
        BiologicalReplication(),
    );
}

resource wrn:hcr_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:hcr_sampleset;
    reflection:source    = "wrn-paper:ED-Fig-10a source data";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:hcr_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set = wrn:hcr_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "reactivation_pct");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:hcr_directionality_witness");
    stats:variance_assumption = WelchUnequal();
    stats:outlier_exclusion   = Identity();
}

resource wrn:hcr_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:hcr_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:bridge_hcr : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:mmr-restoration-criterion";
    reflection:rationale   = "If the MMR-deficient parental's mismatch-repair capacity is strictly below the MMR-restored Ch3+5 group, MMR restoration restores functional repair — confirming the model's MMR defect is genuine. The directional statistical claim is the warrant.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:hcr_sampleset"), 0.0)
        ->
        onco:MMRRestorationRestoresRepair("HCT116", "Ch3plus5")
    );
}

