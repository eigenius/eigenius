resource wrn:bridge_mutator_load : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:mutator-load-criterion";
    reflection:rationale   = "If WRN dependency negatively correlates with mutator load (#MS deletions) across MSI lines, WRN dependency tracks mutator load — supporting the refinement that a stronger mutator phenotype drives WRN dependence.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:spearman_rho("urn:eigenius:pub:wrn:wrn_corr_sampleset"), 0.0)
        ->
        onco:DependencyCorrelatesWithMutatorLoad("WRN", "MSI")
    );
}

