    stats:sample_set_value = stats:IID(
        [0.417046, 0.358101, 0.383306, 0.411624, 0.449156, 0.425581],
        [0.675784, 0.821126, 0.782821, 0.835812, 0.966431, 0.730515],
        BiologicalReplication(),
    );
}
resource wrn:rescue_e84a_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = wrn:rescue_e84a_sampleset;
    reflection:source    = "wrn-paper Fig 2c (Nature Source Data, pinned)";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}
resource wrn:rescue_e84a_plan : stats:StatisticalAnalysisPlan {
    stats:sample_set          = wrn:rescue_e84a_sampleset;
    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(0.0, "relative_viability");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:pub:wrn:rescue_directionality_witness");
    stats:variance_assumption = Pooled();
    stats:outlier_exclusion   = Identity();
}
resource wrn:rescue_e84a_plan_trace : reflection:ProgramTrace {
    reflection:resource  = wrn:rescue_e84a_plan;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2019-01-01T00:00:00Z";
}

resource wrn:bridge_rescue_wt : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:on-target-rescue-criterion";
    reflection:rationale   = "If re-expressing WT WRN cDNA significantly raises sgWRN-EIJ viability above the GFP control (recomputed two-sample t-test P=2.4e-7), the cDNA rescues the depletion — the EIJ reagent spares the cDNA, so functional WRN is restored.";
    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:rescue_wt_sampleset"), 0.0)
        ->
        onco:RescuesDepletion("WRN_cDNA_WT", "sgWRN_EIJ")
    );
}
resource wrn:bridge_rescue_wt_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_rescue_wt;
    reflection:declared_by = "wrn-paper:on-target-rescue-criterion";
    reflection:timestamp   = "2026-06-13T08:00:00Z";
}

resource wrn:bridge_rescue_e84a : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:exonuclease-dispensable-criterion";
    reflection:rationale   = "If the exonuclease-dead (E84A) WRN cDNA significantly raises sgWRN-EIJ viability above the GFP control (recomputed two-sample t-test P=3.4e-6), it still rescues — the exonuclease activity is dispensable for the rescue.";
    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:rescue_e84a_sampleset"), 0.0)
        ->
        onco:RescuesDepletion("WRN_cDNA_E84A", "sgWRN_EIJ")
    );
}
resource wrn:bridge_rescue_e84a_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_rescue_e84a;
    reflection:declared_by = "wrn-paper:exonuclease-dispensable-criterion";
    reflection:timestamp   = "2026-06-13T08:00:00Z";
}
