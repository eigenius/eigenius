    bench:extraction_filter     = "group A = GFP background + sgWRN-EIJ; group B = WRN-WT-cDNA background + sgWRN-EIJ";
    bench:extraction_recipe     = "extract/extract_samplesets.py#wrn:rescue_wt_sampleset";

