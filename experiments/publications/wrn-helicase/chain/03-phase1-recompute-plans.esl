resource wrn:bridge_coloc : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:nucleolar-delocalization-criterion";
    reflection:rationale   = "If WRN–fibrillarin colocalization in MSI lines is strictly below the lineage-matched MSS group, WRN is delocalized from the nucleolus in MSI. The directional statistical claim is the warrant.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:coloc_sampleset"), 0.0)
        ->
        onco:ReducedNucleolarColocalization("WRN", "MSI")
    );
}

