resource wrn:bridge_viability : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:selective-viability-criterion";
    reflection:rationale   = "If WRN depletion significantly impairs viability (sgWRN below negative controls in the competition assay) in MSI lines — recomputed for KM12 (two-way ANOVA P=2.7e-19) and OVK18 (P=1.2e-7) — while sparing MSS lines (ES2 P=0.37, SW620 P=0.23, non-significant; recomputed to Fail, the declared 'spared' judgment since a null is not derivable), then WRN depletion selectively impairs MSI viability.";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_KM12_sampleset"), 0.0)
        ->
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:viab_OVK18_sampleset"), 0.0)
        ->
        onco:SelectiveViabilityDependence("WRN", "MSI")
    );
}
