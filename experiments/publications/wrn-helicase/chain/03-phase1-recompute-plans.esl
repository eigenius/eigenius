// ── Declared bridge: the three contrasts compose the causal dissection ──
resource wrn:bridge_mmr_restoration : reflection:DeclaredResource {
    reflection:declared_by = "wrn-paper:mmr-restoration-criterion";
    reflection:rationale   = "If restoring MMR raises WRN-depletion viability (Ch2 below Ch3+5+sgCh2-2, recomputed two-way ANOVA P=5.7e-20) AND re-knocking-out MLH1 in the restored line re-lowers it (Ch3+5+sgMLH1-1 below Ch3+5+sgCh2-2, P=3.3e-12; Ch3+5+sgMLH1-2 below Ch3+5+sgCh2-2, P=1.6e-16), then the rescue is attributable to MMR (the MLH1-KO controls isolate MMR from the chromosome transfer) and restoring MMR PARTIALLY rescues WRN dependence. 'Partially' is load-bearing: the rescue is modest (Ch3+5 shWRN viability ≈0.71, not restored to 1.0), so dMMR contributes to but does not fully explain WRN dependence (cf. D-REFINE mutator load).";

    reflection:canonical_proposition = type_expr(
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_rescue_sampleset"), 0.0)
        ->
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens1_sampleset"), 0.0)
        ->
        stats:lt(stats:mean_diff_of("urn:eigenius:pub:wrn:mmr_resens2_sampleset"), 0.0)
        ->
        onco:RestorationPartiallyRescues("dMMR", "WRN")
    );
}
resource wrn:bridge_mmr_restoration_trace : reflection:DeclarationTrace {
    reflection:resource    = wrn:bridge_mmr_restoration;
    reflection:declared_by = "wrn-paper:mmr-restoration-criterion";
    reflection:timestamp   = "2026-06-13T07:00:00Z";
}

// ════════════════════════════════════════════════════════════════════
// D-ONTARGET / D-HELICASE (recomputed): the sgWRN-EIJ cDNA rescue assay
// ════════════════════════════════════════════════════════════════════
// The on-target + structure-function rescue (Fig 2c, KM12 competition assay,
// relative viability, n = 6 biological replicates), kernel-recomputed via the
// existing IID two-sample dispatch (no new capability). sgWRN-EIJ silences
// endogenous WRN but spares the EIJ-less cDNA, so re-expressing functional WRN
// rescues. Each rescue is a two-sample t-test of the sgWRN-EIJ arm: GFP
// background (no rescue cDNA, group A) vs the cDNA background (group B); a
// significant rise = rescue ⇒ stats:lt(mean_diff_of(s), 0) (group A below B).
//   WT cDNA   rescues  (GFP-EIJ 0.41 → WT-EIJ 0.68;  two-sided P=2.4e-7)
//   E84A cDNA rescues  (exonuclease-dead → still rescues; → 0.80; P=3.4e-6)
//   K577M cDNA FAILS   (helicase-dead; GFP-EIJ 0.41 vs K577M-EIJ 0.37, P=0.13
//                       n.s. — a null, kept as the Declared FailsToRescue in
//                       wrn-phase2; a null is not derivable). Source: pinned
// Nature Fig 2 Source Data. Replaces the linked-external va_rescue_{wt,e84a}.

resource wrn:rescue_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:on-target-rescue-directionality";
    reflection:rationale   = "An EIJ-spared functional WRN cDNA RAISES sgWRN-EIJ viability above the GFP (no-rescue) control: the directional claim is GFP-background sgWRN-EIJ viability below the cDNA-background (group A mean < group B). The inverse (re-expressing WRN lowering viability) is not the hypothesis, licensing the one-sided test.";
}

