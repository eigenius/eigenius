// ════════════════════════════════════════════════════════════════════
// C-LOC (recomputed, ED Fig 8d): WRN is delocalized from the nucleolus in MSI
// ════════════════════════════════════════════════════════════════════
// WRN–fibrillarin Pearson colocalization (5 values per line) is LOWER in MSI
// (KM12,SW48,OVK18; n=15) than in lineage-matched MSS (SW620,ES2; n=10) — WRN
// leaves the nucleolus in MSI cells. Two-sample t-test (group A = MSI below
// group B = MSS → directional stats:lt(mean_diff_of, 0)); kernel-recomputed
// (paper two-tailed t-test p = 3.2e-8).

resource wrn:coloc_directionality_witness : stats:ImpossibilityWitness {
    reflection:declared_by = "wrn-paper:nucleolar-delocalization-directionality";
    reflection:rationale   = "The hypothesis is that WRN's nucleolar (fibrillarin) colocalization is REDUCED in MSI relative to lineage-matched MSS — a directional decrease. The inverse direction is not the claim, licensing the one-sided test.";
}

resource wrn:coloc_sampleset : stats:SampleSetResource {
