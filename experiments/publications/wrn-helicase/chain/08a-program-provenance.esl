// ════════════════════════════════════════════════════════════════════
// 08a — provenance for the out-of-band program runs
// ════════════════════════════════════════════════════════════════════
//
// The mechanism and in-vivo arms are computed by wrapped-R programs whose
// results the R runtime emits out of band. The chain used to cite those results
// as `DerivedEvidence(<program>:result)` — a single opaque leaf standing in for
// both halves of what actually happened.
//
// Under the three grounds there is no such leaf. A computed conclusion is
// `App(Declared(plan), Observed(input))`: the plan is DECLARED to denote a
// function of its input, and the input is OBSERVED. Both halves need a witness,
// and a witness needs a trace whose target resolves on chain — so the programs'
// inputs and the reproducibility claims are committed here, in an ancestor
// layer of the conclusions that cite them.
//
// The programs already carried their `I -> O` signature as
// `program:input_type` / `program:output_type`. What was missing was anyone
// asserting it, and the kernel being able to check that they had.
//
// Each claim is bound to its SPECIFIC hash-pinned input, not universally
// quantified: these inputs are content-addressed, so "this exact input yields
// this result" is both the true statement and the whole of what
// reproducibility means for immutable data.

namespace core          = "urn:eigenius:core";
namespace reflection    = "urn:eigenius:reflection";
namespace agent         = "urn:eigenius:prov:agent";
namespace ingest        = "urn:eigenius:ingest";
namespace onco          = "urn:eigenius:benchmark:onco";
namespace bench         = "urn:eigenius:benchmark";
namespace wrn           = "urn:eigenius:pub:wrn";
namespace prov       = "urn:eigenius:prov";
namespace justification = "urn:eigenius:justification";
namespace wrnact     = "urn:eigenius:pub:wrn:activity";

resource wrn:warrant_program_reproducibility : prov:Source {
    prov:was_attributed_to = agent:eigenius_core_team;
    core:description = "Each wrapped-R program below pins its analysis script, its container image and its input by content hash, and declares its input and output types. Those together are what make the program a function of its input rather than of the occasion — the claim `Declared(program)` carries, and one no execution record could establish on its own.";
    core:short_name = "warrant_program_reproducibility";
}


// ── vivo_lme4 ──────────────────────────────────────────────
resource wrn:vivo_xenograft_table_obs : prov:ObservationTrace {
    prov:resource  = wrn:vivo_xenograft_table;
    prov:was_generated_by    = wrnact:program_input_extraction;
    prov:timestamp = "2026-08-29T00:00:00Z";
}

resource wrn:vivo_lme4_yields_result : justification:Claim {
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = wrn:warrant_program_reproducibility;
    prov:rationale    = "Applying the vivo_lme4 program to its pinned input yields onco:InVivoDependence('WRN', 'MSI').";
    reflection:canonical_proposition = type_expr(
        core:Asserts("urn:eigenius:pub:wrn:vivo_xenograft_table") -> onco:InVivoDependence("WRN", "MSI")
    );
}
resource wrn:vivo_lme4_yields_result_trace : prov:DeclarationTrace {
    prov:resource     = wrn:vivo_lme4_yields_result;
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = wrn:warrant_program_reproducibility;
    prov:timestamp    = "2026-08-29T00:00:00Z";
}

