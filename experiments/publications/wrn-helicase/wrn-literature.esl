resource wrnlit:cite_rossi : reference:Citation {
    reference:cites           = lit:rossi_2010;
    reference:citation_type   = reference:obtains_background_from;
    reference:reference_label = "15";
    reflection:rationale      = "WRN's roles in genome-integrity maintenance (replication/repair/telomere) and the Werner-syndrome phenotype.";
}

resource wrnlit:cite_nowsheen : reference:Citation {
    reference:cites           = lit:nowsheen_2012;
    reference:citation_type   = reference:obtains_background_from;
    reference:reference_label = "19";
    reflection:rationale      = "The DNA-damage-response / cell-death pathway intersection underpinning the DSB->DDR->apoptosis mechanism.";
}

resource wrnlit:cite_ccle_gdsc : reference:Citation {
    reference:cites           = lit:ccle_gdsc_2015;
    reference:citation_type   = reference:cites_as_authority;
    reference:reference_label = "34";
    reflection:rationale      = "Pharmacogenomic agreement between CCLE and GDSC — the authority for cross-panel MSI/data concordance.";
}

