// wrn-literature — the WRN paper's literature references as first-class,
// cite-able warrants (encoding-plan §3: "references → the exact claim each
// supports"). Built on the bootstrap `reference` ontology:
//
//   - reference:Reference — the global bibliographic WORK (real details from the
//                           paper's reference list; DOI + PubMed ID both carried).
//   - litclaim:*          — the imported claim a citation warrants, as a
//                           proposition (so a node can later discharge it via
//                           DeclaredEvidence).
//   - reference:Citation  — THIS paper's use of a Reference (a DeclaredResource):
//                           reference:cites + the CiTO reference:citation_type +
//                           the paper's local reference:reference_label. A
//                           *literature warrant* is a Citation that also carries
//                           the imported claim in canonical_proposition; a
//                           Citation without one is pure provenance.
//
// Bracketed numbers are the WRN paper's own reference numbers (reference_label).
// PMIDs are transcribed from the manuscript's reference list; DOIs are the
// authoritative NCBI PMID->DOI cross-walk (not fabricated); url resolves to
// doi.org (or PubMed for the one Exp. Oncol. entry with no registered DOI).
// All PMIDs were spot-checked against NCBI esummary and resolve to these works.
//
// Load order: this layer loads BEFORE wrn-phase2/phase3, which compose its
// warrants as LOGICAL PREMISES (not just provenance) — the structure-function
// rules consume WRNActivitiesSeparable [14] and the seed-control rule consumes
// C911ControlIsValid [16], so concl_helicase_required / concl_exo_dispensable /
// concl_vivo_ontarget each carry a DeclaredEvidence on the matching warrant and
// thread it through their certificate. Each warrant has a DeclarationTrace so
// the kernel mints the IsDeclaredAs witness those certificates discharge.
// (Remaining warrants — [1]/[10]/[11]/[17]/[20]/[36]/[40]/[43] and the
// provenance citations — are authored and cite-able; not yet composed.)

namespace core       = "urn:eigenius:core";
namespace reflection = "urn:eigenius:reflection";
namespace reference  = "urn:eigenius:reference";
namespace lit        = "urn:eigenius:reference:lit";
namespace litclaim   = "urn:eigenius:pub:wrn:litclaim";
namespace wrnlit     = "urn:eigenius:pub:wrn:lit";

// ════════════════════════════════════════════════════════════════════
// Imported-claim propositions — what the literature warrants assert
// ════════════════════════════════════════════════════════════════════

// [1] synthetic-lethality strategy is exploitable for cancer therapy.
data litclaim:SyntheticLethalityExploitable : core:string -> Prop { }
// [14] WRN's exonuclease and helicase activities are separable (E84A / K577M).
data litclaim:WRNActivitiesSeparable : core:string -> Prop { }
// [16] a C911 seed-preserving control isolates on-target from shRNA seed off-target.
data litclaim:C911ControlIsValid : core:string -> Prop { }
// [17] phospho-p53(Ser15) marks p53 activation (an ATR/ATM DDR target).
data litclaim:pS15MarksP53Activation : core:string -> Prop { }
// [20] WRN relocalizes between nucleoli and nucleoplasm (repair-protein dynamics).
data litclaim:WRNNucleolarDynamics : core:string -> Prop { }
// [10] CERES corrects the copy-number effect in CRISPR essentiality screens.
data litclaim:CERESCorrectsCopyNumber : core:string -> Prop { }
// [11] Project DRIVE is a deep-RNAi (DEMETER2) cancer-dependency compendium.
data litclaim:DRIVEDependencyDataset : core:string -> Prop { }
// [36] limma provides empirical-Bayes moderated-t differential expression.
data litclaim:LimmaModeratedT : core:string -> Prop { }
// [40] voom precision weights enable linear-model analysis of RNA-seq counts.
data litclaim:VoomPrecisionWeights : core:string -> Prop { }
// [43] the MSigDB Hallmark collection is a curated gene-set resource.
data litclaim:HallmarkGeneSets : core:string -> Prop { }
// [22] loss of MSH3 (MutSα/β component) causes microsatellite instability.
data litclaim:MSH3LossCausesInstability : core:string -> Prop { }

