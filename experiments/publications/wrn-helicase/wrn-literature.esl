resource wrnlit:cite_iorio : reference:Citation {
    reference:cites           = lit:iorio_2016;
    reference:citation_type   = reference:cites_as_source_document;
    reference:reference_label = "13";
    reflection:rationale      = "The GDSC PCR-based MSI phenotyping used as the orthogonal MSI labels in the dd_gdsc robustness warrant.";
