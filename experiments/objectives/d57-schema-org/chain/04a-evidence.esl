// ════════════════════════════════════════════════════════════════════
// m3 + m4 — evidence (pins, rule, checks, cut accounting)  [PRE-RUN]
// ════════════════════════════════════════════════════════════════════
//
// Loads BEFORE `eigenius run`: commits `obj:gen_input` for the program to
// consume, and the Observed pins + the m3 rule as ancestors of the conclusions.
// The conclusions live in 04b-conclusions.esl, loaded AFTER the run (so the
// run's `generate_result` + ProgramTrace → IsDerivedAs witness exists when
// `concl_generator` discharges `derived(...)`).
//
// m3 (GeneratorProduces) is DECOMPOSED and mechanically witnessed
// (docs/notes/d57-mechanical-evidence-plan.md, Level 2). It composes, by modus
// ponens, three legs:
//   • InputArtifactObserved  — the pinned schema.org V30.0 input exists,
//                              content-hashed (OBSERVED, kernel-emitted IsObservedAs).
//   • OutputArtifactObserved — the generated ontology exists, content-hashed
//                              (OBSERVED).
//   • GeneratorConforms      — the output conforms to the m1 discipline. **DERIVED**:
//                              `eigenius run` dispatches the generator as a program
//                              THROUGH the kernel (the D60 `oci` runtime runs
//                              eigenius-schemaorg-worker in a pinned image over the
//                              content-hashed input), committing `generate_result` +
//                              a ProgramTrace → IsDerivedAs(generate_result,
//                              GeneratorConforms). The WRN wrapped-program pattern;
//                              no new institution.
// The two artifact legs are genuine Observed witnesses (content_hash → IsObservedAs);
// the conformance leg is now a genuine Derived witness (the kernel attests the run).
// `obj:generator_checks` below is retained as the reproducible CI cross-check
// (crates/eigenius-schemaorg/tests/output_validates.rs), not a certificate leg.
//
// m4 (CutAccounted) stays Declared, with its rationale upgraded to cite the
// independent partition recount (the `cut_partitions_the_schema_namespace` test)
// and the regenerated coverage report.
//
// The thesis (05-synthesis.esl) cites concl_generator / concl_cut as Verified
// lemmas (D54), so it loads as a later layer after they Hold.

namespace core       = "urn:eigenius:core";
namespace reflection = "urn:eigenius:reflection";
namespace reasoning  = "urn:eigenius:reasoning";
namespace ingest     = "urn:eigenius:ingest";
namespace obj        = "urn:eigenius:obj:d57";

// ── sub-propositions for the m3 decomposition ───────────────────────
data obj:InputArtifactObserved  : core:string -> Prop { }
data obj:OutputArtifactObserved : core:string -> Prop { }
data obj:GeneratorConforms      : core:string -> Prop { }

// ── OBSERVED artifacts (content-addressed pins) ─────────────────────
// The generator's input and output, tracked by content hash — the bytes live
// off-chain (gitignored, reproducible); only the typed, hashed node travels on
// the chain. content_hash → the kernel emits IsObservedAs for each, so the
// `observed(...)` certificate legs below resolve.
resource obj:gen_input : ingest:PinnedExternalFile {
    core:short_name           = "schemaorg_v30_input";
    ingest:reference          = "crates/eigenius-schemaorg/data/schemaorg-current-https-v30.0.jsonld";
    ingest:content_hash       = "sha256:0f0c97a4f666b2f8563573fe48453782fd51b87a504523cf0c9aff6a71c3eec4";
    ingest:media_type         = "application/ld+json";
    core:source_irl           = "https://schema.org/version/30.0/schemaorg-current-https.jsonld";
    reflection:source         = "Schema.org V30.0 (2026-03-19), https://schema.org/version/30.0/schemaorg-current-https.jsonld (1551177 bytes)";
    reflection:canonical_proposition = type_expr( obj:InputArtifactObserved("schema_org") );
}
resource obj:gen_output : ingest:PinnedExternalFile {
    core:short_name           = "schemaorg_eigon_output";
    ingest:reference          = "ontologies/schema-org/schema-org.eigon.json";
    ingest:content_hash       = "sha256:f4de231a3e32247509b000801e88a026a874bf3bf5a872a758f2227c5598c3fb";
    ingest:media_type         = "application/json";
    reflection:source         = "Generated by crates/eigenius-schemaorg (--bin schemaorg-import) from the pinned V30.0 input; deterministic.";
    reflection:canonical_proposition = type_expr( obj:OutputArtifactObserved("schema_org") );
}
// ObservationTrace → the kernel emits IsObservedAs(target, canonical_proposition).
resource obj:gen_input_trace : reflection:ObservationTrace {
    reflection:resource  = obj:gen_input;
    reflection:source    = "Schema.org V30.0 published JSON-LD, fetched + content-verified (sha256 0f0c97a4...).";
    reflection:timestamp = "2026-06-20T00:00:00Z";
}
resource obj:gen_output_trace : reflection:ObservationTrace {
    reflection:resource  = obj:gen_output;
    reflection:source    = "schemaorg-import over the pinned input; content-verified (sha256 f4de231a...).";
    reflection:timestamp = "2026-06-20T00:00:00Z";
}

// ── GeneratorConforms — Declared, mechanically witnessed ────────────
resource obj:generator_checks : reflection:DeclaredResource {
    reflection:declared_by = "d57:m3-generator";
    reflection:rationale   = "Witnessed mechanically by crates/eigenius-schemaorg/tests/output_validates.rs (run: cargo test -p eigenius-schemaorg -- --ignored), converting the content-pinned V30.0 input (sha256 0f0c97a4...) into the content-pinned output (sha256 f4de231a...): (1) output_loads_and_validates — all 2114 resources (683 classes, 51 enumeration classes, 250 members, 1130 properties) load onto core+reflection and the kernel Validator reports 0 errors (Expressible); (2) no_resource_carries_core_domain — domainIncludes is inverted into advisory core:recommends, zero core:domain restrictions leak; (3) enumeration_ranged_properties_close_with_allows_only — every closable enumeration range carries allows_only over the TRANSITIVE member closure, the 66-property Enumeration tier splitting exactly into 62 closed + 4 genuinely-open member-less enums (BusinessFunction, BusinessEntityType, BedType, WarrantyScope — members defined in external vocabularies); (4) source_irl_round_trips_to_id — every emitted resource's source_irl reverses to its urn:schema_org: @id; (5) conversion_is_deterministic. The correspondence rules also have CI-safe coverage in src/convert.rs unit tests. Grade: Declared — the conformance properties are established by a cargo test run; the Level-2 upgrade runs the generator as a kernel-dispatched program (D56 wrapped-program, ProgramTrace -> IsDerivedAs — the WRN wrapped-R pattern, no new institution) so concl_generator can discharge GeneratorConforms via derived(...) (docs/notes/d57-mechanical-evidence-plan.md).";
    reflection:canonical_proposition = type_expr( obj:GeneratorConforms("schema_org") );
}
resource obj:generator_checks_trace : reflection:DeclarationTrace {
    reflection:resource    = obj:generator_checks;
    reflection:declared_by = "d57:m3-generator";
    reflection:timestamp   = "2026-06-20T00:00:00Z";
}

// ── the m3 rule and its conclusion (modus ponens over the three legs) ─
resource obj:generator_rule : reflection:DeclaredResource {
    reflection:declared_by = "d57:m3-generator";
    reflection:rationale   = "The generator produces the mappable vocabulary when: the pinned input exists (InputArtifactObserved), the generated output exists (OutputArtifactObserved), and that output conforms to the m1 discipline (GeneratorConforms). The two artifacts are content-hashed Observed witnesses; conformance is the mechanically-checked bridge between them.";
    reflection:canonical_proposition = type_expr(
        obj:InputArtifactObserved("schema_org")
        ->
        obj:OutputArtifactObserved("schema_org")
        ->
        obj:GeneratorConforms("schema_org")
        ->
        obj:GeneratorProduces("schema_org")
    );
}
resource obj:generator_rule_trace : reflection:DeclarationTrace {
    reflection:resource    = obj:generator_rule;
    reflection:declared_by = "d57:m3-generator";
    reflection:timestamp   = "2026-06-20T00:00:00Z";
}

// ── m4: the cut is accounted ────────────────────────────────────────
resource obj:cut_accounting : reflection:DeclaredResource {
    reflection:declared_by = "d57:m4-cut";
    reflection:rationale   = "The generator emits a coverage report (data/coverage.json) accounting the cut for V30.0, and the accounting is mechanically checked: crates/eigenius-schemaorg/tests/output_validates.rs::cut_partitions_the_schema_namespace independently recounts the parsed graph and reproduces the report exactly — every schema: node lands in exactly one bucket (mapped 2114 = 683 classes + 51 enum classes + 250 members + 1130 properties; folded 15 DataTypes; excluded-by-layer 848; the remainder non-vocabulary), so nothing is silently dropped. Property ranges by tier: Clean 867, by-convention 188, enumeration 66 (62 closed via allows_only + 4 genuinely-open member-less enums), defaulted 9. The Tier-3 relational residual is recorded but NOT mapped (equivalentClass 48, equivalentProperty 89, subPropertyOf 142, inverseOf 45, supersededBy 82 — inert provenance, no reasoner). Every in-scope schema: term is therefore either mapped or in the justified residual.";
    reflection:canonical_proposition = type_expr( obj:CutAccounted("schema_org") );
}
resource obj:cut_accounting_trace : reflection:DeclarationTrace {
    reflection:resource    = obj:cut_accounting;
    reflection:declared_by = "d57:m4-cut";
    reflection:timestamp   = "2026-06-20T00:00:00Z";
}

// (concl_generator + concl_cut live in 04b-conclusions.esl, loaded AFTER the run.)
