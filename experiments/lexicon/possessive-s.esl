namespace core    = "urn:eigenius:core";
namespace logic   = "urn:eigenius:logic";
namespace lexicon = "urn:eigenius:lexicon";

// ── Possessive clitic `'s` (OpenCCG `core-en` `det.xsl` `PossS`) ────────────
//
// `PossS` is the clitic counterpart of `PossPro` (`its`/`my`/`your`/`their`):
// where `PossPro` fixes the possessor to `lexicon:anaphor`, `'s` takes the
// preceding noun phrase `cat_np(Entity, num_any)` as a backward argument `p`
// and yields a `cat_forall` possessive determiner over `lexicon:poss_of(A, x, p)`.

resource lexicon:poss_s_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (p : lexicon:Entity) => fun (A : Set) => fun (V : A -> Prop) =>
            forall (C : Prop) => (forall (x : A) => (lexicon:poss_of(A, x, p) -> V(x) -> C)) -> C
          : lexicon:Entity -> (forall (A : Set) => (A -> Prop) -> Prop) )
    );
}
resource lexicon:poss_s_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (p : lexicon:Entity) => fun (T : Set) => fun (TV : T -> lexicon:Entity -> Prop) => fun (subj : lexicon:Entity) =>
            forall (C : Prop) => (forall (x : T) => (lexicon:poss_of(T, x, p) -> TV(x, subj) -> C)) -> C
          : lexicon:Entity -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) )
    );
}

resource lexicon:poss_s_subj_sg : lexicon:LexicalEntry {
    core:description = "grammatical: possessive clitic `'s` in subject position, singular head ('the study's gene').";
    lexicon:form     = "'s";
    lexicon:cat      = type_expr( lexicon:bwd(lexicon:m_all, lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:sg)))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:poss_s_subj_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (forall (A : Set) => (A -> Prop) -> Prop) );
    lexicon:sense    = "'s";
}
resource lexicon:poss_s_obj_sg : lexicon:LexicalEntry {
    core:description = "grammatical: possessive clitic `'s` in object position, singular head ('affects the study's gene').";
    lexicon:form     = "'s";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:bwd(lexicon:m_all, lexicon:cat_forall(lexicon:sg, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))) );
    lexicon:sem      = lexicon:poss_s_obj_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) );
    lexicon:sense    = "'s";
}
resource lexicon:poss_s_subj_pl : lexicon:LexicalEntry {
    core:description = "grammatical: possessive clitic `'s` in subject position, plural head ('the study's genes').";
    lexicon:form     = "'s";
    lexicon:cat      = type_expr( lexicon:bwd(lexicon:m_all, lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(T, lexicon:pl)))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)) );
    lexicon:sem      = lexicon:poss_s_subj_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (forall (A : Set) => (A -> Prop) -> Prop) );
    lexicon:sense    = "'s";
}
resource lexicon:poss_s_obj_pl : lexicon:LexicalEntry {
    core:description = "grammatical: possessive clitic `'s` in object position, plural head ('affects the study's genes').";
    lexicon:form     = "'s";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:bwd(lexicon:m_all, lexicon:cat_forall(lexicon:pl, fun (T : Set) => lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(T, lexicon:num_any)))), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))) );
    lexicon:sem      = lexicon:poss_s_obj_sem;
    lexicon:sem_type = type_expr( lexicon:Entity -> (forall (T : Set) => (T -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop)) );
    lexicon:sense    = "'s";
}
