namespace core     = "urn:eigenius:core";
namespace logic    = "urn:eigenius:logic";
namespace lexicon  = "urn:eigenius:lexicon";
namespace ontology = "urn:eigenius:ontology";

// ── Pre-nominal NP focus `only` (D61 faithfulness follow-up) ─────────────────
//
// Pre-nominal counterpart of post-nominal `alone` (`lexicon:alone_focus`), reusing
// `ontology:sole : lexicon:Entity -> Prop`. Where `alone` refines a bare `cat_n` inside
// the determiner ("each event alone"), `only` attaches OUTSIDE the determiner to the
// generalized quantifier (`[only [an assay]]`, `[only [one pattern]]`, `[only [four residues]]`,
// `[only [the count]]`), restricting its witness by `ontology:sole`.

resource lexicon:only_subj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (Q : (lexicon:Entity -> Prop) -> Prop) => fun (V : lexicon:Entity -> Prop) =>
            Q(fun (x : lexicon:Entity) => logic:And(ontology:sole(x), V(x)))
          : ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop )
    );
}
resource lexicon:only_obj_sem : lexicon:SemTerm {
    lexicon:term = type_expr(
        ( fun (Q : (lexicon:Entity -> Prop) -> Prop) =>
          fun (TV : lexicon:Entity -> lexicon:Entity -> Prop) =>
          fun (s : lexicon:Entity) =>
            Q(fun (x : lexicon:Entity) => logic:And(ontology:sole(x), TV(x, s)))
          : ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) )
    );
}

resource lexicon:only_s : lexicon:LexicalEntry {
    core:description = "grammatical: pre-nominal exclusive focus particle on a subject or PP-object NP ('only an assay', 'only one pattern').";
    lexicon:form     = "only";
    lexicon:cat      = type_expr( lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, n))), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, n))))) );
    lexicon:sem      = lexicon:only_subj_sem;
    lexicon:sem_type = type_expr( ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> Prop) -> Prop );
    lexicon:sense    = "only";
}
resource lexicon:only_o : lexicon:LexicalEntry {
    core:description = "grammatical: pre-nominal exclusive focus particle on an object NP ('involve only four residues').";
    lexicon:form     = "only";
    lexicon:cat      = type_expr( lexicon:cat_fin_forall(fun (f : lexicon:Fin) => lexicon:cat_num_forall(fun (n : lexicon:Num) => lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:fwd(lexicon:m_all, lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, f), lexicon:cat_np(lexicon:Entity, n)), lexicon:cat_np(lexicon:Entity, lexicon:num_any))), lexicon:fwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin_any), lexicon:bwd(lexicon:m_all, lexicon:cat_s(lexicon:dcl, lexicon:fin), lexicon:cat_np(lexicon:Entity, lexicon:num_any)))))) );
    lexicon:sem      = lexicon:only_obj_sem;
    lexicon:sem_type = type_expr( ((lexicon:Entity -> Prop) -> Prop) -> (lexicon:Entity -> lexicon:Entity -> Prop) -> (lexicon:Entity -> Prop) );
    lexicon:sense    = "only";
}
