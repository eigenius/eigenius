// C-0020's evidence, committed so the kernel can compute the ground rather than be told it.
//
// D100 rung 1. The certificate for C-0020 records a gnomAD v4 GraphQL sweep, its archived response
// with a sha256, four observation timestamps, and an independent reconciliation against the v4.1
// release VCFs. None of that asserts a GRADE: per `judgements-and-warrants.tex`'s deprecated-patterns
// list, "no path exists by which asserting a class confers evidential standing", and
// `justification:Grounds`'s `observed` leaf consumes a `witness:IsObservedAs` that the kernel
// synthesizes from the layer's traces rather than from anything written here.
//
// So this file commits three things and claims nothing:
//
//   1. the ACTIVITY  — the query run, so the instrument is reachable from every claim resting on it
//      (`prov:ObservationTrace` requires `was_generated_by` for exactly that reason);
//   2. the MEASUREMENT RESOURCE — the archived response, carrying the proposition it evidences.
//      `justification:Declaration` is explicitly "NOT a container for observations: an observed
//      ground cites the measurement resource itself";
//   3. the TRACE — a `prov:ObservationTrace` over it, which is what the kernel reads.
//
// The proposition is stated of the NUCLEOTIDE allele, because that is what gnomAD counted. The
// document's sentence names the protein allele; bridging the two is a separate, declared step, and
// rung 1's result is what the type system does when that bridge is absent.

namespace core    = "urn:eigenius:core";
namespace prov    = "urn:eigenius:prov";
namespace agent   = "urn:eigenius:prov:agent";
namespace eigentt = "urn:eigenius:eigentt";
namespace units   = "urn:eigenius:units";
namespace xiap    = "urn:eigenius:uab:xiap";

// ── 1. The activity: the query that read the world ────────────────────────────────────────────

resource xiap:gnomad_v4_gene_sweep : prov:Activity {
    core:short_name  = "gnomad-v4-xiap-gene-sweep";
    core:description = "POST to the gnomAD GraphQL API for gene XIAP (ENSG00000101966) on GRCh38, dataset gnomad_r4 (v4.1), returning every variant with its exome and genome ac/an/ac_hemi/ac_hom/af/filters. The certificate's `reproduce:` line re-runs it offline against the archived response.";
}

// ── 2. The measurement resource: the archived response, carrying what it evidences ────────────

resource xiap:gene_sweep_response : core:Resource {
    core:short_name  = "gnomad-v4-XIAP-gene-sweep.json";
    core:source_irl  = "https://gnomad.broadinstitute.org/api";
    core:description = "The archived gnomAD response, sha256:70afc6e7863be5396a557bb01a46fbf5d00b574a981b8df9720b73d2ba979351. Hemizygous males at X-123900531-A-G are exome.ac_hemi + genome.ac_hemi = 2 + 2; the v4.1 release VCFs reconcile independently at AC_joint_XY = 4, with hemizygous genotypes = AC_XY - 2*nhomalt_XY and FILTER=PASS on both.";

    eigentt:proposition = type_expr(
        xiap:HemizygousMaleCount(xiap:c_1138A_G, units:mk_quantity(r"4", 0))
    );
}

// ── 3. The trace the kernel reads ─────────────────────────────────────────────────────────────

resource xiap:gene_sweep_trace : prov:ObservationTrace {
    prov:resource         = xiap:gene_sweep_response;
    prov:was_generated_by = xiap:gnomad_v4_gene_sweep;
    prov:timestamp        = "2026-09-17T00:49:19Z";
    prov:observed_at      = "2026-09-17T00:49:19Z";
    prov:source_irl       = "https://gnomad.broadinstitute.org/api";
}
