package eigenius:component@0.1.0;

/// Types shared across all extension interfaces.
interface types {
    /// A CBOR-encoded Eigon resource.
    type resource-data = list<u8>;

    /// A CBOR-encoded EigenTT typed value (D14 §11). Distinct from
    /// `resource-data` even though the wire form is the same: a typed
    /// value inhabits a EigenTT type (primitive, tuple, inductive,
    /// codata) and is the payload exchanged between the source-side
    /// extract, the Component middle, and the target-side reify.
    type typed-value = list<u8>;

    /// An IRI string.
    type iri = string;

    /// Result of a component execution.
    record component-result {
        /// CBOR-encoded output resource.
        output: resource-data,
    }
}

/// Read-only access to the knowledge graph.
interface read-access {
    use types.{resource-data, iri};

    /// Resolve a resource by IRI from the layer chain.
    resolve: func(iri: iri) -> option<resource-data>;
}

/// Query access to the knowledge graph.
interface query-access {
    use types.{resource-data};

    /// Execute an EigenQL query.
    query: func(eigenql: string) -> result<list<resource-data>, string>;
}

/// IO access: dispatch calls to other components (including LLM adapters).
/// Only provided to orchestrator-hosted WASM components (capability_level=io).
interface io-access {
    use types.{resource-data, iri};

    /// Dispatch to another registered component by IRI.
    /// The input and argument are CBOR-encoded Eigon resources.
    /// Returns the component's output as CBOR.
    dispatch-component: func(
        component-iri: iri,
        input: resource-data,
        argument: resource-data,
    ) -> result<resource-data, string>;
}

/// A pure WASM component. Hosted in the kernel.
world eigenius-component {
    import read-access;

    use types.{resource-data, iri, component-result};

    /// Execute the component with input and optional argument.
    export execute: func(
        input: resource-data,
        argument: resource-data,
    ) -> result<component-result, string>;

    /// Return the component IRI.
    export component-iri: func() -> iri;
}

/// An IO-capability WASM component. Hosted in the orchestrator.
/// Has read/query access to the knowledge graph plus dispatch access to
/// other components (including native LLM adapters like CompleteText).
world eigenius-component-io {
    import read-access;
    import query-access;
    import io-access;

    use types.{resource-data, iri, component-result};

    export execute: func(
        input: resource-data,
        argument: resource-data,
    ) -> result<component-result, string>;

    export component-iri: func() -> iri;
}

/// Types specific to institution hosting.
interface institution-types {
    /// Result of morphism validation.
    enum validation-result {
        valid,
        invalid,
        undecidable,
    }
}

/// A WASM fiber reasoner for the legacy `FiberReasoner` protocol
/// (legacy, pre-institution-realisation). Retained while the migration to
/// the institution-realisation model is in flight; M5–M8
/// of the institution-realisation plan retire this world along with its host bridge and
/// the `wasm-ordering-institution` example.
world eigenius-institution {
    import read-access;
    import query-access;

    use types.{resource-data, iri};
    use institution-types.{validation-result};

    /// Declare this institution's fiber structure.
    /// Returns a CBOR-encoded FiberDeclaration resource.
    export fiber-declaration: func() -> resource-data;

    /// Execute a fiber query.
    export query: func(q: resource-data) -> result<resource-data, string>;

    /// Validate a morphism resource.
    /// Returns the validation result; on Invalid, the optional string is the reason.
    export validate-morphism: func(morphism: resource-data)
        -> result<tuple<validation-result, string>, string>;

    /// Discover morphisms between a set of resources.
    /// Returns a list of new morphism resources (CBOR-encoded).
    export discover-morphisms: func(resources: list<resource-data>)
        -> result<list<resource-data>, string>;
}

/// A WASM institution targeting the D14 dispatch surface (D14 §8 / §11).
///
/// Three exports — two mandatory boundary methods and one optional
/// reasoning method:
///
/// - `extract-typed` and `reify` translate between the institution's
///   resource form and the typed EigenTT payload form the kernel
///   manipulates internally. Always required.
/// - `query` is the institution's escape hatch for QueryClasses whose
///   implementation is opaque code. QueryClasses whose `query_handler`
///   IRI resolves to a kernel-registered Component are dispatched
///   entirely through EigenTT and never call this method. Default
///   guests may export it as a stub returning `not-implemented`.
///
/// `procedure-iri` is the dispatch key the kernel passes — declared on
/// the corresponding `ExportFormat` / `ImportFormat` / `QueryClass`
/// resource. The same institution may handle many procedures and
/// dispatch internally on the IRI.
///
/// All declaration data — Institution metadata, ExportFormat /
/// ImportFormat / QueryClass / Comorphism resources — lives in the
/// layer chain (D14 §3, ontology-first). The WASM component is *only*
/// the implementation; declarations ride alongside as Eigon-JSON or
/// Eigon-CBOR.
world eigenius-institution-realisation {
    import read-access;
    import query-access;

    use types.{resource-data, typed-value, iri};

    /// Boundary: extract a typed EigenTT value from a resource via a
    /// procedure declared by an `ExportFormat` resource owned by this
    /// institution. The returned `typed-value` must inhabit the type
    /// declared by the matching `ExportFormat.payload_type`.
    /// (Parameter `input` is a CBOR-encoded `resource-data` — the
    /// keyword `resource` is reserved in WIT.)
    export extract-typed: func(
        procedure-iri: iri,
        input: resource-data,
    ) -> result<typed-value, string>;

    /// Boundary: construct a target-class resource from a typed value
    /// via a procedure declared by an `ImportFormat` resource owned by
    /// this institution. The input `typed-value` is guaranteed to
    /// inhabit the type declared by the matching
    /// `ImportFormat.payload_type`.
    export reify: func(
        procedure-iri: iri,
        value: typed-value,
    ) -> result<resource-data, string>;

    /// Apply an institution-defined query — input resource of one
    /// class, output resource of another. Subsumes the prior
    /// validate-morphism / decide / discover-morphisms tripartite; the
    /// dispatch role is determined by the `QueryClass` declaration on
    /// the chain, not by which export the kernel chose to call.
    /// Optional: stub-export institutions whose QueryClasses are all
    /// Component-implemented return an error indicating the
    /// procedure is not handled at runtime.
    export query: func(
        procedure-iri: iri,
        input: resource-data,
    ) -> result<resource-data, string>;
}
