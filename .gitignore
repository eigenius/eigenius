# Vite build output for the notebook SPA (regenerated by `npm run build`,
# copied into the orchestrator Docker image at build time).
/notebooks/dist
.claude/scheduled_tasks.lock
# Personal docker-compose dev overrides (local knobs: log levels, cache budget).
# Auto-merged by docker compose; must stay per-developer, never committed.
docker-compose.override.yml
# Emitted lexicon artifacts — derived from third-party corpora (WordNet / UMLS /
# NCBI). Provisioned on demand, never vendored. Covers single-file, seeded-slice,
# and partitioned-chain (`--out-dir`) outputs.
wordnet-*.esl
umls-*.esl
ncbi-gene*.esl
wordnet-full.esl
ncbi-gene.esl
umls.esl
umls-chain/
wordnet-chain/
ncbi-chain/
/experiments/parsing/results/**
# Experiment run artifacts (logs + recorded LLM rankings) — large and regenerable.
# The committed artifact is the distilled baseline (e.g. experiments/parsing/baseline.json).
experiments/*/results/
# Derived from the committed alignment.jsonl + the source corpora — regenerate, don't store.
# Globbed: a future `candidates-v3.jsonl` must not slip past the pattern (a 37 MB `-v2` file did).
experiments/lexicon-align/alignment*.esl
experiments/lexicon-align/candidates*.jsonl
notes.md
experiments.tgz
references.tgz
umls-chain.tgz
wordnet-chain.tgz
