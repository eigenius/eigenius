// ══════════════════════════════════════════════════════════════════════════════════════════════
// inference.esl — the step where a claim becomes justified by INFERENCE rather than by having
// been written down.
//
// In English:
//
//   Sentence 1 of the paragraph established, by parsing, that MSI cancer models had WRN's
//   exonuclease activity                            HasActivity(MSI, WRN, exonuclease)
//   A rule pinned from the literature says that      ∀m. HasActivity(m, WRN, exonuclease)
//   any model with WRN's exonuclease activity              → RequiresActivity(m, WRN, helicase)
//   requires its helicase activity
//   ──────────────────────────────────────────────────────────────────────────────────────────
//   therefore                                       RequiresActivity(MSI, WRN, helicase)
//
// The conclusion is the SAME proposition sentence 2 of the paragraph asserts on its own. So on the
// intact branch that proposition ends up justified twice — once because the document states it,
// once because it follows from a measurement plus a published rule — and the two justifications
// are independent of each other. Negating sentence 1 kills the second and leaves the first
// standing. That asymmetry is what the demo shows.
//
// ── HOW THE ANTECEDENT IS WARRANTED ───────────────────────────────────────────────────────────
//
// `onco-typed.esl` DEFINES `HasActivity` and `RequiresActivity` as transparent definitions over
// the parser's own lexicon, so `HasActivity(m, g, a)` and the parsed sentence are the same term
// (D66). Nothing has to bridge between them, so nothing does: the antecedent below is warranted
// by the PARSER's own witness — `claim_1`, committed under a `ProgramTrace` by `prose-to-esl` —
// cited directly. Nothing Declared stands between the sentence and its use. The only Declared
// resource this inference rests on is the literature rule itself, which is an assertion and is
// graded as one.
//
// The model is explicit. The rule quantifies over it, and this step SPECIALIZES that quantifier
// with `spec_poly` at the term the sentences are actually about — «MSI cancer models».
//
// HAND-AUTHORED, THEN COMMITTED. `run.sh --reparse` does not touch this file. It is the RECORDED
// derivation; re-deriving it on every run would let the argument silently reshape itself around
// any edit, so nothing would ever fail to commit.
// ══════════════════════════════════════════════════════════════════════════════════════════════

namespace core        = "urn:eigenius:core";
namespace inferred    = "urn:eigenius:demo:formulas:inferred";
namespace onco_typed  = "urn:eigenius:demo:onco-typed";
namespace ontology    = "urn:eigenius:ontology";
namespace reasoning   = "urn:eigenius:reasoning";
namespace umlscui     = "urn:eigenius:umlscui";
namespace wn          = "urn:eigenius:wn";

// The vocabulary every proposition below is built from — all of it already on the chain, from two
// different lexicons occupying the same argument slots:
//
//   umlscui:C0388246   WRN            (a UMLS concept)
//   wn:n14606137       exonuclease    (a WordNet synset)
//   umlscui:C0920283   helicase       (a UMLS concept)
//   umlscui:C0920269   MSI            (a UMLS concept)
//   wn:n05890249       model          (a WordNet synset)
//   wn:n14239918       cancer         (a WordNet synset)
//
// The MODEL is not a single class. «MSI cancer models» parses to a nested compound kind — models
// whose kind is (cancers whose kind is MSI) — and that whole term is what the sentences are about.
// Writing it out is the honest thing: the claim really is about that kind, not about a name.

resource inferred:sentence : reasoning:ReasoningSentence {
    core:description = "«MSI cancer models required the helicase activity of WRN» — CONCLUDED by applying the pinned literature rule to sentence 1's parsed measurement. The document asserts this too; this justification does not depend on it doing so.";

    reasoning:subject_iri = "urn:eigenius:pub:wrn:gene_WRN";

    // ── The certificate ───────────────────────────────────────────────────────────────────────
    //
    // `JustifiedBy.app` is Artemov application — from a warrant for an implication and a warrant
    // for its antecedent, a warrant for its consequent:
    //
    //   app : forall (A : Prop, B : Prop, j1 : JustificationTerm, j2 : JustificationTerm) =>
    //         JustifiedBy(j1, A -> B) ->        // j1 warrants the implication
    //         JustifiedBy(j2, A) ->             // j2 warrants its antecedent
    //         JustifiedBy(App(j1, j2), B)       // ... so App(j1, j2) warrants the consequent
    //
    // `alias` names the model term once instead of four times. It is compile-time substitution —
    // the stored proposition is identical to writing the term out at each site.
    reasoning:certificate = type_expr(
        alias msi = (exists x0 : wn:n05890249 =>
                        ontology:compound_kind(
                            x0,
                            (exists x1 : wn:n14239918 =>
                                ontology:compound_kind(x1, umlscui:C0920269)))) in
        reasoning:app(
            // A — the antecedent. Sentence 1's proposition. `HasActivity` is a DEFINITION, so this
            // unfolds to exactly the term `claim_1` carries; the witness below matches by
            // conversion, not by assertion.
            onco_typed:HasActivity(msi, umlscui:C0388246, wn:n14606137),

            // B — the consequent, and the claim this whole sentence concludes.
            onco_typed:RequiresActivity(msi, umlscui:C0388246, umlscui:C0920283),

            // j1 — the warrant for the implication: the literature rule SPECIALIZED to this model.
            // `SpecStr` records that a universal was instantiated; the tag names the instantiation
            // for audit rather than carrying the term.
            reasoning:SpecStr(
                reasoning:DeclaredEvidence(
                    "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase"
                ),
                "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase#msi-cancer-model"
            ),

            // j2 — the warrant for the antecedent: the PARSER's own witness, cited directly.
            // `claim_1` was committed under a `ProgramTrace`, which mints `IsDerivedAs`.
            reasoning:DerivedEvidence("urn:eigenius:demo:formulas:claim_1"),

            // Sub-proof 1 : JustifiedBy(SpecStr(...), A -> B).
            //
            // The rule is `∀m. …`, so it cannot be applied to a particular model until the
            // quantifier is eliminated. `spec_poly` does that at any domain — here `Set`, since a
            // model is a kind. Its arguments are: the domain T, the motive P, the justification
            // term being specialized, the instance x, the audit tag, and the proof of the
            // universal. The `declared(…)` proof's proposition must match the rule resource's
            // `canonical_proposition` exactly — the witness key hashes it.
            reasoning:spec_poly(
                Set,
                (fun (m : Set) =>
                    onco_typed:HasActivity(m, umlscui:C0388246, wn:n14606137)
                      -> onco_typed:RequiresActivity(m, umlscui:C0388246, umlscui:C0920283)),
                reasoning:DeclaredEvidence(
                    "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase"
                ),
                msi,
                "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase#msi-cancer-model",
                reasoning:declared(
                    "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase",
                    forall (m : Set) =>
                        onco_typed:HasActivity(m, umlscui:C0388246, wn:n14606137)
                          -> onco_typed:RequiresActivity(m, umlscui:C0388246, umlscui:C0920283),
                    ()
                )
            ),

            // Sub-proof 2 : JustifiedBy(DerivedEvidence(claim_1), A). THE LIVE DEPENDENCY.
            //
            // The witness key hashes the PROPOSITION, not just the IRI, so this citation is bound
            // to the exact term sentence 1 parsed to. With the negation inserted, sentence 1 parses
            // to `⟨that term⟩ → False` — a different proposition, a different key, no witness. This
            // inference then has nothing to apply the rule to and the whole layer is refused.
            //
            // Sentence 2's own claim is untouched and still commits, so the document still says
            // the conclusion. Nothing compared the two texts; the dependency did the work.
            reasoning:derived(
                "urn:eigenius:demo:formulas:claim_1",
                onco_typed:HasActivity(msi, umlscui:C0388246, wn:n14606137),
                ()
            )
        )
    );

    // The justification TERM — the same shape as the certificate's `App(j1, j2)`, recorded on its
    // own so the warrant is readable (and indexable) without re-checking the proof. The gate
    // requires the certificate to be a proof about exactly this term.
    reasoning:justification = reasoning:App(
        reasoning:SpecStr(
            reasoning:DeclaredEvidence(
                "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase"
            ),
            "urn:eigenius:demo:onco-typed:lit_rule_exo_implies_helicase#msi-cancer-model"
        ),
        reasoning:DerivedEvidence("urn:eigenius:demo:formulas:claim_1")
    );

    // The proposition concluded: B from the `app` above. Sentence 2 of the paragraph asserts this
    // very same proposition directly — that is the point of the demo, not a redundancy.
    reasoning:proposition = type_expr(
        onco_typed:RequiresActivity(
            (exists x0 : wn:n05890249 =>
                ontology:compound_kind(
                    x0,
                    (exists x1 : wn:n14239918 =>
                        ontology:compound_kind(x1, umlscui:C0920269)))),
            umlscui:C0388246,
            umlscui:C0920283)
    );
}
