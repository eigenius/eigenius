// Reduction of the `spec_poly`-at-`Set` site in
// `demo/prose-to-formulas-v2/inference.esl` to a chain that builds in
// memory: a literature rule quantified over `Set` (its subject is a
// kind, not a name), eliminated with `justification:Certificate.spec_poly` at a
// concrete class.

namespace core          = "urn:eigenius:core";
namespace reflection    = "urn:eigenius:reflection";
namespace poly          = "urn:eigenius:demo:poly";
namespace agent         = "urn:eigenius:prov:agent";
namespace justification = "urn:eigenius:justification";
namespace eigentt       = "urn:eigenius:eigentt";
namespace prov       = "urn:eigenius:prov";

// ── Provenance activities ────────────────────────────────────────────
// `prov:was_generated_by` is resource-typed: the event that produced an
// observation has to be a node, not a string naming one. Each description below
// is the string this file used to carry in that slot.

resource poly:act_illustrative : prov:Activity {
    core:description = "instrument-log:illustrative";
    core:short_name = "act_illustrative";
}


class poly:Model : core:Resource {
    description = "A cancer model — the Set-level term the rule is specialised at.";
}

data poly:HasActivity : Set -> Prop {
}

data poly:RequiresActivity : Set -> Prop {
}

resource poly:rule : justification:Claim {
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = poly:warrant_illustrative_dependency_rule;
    prov:rationale   = "Illustrative. Quantified over the MODEL, which is a kind, so the domain of the quantifier is Set.";

    reflection:canonical_proposition = type_expr(
        forall (m : Set) => poly:HasActivity(m) -> poly:RequiresActivity(m)
    );
}

resource poly:rule_trace : prov:DeclarationTrace {
    prov:resource    = poly:rule;
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = poly:warrant_illustrative_dependency_rule;
    prov:timestamp   = "2026-08-18T00:00:00Z";
}

resource poly:obs : justification:Claim {
    prov:was_generated_by      = poly:act_illustrative;
    prov:observed_at = "2026-08-18T00:00:00Z";

    reflection:canonical_proposition = type_expr(
        poly:HasActivity(poly:Model)
    );
}

resource poly:obs_trace : prov:ObservationTrace {
    prov:resource  = poly:obs;
    prov:was_generated_by    = poly:act_illustrative;
    prov:timestamp = "2026-08-18T00:00:00Z";
}

resource poly:concl : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:demo:poly:Model";

    // `holds(...)` is a VALUE of `eigentt:Judgement`, which this slot declares; its
    // `term` and `type` arguments are declared `eigentt:Term`, so those are terms.
    justification:judgement =
        holds( eigentt:logic_kernel,
               type_expr(app(spec_poly(
                       Set,
                       (fun (m : Set) => poly:HasActivity(m) -> poly:RequiresActivity(m)),
                       poly:Model,
                       declared(
                           "urn:eigenius:demo:poly:rule",
                           forall (m : Set) => poly:HasActivity(m) -> poly:RequiresActivity(m),
                           ()
                       )
                   ),
                   observed(
                       "urn:eigenius:demo:poly:obs",
                       poly:HasActivity(poly:Model),
                       ()
                   )
               )),
               type_expr(justification:Certificate(
                   poly:RequiresActivity(poly:Model) )) );


}

// Warrant target, post-D72: `warranted_by` is resource-typed, so Rule 22 needs it to resolve.
resource poly:warrant_illustrative_dependency_rule : prov:Source {
    prov:was_attributed_to = agent:eigenius_core_team;
    core:description = "Illustrative dependency rule cited as the ground of this fixture's rule. A test fixture, not a real literature warrant.";
    core:short_name = "warrant_illustrative_dependency_rule";
}
