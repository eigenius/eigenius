// End-to-end D39 v2 demo — universal literature rule + Spec
// specialisation. Same drug-screening domain as
// `drug_screening.esl`, but the rule is now genuinely universal:
//
//   forall c : core:string, HasLowIC50(c) -> StrongInhibitor(c)
//
// rather than specialised to a single compound. The justification:Conclusion
// applies the universal rule to EIG_0291 via the
// `justification:Certificate.spec_poly` rule — kernel beta-reduces
// `(forall c, P c)("urn:EIG_0291")` to `P("urn:EIG_0291")` at
// type-check time. Same rule resource can be reused for any compound
// without re-committing.
//
// What this exercises that drug_screening.esl doesn't:
//
// 1. `type_expr(forall (c : core:string) => ...)` lowering a
//    universally-quantified proposition.
// 2. The `lower_type_expr_to_exp` bound-variable-with-args fix:
//    `screen:HasLowIC50(c)` inside the body where `c` is a Pi
//    binder lowers cleanly to `Exp::InductiveType(stub, [Var(c)])`.
//    The body proposition references its binder.
// 3. The certificate's own constructor tree in the
//    `justification` chain inductive value.
// 4. The `justification:Certificate.spec_poly` rule in the certificate,
//    producing the specialised type via kernel NbE beta-reduction
//    of the rule's universal proposition at "urn:EIG_0291".

namespace core          = "urn:eigenius:core";
namespace formats       = "urn:eigenius:core:formats";
namespace reflection    = "urn:eigenius:reflection";
namespace screen        = "urn:eigenius:demo:screen";
namespace agent         = "urn:eigenius:prov:agent";
namespace justification = "urn:eigenius:justification";
namespace eigentt       = "urn:eigenius:eigentt";
namespace prov       = "urn:eigenius:prov";

// ── Provenance activities ────────────────────────────────────────────
// `prov:was_generated_by` is resource-typed: the event that produced an
// observation has to be a node, not a string naming one. Each description below
// is the string this file used to carry in that slot.

resource screen:act_kinase_glo_plate_2026_03_04_a1 : prov:Activity {
    core:description = "instrument-log:kinase-glo-plate-2026-03-04-A1";
    core:short_name = "act_kinase_glo_plate_2026_03_04_a1";
}


// ─── Step 1: domain vocabulary (same as drug_screening.esl) ─────────

data screen:HasLowIC50 : core:string -> Prop {
}

data screen:StrongInhibitor : core:string -> Prop {
}

// ─── Step 2: the UNIVERSAL literature rule + trace ─────────────────
//
// One rule, applicable to any compound. The
// `canonical_proposition` is `forall c, HasLowIC50(c) ->
// StrongInhibitor(c)` — a Pi over `core:string` with a Prop body.

resource screen:rule_strong : justification:Claim {
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = screen:warrant_literature_smith_et_al_2024_3_2;
    prov:rationale   = "Universal: any compound with HasLowIC50 is a StrongInhibitor at that target.";

    reflection:canonical_proposition = type_expr(
        forall (c : core:string) =>
            screen:HasLowIC50(c) -> screen:StrongInhibitor(c)
    );
}

resource screen:rule_strong_trace : prov:DeclarationTrace {
    prov:resource    = screen:rule_strong;
    prov:was_attributed_to  = agent:eigenius_core_team;
    prov:had_primary_source = screen:warrant_literature_smith_et_al_2024_3_2;
    prov:timestamp   = "2026-04-10T09:00:00Z";
}

// ─── Step 3: bench observation + trace (unchanged in shape) ────────

resource screen:m_eig0291 : justification:Claim {
    prov:was_generated_by      = screen:act_kinase_glo_plate_2026_03_04_a1;
    prov:observed_at = "2026-03-04T14:22:11Z";

    reflection:canonical_proposition = type_expr(
        screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
    );
}

resource screen:m_eig0291_trace : prov:ObservationTrace {
    prov:resource  = screen:m_eig0291;
    prov:was_generated_by    = screen:act_kinase_glo_plate_2026_03_04_a1;
    prov:timestamp = "2026-03-04T14:22:11Z";
}

// ─── Step 4: justification:Conclusion with universal-rule specialisation ──
//
// The certificate specialises the universal rule at "urn:EIG_0291",
// then applies it to the observation:
//
//   app(spec_poly(declared(rule_iri)), observed(obs_iri))
//
// `spec_poly` witnesses that the rule (with
// its universal proposition) applied at "urn:EIG_0291" yields the
// specialised `HasLowIC50("urn:EIG_0291") -> StrongInhibitor(...)`
// proposition — which `app` then composes with the observation to
// conclude `StrongInhibitor("urn:EIG_0291")`.

resource screen:concl_eig0291_strong : justification:Conclusion {
    justification:subject_iri = "urn:eigenius:demo:screen:EIG_0291";

    // `holds(...)` is a VALUE of `eigentt:Judgement`, which is what this slot declares
    // (`class_types eigentt:Judgement`). Its `term` and `type` arguments are declared
    // `eigentt:Term`, so those are `type_expr(...)` — the slot's declared type decides the
    // shape at each position (D85 §6.1).
    justification:judgement =
        holds( eigentt:logic_kernel,
               type_expr(app(
                   // c1 : justification:Certificate(A -> B)
                   //    = spec_poly(core:string, P, Declared(rule),
                   //                "urn:EIG_0291", rule_cert)
                   //   where rule_cert : justification:Certificate(Declared(rule),
                   //                                 forall x, P(x))
                   spec_poly(
                       // T : the domain
                       core:string,
                       // P : core:string -> Prop
                       //
                       // Deliberately uses a different binder name (`x`) than
                       // the rule's `canonical_proposition` (which uses `c`)
                       // to exercise the witness index's alpha-canonical
                       // hashing: alpha-equivalent propositions must hash to
                       // the same key.
                       fun (x : core:string) =>
                           screen:HasLowIC50(x) -> screen:StrongInhibitor(x),
                       // t : core:string
                       "urn:eigenius:demo:screen:EIG_0291",
                       // rule_cert : justification:Certificate(forall x, P(x))
                       declared(
                           "urn:eigenius:demo:screen:rule_strong",
                           forall (c : core:string) =>
                               screen:HasLowIC50(c) -> screen:StrongInhibitor(c),
                           Prop
                       )
                   ),
                   // c2 : justification:Certificate(A)
                   observed(
                       "urn:eigenius:demo:screen:m_eig0291",
                       screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
                       Prop
                   )
               )),
               type_expr(justification:Certificate(
                   screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291") ) ) );

    // Chain-shape certificate value.

    // The certificate. The witness placeholders in the rule/obs
    // `declared` / `observed` ctors are kernel-synthesised (D49
    // Phase 9 hook); the user-supplied expression is ignored. We
    // pass `Prop` (a Sort literal) as a readable sentinel.
}

// ── Warrants (D72 §3.3) ──────────────────────────────────────────────

resource screen:warrant_literature_smith_et_al_2024_3_2 : prov:Source {
    prov:was_attributed_to = agent:eigenius_core_team;
    core:description = "Warrant stub for `literature:smith_et_al_2024_3.2`, minted by the D72 migration. Named as the ground of one or more declarations here; its CONTENT is not recorded. Before D72 this identifier existed only as an unresolvable string in a declared_by slot.";
    core:short_name = "warrant_literature_smith_et_al_2024_3_2";
}

