---
// Examples landing — hand-authored polished page that introduces
// the worked examples and routes readers into the individual
// walkthroughs (which still render through Starlight).

import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "End-to-end walkthroughs of real scientific and engineering scenarios modelled as Eigenius chains. From IC₅₀ readings to a strong-inhibitor designation; from kinetic curves to a five-institution composition with declared comorphisms.";
---

<BaseLayout title="Examples — Eigenius" description={description} current="examples">
    <!-- ───────── Hero ───────── -->
    <section class="examples-hero">
      <div class="examples-hero-inner">
        <span class="hero-eyebrow">Examples · end-to-end walkthroughs</span>
        <h1 class="examples-headline">
          The framework, in motion.
        </h1>
        <p class="examples-pitch">
          Each example takes a real scientific or engineering
          scenario, models it as a series of typed chain commits,
          and shows the audit closure the conclusion carries.
          Read these to see Eigenius doing work. If you want the
          conceptual ideas first, head to
          <a href="/concepts/">Concepts</a> instead.
        </p>
      </div>
    </section>

    <!-- ───────── Available walkthroughs ───────── -->
    <section class="section section-tinted">
      <div class="section-inner">
        <span class="section-eyebrow">Available walkthroughs</span>
        <h2 class="section-title">
          Two complete chains.
        </h2>

        <div class="example-grid">
          <article class="example-card">
            <header>
              <span class="example-tag">Drug screening</span>
              <span class="example-pattern">Domain-bridge pattern</span>
            </header>
            <h3 class="example-title">
              From IC₅₀ readings to a strong-inhibitor designation.
            </h3>
            <p class="example-prose">
              A medicinal chemist has six IC₅₀ readings of compound
              EIG_0291 and wants the chain to attest <em>"EIG_0291
              is a strong CDK2 inhibitor"</em> &mdash; only by
              mechanical derivation, not by author assertion. The
              statistics institution emits a strictly statistical
              conclusion; a chain-resident <a
              href="/concepts/domain-bridges/">domain bridge</a>
              translates it to the medicinal-chemistry vocabulary;
              a literature rule specialises at the compound; the
              kernel type-checks the composition. The final
              conclusion carries an audit trail that walks back to
              the raw plate readings.
            </p>
            <p class="example-actions">
              <a class="cta cta-primary" href="/examples/drug-screening/">
                Read the walkthrough →
              </a>
            </p>
          </article>

          <article class="example-card">
            <header>
              <span class="example-tag">Kinase potency mapping</span>
              <span class="example-pattern">Comorphism pattern</span>
            </header>
            <h3 class="example-title">
              Five Julia institutions in composition.
            </h3>
            <p class="example-prose">
              A biophysicist runs a kinase potency mapping campaign
              in which the same data must flow through symbolic
              math (Symbolics.jl), an ODE integrator
              (OrdinaryDiffEq.jl), non-linear regression
              (NonlinearSolve.jl), JuMP+HiGHS optimisation, and a
              ranking routine. Each institution speaks its own
              vocabulary; declared <a
              href="/concepts/institutions/">comorphisms</a>
              mediate the translation. Showcases the runtime-seam
              analogue of the domain-bridge pattern: typed
              translation between institution boundaries instead
              of between user-defined vocabularies.
            </p>
            <p class="example-actions">
              <a
                class="cta cta-primary"
                href="/examples/kinase-institutions/"
              >
                Read the walkthrough →
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ───────── Coming soon ───────── -->
    <section class="section">
      <div class="section-inner">
        <span class="section-eyebrow">Coming soon</span>
        <h2 class="section-title">
          The Lean-verified primary endpoint.
        </h2>
        <p class="section-prose">
          A regulatory-submission example is in preparation. It will
          show how a Lean-verified result enters the chain as a
          <code>Verified</code> artifact and composes with
          <code>Observed</code> and <code>Derived</code> evidence in
          a downstream sentence &mdash; the case where the framework
          earns its keep against ALCOA+ and FAIR alignment.
        </p>
      </div>
    </section>

    <!-- ───────── Running the examples ───────── -->
    <section class="section section-tinted">
      <div class="section-inner">
        <span class="section-eyebrow">Run them yourself</span>
        <h2 class="section-title">
          Every walkthrough has a runnable artifact.
        </h2>
        <p class="section-prose">
          Each example corresponds to either a Jupyter-style
          notebook under <code>notebooks/examples/</code> or an
          integration-test fixture under
          <code>crates/eigenius-*/tests/fixtures/</code>. The last
          section of each walkthrough links to the canonical
          artifact and gives reproduction instructions.
        </p>
        <p class="section-prose">
          The fastest path from zero to a running chain is the
          notebook flow on the <a href="/start/">Get started</a>
          page &mdash; clone the repo, bring up docker compose, and
          open the drug-screening notebook.
        </p>
        <p class="hero-actions">
          <a class="cta cta-primary" href="/start/">
            Set it up locally
          </a>
          <a class="cta cta-secondary" href="/docs/">
            Or read the reference
          </a>
        </p>
      </div>
    </section>

</BaseLayout>

<style>
  /* Page-unique styles. Shared chrome lives in custom.css and the
     TopNav / SiteFooter components. */

  .examples-hero {
    padding: 3rem 1.5rem 3.5rem 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
  }

  .examples-hero-inner {
    max-width: 44rem;
  }

  .examples-headline {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0.5rem 0 1rem 0;
  }

  .examples-pitch {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--sl-color-gray-3);
    line-height: 1.55;
    max-width: 56ch;
  }

  .examples-pitch a {
    color: var(--sl-color-text-accent);
  }

  /* Two-column card grid for the walkthroughs. Each card has
     header tags (scenario + pattern), a title, prose, and a CTA. */
  .example-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  @media (max-width: 55rem) {
    .example-grid {
      grid-template-columns: 1fr;
    }
  }

  .example-card {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
    padding: 1.4rem 1.5rem 1.2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .example-card header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .example-tag {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }

  .example-pattern {
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    background: var(--sl-color-bg-inline-code);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
  }

  .example-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-text);
  }

  .example-prose {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }

  .example-prose a {
    color: var(--sl-color-text-accent);
  }

  .example-actions {
    margin: 0.6rem 0 0 0;
  }
</style>
