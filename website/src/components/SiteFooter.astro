---
// Shared site footer for the hand-authored polished pages.
import { Image } from "astro:assets";
import logo from "../assets/eigenius_logo_400x400.png";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <Image src={logo} alt="" width={24} height={24} />
      <span>Eigenius</span>
    </div>
    <ul class="site-footer-links">
      <li><a href="/start/">Start</a></li>
      <li><a href="/concepts/">Concepts</a></li>
      <li><a href="/examples/">Examples</a></li>
      <li><a href="/docs/">Docs</a></li>
      <li><a href="/research/">Research</a></li>
      <li>
        <a href="https://github.com/eigenius/eigenius">GitHub ↗</a>
      </li>
    </ul>
    <p class="site-footer-fineprint">
      Eigenius is open source under the Apache 2.0 license.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sl-color-hairline);
    padding: 2rem 1.5rem 3rem 1.5rem;
    background: var(--sl-color-bg-nav);
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .site-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .site-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.4rem;
    flex-wrap: wrap;
  }

  .site-footer-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer-links a:hover {
    color: var(--sl-color-text-accent);
  }

  .site-footer-fineprint {
    margin: 0;
    color: var(--sl-color-gray-4);
    font-size: 0.85rem;
  }
</style>
