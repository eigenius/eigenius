// D52 Phase 4.5 fixture — Split-Plot design.
//
// Domain: cell-culture activity readings under crossed incubator-
// temperature (whole-plot, hard to randomize within a run) and
// drug-treatment (subplot, easily randomized within a single
// incubator's well plate).
//
// Whole-plot factor (W): temperature, 2 levels (37°C, 30°C)
// Subplot factor (S):    drug,        2 levels (control, drug)
// Whole-plot replicates: 3 incubator runs per temperature level
//   (a = 2, b = 2, r = 3 → 6 whole plots, 12 observations)
//
// Whole plot layout (one row per whole plot, two columns for
// control/drug subplot observations):
//
//   WP 0: T=37, run 1  →  ctrl=50, drug=45
//   WP 1: T=37, run 2  →  ctrl=51, drug=46
//   WP 2: T=37, run 3  →  ctrl=52, drug=47
//   WP 3: T=30, run 1  →  ctrl=70, drug=65
//   WP 4: T=30, run 2  →  ctrl=71, drug=66
//   WP 5: T=30, run 3  →  ctrl=72, drug=67
//
// Per-temperature means: 37°C → 47.5, 30°C → 68.5 (diff 21).
// Per-treatment means:   ctrl → 61, drug → 56 (diff 5).
// Whole-plot replicate variation: ±1 within each temperature.
// Drug-effect-within-whole-plot variation: exactly -5 across all WPs.
//
// Both main effects are detectable. The split-plot dispatch reports
// the smallest p across the three F-tests (W main, S main, W×S
// interaction) and names which effect produced it. The structural
// shield: the whole-plot temperature F is computed against the
// (larger) whole-plot error, not the (much smaller) subplot error
// — a flat factorial ANOVA on the same data would produce a
// massively inflated whole-plot F that's the false-positive trap
// D52 §5.2 calls out.
//
// Lands at product position `(Restricted, SplitPlotBlocking(2, 3),
// FullFactorial(2), _, CrossSectional)`. The `SplitPlotBlocking(a, r)`
// ctor distinguishes this dispatch from a flat `Factorial`.

namespace core       = "urn:eigenius:core";
namespace formats    = "urn:eigenius:core:formats";
namespace reflection = "urn:eigenius:reflection";
namespace stats      = "urn:eigenius:measurements";
namespace eigentt    = "urn:eigenius:eigentt";
namespace tx         = "urn:eigenius:demo:tx";

// ─── Domain predicate ──────────────────────────────────────────────

data tx:TemperatureOrDrugEffectExists : core:string -> Prop, stats:PopulationLevel {
}

// ─── SampleSet ────────────────────────────────────────────────────
//
// Observations encoded as `[whole_plot_id, w_level, s_level, value]`
// rows — 4 floats per row, 12 rows total = 48 floats.

resource tx:incubator_split_2026_05_03 : stats:SampleSetResource {
    reflection:source      = "instrument-log:incubator-runs-2026-05-03-splitplot";
    reflection:observed_at = "2026-05-03T08:45:00Z";

    stats:sample_set_value = stats:SplitPlot(
        2,    // a = whole-plot factor levels (temperatures)
        2,    // b = subplot factor levels (treatments)
        3,    // r = whole-plot replicates per W level (runs per temperature)
        [
            // WP 0 (T=37 / run 1)
            0.0, 0.0, 0.0, 50.0,
            0.0, 0.0, 1.0, 45.0,
            // WP 1 (T=37 / run 2)
            1.0, 0.0, 0.0, 51.0,
            1.0, 0.0, 1.0, 46.0,
            // WP 2 (T=37 / run 3)
            2.0, 0.0, 0.0, 52.0,
            2.0, 0.0, 1.0, 47.0,
            // WP 3 (T=30 / run 1)
            3.0, 1.0, 0.0, 70.0,
            3.0, 1.0, 1.0, 65.0,
            // WP 4 (T=30 / run 2)
            4.0, 1.0, 0.0, 71.0,
            4.0, 1.0, 1.0, 66.0,
            // WP 5 (T=30 / run 3)
            5.0, 1.0, 0.0, 72.0,
            5.0, 1.0, 1.0, 67.0,
        ],
        BiologicalReplication(),
    );
}

resource tx:incubator_split_trace : reflection:ObservationTrace {
    reflection:resource  = tx:incubator_split_2026_05_03;
    reflection:source    = "instrument-log:incubator-runs-2026-05-03-splitplot";
    reflection:timestamp = "2026-05-03T08:45:00Z";
}

// ─── The split-plot StatisticalAnalysisPlan ──────────────────────────────

resource tx:claim_effect_exists : stats:StatisticalAnalysisPlan {
    stats:sample_set = tx:incubator_split_2026_05_03;

    reflection:canonical_proposition = type_expr(
        tx:TemperatureOrDrugEffectExists("urn:eigenius:demo:tx:experiment_2026_05_03")
    );

    stats:alpha = 0.05;
    stats:effect_size = Absolute(15.0, "activity_units");
    stats:directionality = TwoSided();
    stats:variance_assumption = Pooled();
    stats:outlier_exclusion = Identity();
}

resource tx:claim_effect_exists_trace : reflection:ProgramTrace {
    reflection:resource  = tx:claim_effect_exists;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2026-05-03T08:45:00Z";
}
