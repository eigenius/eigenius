// D52 Phase 1.5 fixture — IID two-sample comparison.
//
// The simplest comparative-design verifier dispatch: control vs
// treatment, completely randomized, no blocking, one factor (the
// treatment), cross-sectional. Lands at product position
// `(CompleteRandom, Unblocked, SingleFactor, _, CrossSectional)` — the
// IID dispatch arm added in Phase 1.5.
//
// Domain: a kinase-activity readout (arbitrary units) compared between
// a vehicle-only control arm and a drug-treated arm. Six biological
// replicates per arm. Welch's t-test rejects H0 (mean_ctrl = mean_drug)
// at α = 0.05 — the verdict is Holds, and the predicate
// `DifferentMeanActivity` lands in the chain as a DerivedResource the
// downstream D39 reasoning could cite via DerivedEvidence (parallel
// to the IC50 → StrongInhibitor composition in d39_composition.esl).

namespace core       = "urn:eigenius:core";
namespace formats    = "urn:eigenius:core:formats";
namespace reflection = "urn:eigenius:reflection";
namespace stats      = "urn:eigenius:measurements";
namespace eigentt    = "urn:eigenius:eigentt";
namespace assay      = "urn:eigenius:demo:assay";

// ─── Domain predicate ──────────────────────────────────────────────

// Multi-class data decl marks the predicate as PopulationLevel
// (D52 §7.4 / §12 #8). The BiologicalReplication kind on the
// SampleSet matches this scope; the institution admits the claim.
data assay:DifferentMeanActivity : core:string -> Prop, stats:PopulationLevel {
}

// ─── SampleSet: 6 control + 6 drug-treated kinase activity readings ─

resource assay:kinase_run_2026_03_15 : stats:SampleSetResource {
    reflection:source      = "instrument-log:kinase-glo-plate-2026-03-15-IID";
    reflection:observed_at = "2026-03-15T11:04:30Z";

    // Group A = vehicle control (cluster around 100 a.u.), Group B =
    // drug-treated (cluster around 60 a.u.) — clear separation,
    // n = 6 per arm, Welch easily rejects.
    stats:sample_set_value = stats:IID(
        [98.0, 102.0, 100.0, 96.0, 104.0, 101.0],
        [62.0, 58.0, 60.0, 64.0, 56.0, 61.0],
        BiologicalReplication(),
    );
}

resource assay:kinase_run_trace : reflection:ObservationTrace {
    reflection:resource  = assay:kinase_run_2026_03_15;
    reflection:source    = "instrument-log:kinase-glo-plate-2026-03-15-IID";
    reflection:timestamp = "2026-03-15T11:04:30Z";
}

// ─── The IID StatisticalAnalysisPlan ──────────────────────────────────────
//
// Asserts that control and drug-treated arms have different mean
// activity. Welch's t-test (variance_assumption = WelchUnequal) on
// these data gives |t| ≫ 5, p ≪ 0.001 — Holds at α = 0.05. The
// effect_size field is reported on the verdict for audit; the
// dispatch v1 uses p < alpha alone (the directional refinement +
// minimum-effect-size enforcement land alongside §7.1 OneSidedWitnessed
// in a Phase 5 hardening).

resource assay:claim_drug_changes_activity : stats:StatisticalAnalysisPlan {
    stats:sample_set = assay:kinase_run_2026_03_15;

    reflection:canonical_proposition = type_expr(
        assay:DifferentMeanActivity("urn:eigenius:demo:assay:drug_X")
    );

    stats:alpha = 0.05;
    // The asserted minimum mean difference. Verdict carries computed
    // numerics; Phase 1.5 doesn't enforce that |observed| ≥ |asserted|.
    stats:effect_size = Absolute(20.0, "activity_units");
    stats:directionality = TwoSided();
    stats:variance_assumption = WelchUnequal();
    stats:outlier_exclusion = Identity();
}

resource assay:claim_drug_changes_activity_trace : reflection:ProgramTrace {
    reflection:resource  = assay:claim_drug_changes_activity;
    reflection:source    = "statistics-institution:validate_analysis_plan";
    reflection:timestamp = "2026-03-15T11:04:30Z";
}
