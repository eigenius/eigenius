// D52 §8 end-to-end composition fixture: stats verdict → D39 reasoning.
//
// Picks up the IC50 confirmatory SAR from `ic50_measurement.esl` and
// composes its strictly-statistical proposition `stats:lt(mean_of(s),
// 100.0)` with a **monomorphic statistical-to-domain bridge** and a
// **universal literature rule** via D39's nested `App` shape.
//
// What this exercises that the IC50 fixture alone didn't:
//
//  1. The DerivedEvidence path: `JustifiedBy.derived` consuming the
//     IsDerivedAs witness admitted off the pre-authored SAR's
//     `InstitutionEmittedDerivation` marker (D49 §6 → §5 lookup,
//     post-step-1E).
//  2. The statistical-to-domain bridge: a `DeclaredResource` whose
//     `canonical_proposition` lifts `stats:lt(mean_of(s), T)` into
//     `screen:HasLowIC50(c)`. Without it the chain has no path from
//     the verifier-emitted statistical claim to the domain-predicate
//     language the literature rule reads.
//  3. The SpecStr universal-rule specialization at the compound IRI
//     `urn:eigenius:demo:screen:EIG_0291`.
//  4. The full chain of evidence: bench data → statistics verdict →
//     bridge → literature rule → final population-level claim.
//
// The IC50 confirmatory SAP + its pre-authored SAR (and the
// impossibility witness the SAP cites) live in `ic50_measurement.esl`;
// this fixture compiles against the layer stack that includes it.
//
// The bridge here is monomorphic — one resource per
// (sample_set, compound) pair. The polymorphic shape
// (`forall (s c : core:string), sample_for(s, c) -> stats:lt(...) ->
// HasLowIC50(c)`) is a follow-on and would pair naturally with the
// universal-rule pattern already used here.

namespace core       = "urn:eigenius:core";
namespace formats    = "urn:eigenius:core:formats";
namespace reflection = "urn:eigenius:reflection";
namespace reasoning  = "urn:eigenius:reasoning";
namespace stats      = "urn:eigenius:measurements";
namespace screen     = "urn:eigenius:demo:screen";

// ─── Domain target predicate ───────────────────────────────────────
//
// `HasLowIC50` lives in the IC50 fixture (loaded into the same chain
// stack); `StrongInhibitor` is the conclusion the literature rule
// derives. Both are class-marker predicates in `Prop`.

data screen:StrongInhibitor : core:string -> Prop, stats:PopulationLevel {
}

// ─── Statistical-to-domain bridge + its DeclarationTrace ───────────
//
// Translates the verifier's statistical proposition into the
// domain-predicate language. The bridge is monomorphic: specialised
// to the (confirmatory sample-set, EIG_0291 compound) pair. Without
// this resource the certificate would have no path from
// `DerivedEvidence(SAR)`'s `stats:lt(mean_of(s), 100.0)` to the
// literature rule's antecedent `HasLowIC50(EIG_0291)`.

resource screen:bridge_eig0291_confirmatory_lowic50 : reflection:DeclaredResource {
    reflection:declared_by = "methodology:ic50-classification-convention";
    reflection:rationale   = "The medicinal-chemistry convention that a sample's mean IC50 being statistically below 100 nM justifies classifying the underlying compound as HasLowIC50 at the assayed target. Specialised to the EIG_0291 confirmatory sample-set / compound pair; the polymorphic shape would universally-quantify over (sample_set, compound) with an explicit `sample_for(s, c)` premise.";

    reflection:canonical_proposition = type_expr(
        stats:lt(
            stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
            100.0
        )
        ->
        screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
    );
}

resource screen:bridge_eig0291_confirmatory_lowic50_trace : reflection:DeclarationTrace {
    reflection:resource    = screen:bridge_eig0291_confirmatory_lowic50;
    reflection:declared_by = "methodology:ic50-classification-convention";
    reflection:timestamp   = "2026-03-11T10:18:42Z";
}

// ─── Universal literature rule ─────────────────────────────────────
//
// `forall c : core:string, HasLowIC50(c) -> StrongInhibitor(c)` —
// committed as a DeclaredResource whose canonical_proposition IS the
// rule. The matching DeclarationTrace admits the IsDeclaredAs witness
// for `(rule_iri, rule_proposition)` per D49 §6, which the
// `JustifiedBy.spec_str` ctor in the certificate consumes after
// specialising the rule at EIG_0291.

resource screen:rule_strong : reflection:DeclaredResource {
    reflection:declared_by = "literature:smith_et_al_2024_3.2";
    reflection:rationale   = "Universal: any compound with low IC50 at this target is a strong inhibitor at the same target.";

    reflection:canonical_proposition = type_expr(
        forall (c : core:string) =>
            screen:HasLowIC50(c) -> screen:StrongInhibitor(c)
    );
}

resource screen:rule_strong_trace : reflection:DeclarationTrace {
    reflection:resource    = screen:rule_strong;
    reflection:declared_by = "literature:smith_et_al_2024_3.2";
    reflection:timestamp   = "2026-04-10T09:00:00Z";
}

// ─── ReasoningSentence: derive StrongInhibitor(EIG_0291) ───────────
//
// Three-step composition:
//
//   stats:lt(mean_of(confirmatory_s), 100.0)   ← verifier-emitted SAR
//        |  bridge: statistical → domain
//        v
//   HasLowIC50(EIG_0291)
//        |  SpecStr(literature rule, EIG_0291): universal → specific
//        v
//   StrongInhibitor(EIG_0291)
//
// Justification (nested App):
//   App(
//     SpecStr(DeclaredEvidence(rule_iri), "urn:...:EIG_0291"),
//     reasoning:App(
//       DeclaredEvidence(bridge_iri),
//       DerivedEvidence(SAR_iri)
//     )
//   )
//
// The qualified `reasoning:App(...)` for the inner composition picks
// `reasoning:JustificationTerm.App` unambiguously (the bare `App`
// short name collides with `eigentt:TypeExpr.App`).
//
// Certificate: nested `app(...)`. Outer `app` composes the
// SpecStr-specialised rule with the inner `app` (bridge applied to
// verdict); inner `app` composes the bridge with the SAR-cited
// statistical claim.

resource screen:concl_eig0291_strong : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:demo:screen:EIG_0291";

    reasoning:proposition = type_expr(
        screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291")
    );

    reasoning:justification = App(
        SpecStr(
            DeclaredEvidence("urn:eigenius:demo:screen:rule_strong"),
            "urn:eigenius:demo:screen:EIG_0291"
        ),
        reasoning:App(
            DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_confirmatory_lowic50"),
            DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_confirmatory_holds:result:main_effect")
        )
    );

    reasoning:certificate = type_expr(
        app(
            // outer A : Prop = HasLowIC50(EIG_0291)
            screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
            // outer B : Prop = StrongInhibitor(EIG_0291)
            screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291"),
            // outer j1 = SpecStr(DeclaredEvidence(rule), EIG_0291)
            SpecStr(
                DeclaredEvidence("urn:eigenius:demo:screen:rule_strong"),
                "urn:eigenius:demo:screen:EIG_0291"
            ),
            // outer j2 = App(bridge, derived(SAR))
            reasoning:App(
                DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_confirmatory_lowic50"),
                DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_confirmatory_holds:result:main_effect")
            ),
            // outer c1 : JustifiedBy(j1, A -> B) — specialise the
            // universal rule at EIG_0291 via spec_str(P, j, t, rule_cert).
            spec_str(
                // P : core:string -> Prop
                fun (x : core:string) =>
                    screen:HasLowIC50(x) -> screen:StrongInhibitor(x),
                // j : JustificationTerm
                DeclaredEvidence("urn:eigenius:demo:screen:rule_strong"),
                // t : core:string
                "urn:eigenius:demo:screen:EIG_0291",
                // rule_cert : JustifiedBy(j, forall x, P(x)) — the
                // universal rule's grounding certificate.
                declared(
                    "urn:eigenius:demo:screen:rule_strong",
                    forall (x : core:string) =>
                        screen:HasLowIC50(x) -> screen:StrongInhibitor(x),
                    Prop
                )
            ),
            // outer c2 : JustifiedBy(j2, A) — inner app composing the
            // bridge with the per-effect verdict.
            app(
                // inner A' : Prop = stats:lt(mean_of(confirmatory_s), 100.0)
                stats:lt(
                    stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
                    100.0
                ),
                // inner B' : Prop = HasLowIC50(EIG_0291)
                screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
                // inner j1' = DeclaredEvidence(bridge)
                DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_confirmatory_lowic50"),
                // inner j2' = DerivedEvidence(SAR)
                DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_confirmatory_holds:result:main_effect"),
                // inner c1' : JustifiedBy(j1', A' -> B')
                declared(
                    "urn:eigenius:demo:screen:bridge_eig0291_confirmatory_lowic50",
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
                        100.0
                    )
                    -> screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
                        100.0
                    )
                    -> screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
                ),
                // inner c2' : JustifiedBy(j2', A') — the verdict
                derived(
                    "urn:eigenius:demo:screen:claim_eig0291_confirmatory_holds:result:main_effect",
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
                        100.0
                    ),
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_confirmatory_sampleset"),
                        100.0
                    )
                )
            )
        )
    );
}
