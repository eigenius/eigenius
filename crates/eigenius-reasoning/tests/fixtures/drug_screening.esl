// End-to-end D39 / D49 / D52 demo — drug screening.
//
// Question: Is compound EIG_0291 a strong CDK2 inhibitor?
//
// This fixture demonstrates the verdict-as-DerivedResource shape (D52
// §6 + the institution-surface revision) end-to-end: the chain attests
// only what the verifier actually proved — a strictly-statistical
// proposition — and the translation into domain-predicate language
// (`HasLowIC50` → `StrongInhibitor`) is itself a chain-resident
// citable artefact rather than something the statistics author folded
// silently into the SAP.
//
// Five chain commits + one ReasoningSentence:
//
// 1. Domain vocabulary — two predicates in `Prop`. `HasLowIC50` is
//    marked `is_a stats:PopulationLevel` per D52 §7.4 so the statistics
//    epistemic-scope check admits the claim under BiologicalReplication.
//
// 2. A literature rule as a `DeclaredResource` whose
//    `canonical_proposition` is the implication
//    `HasLowIC50(EIG_0291) -> StrongInhibitor(EIG_0291)`. A
//    `DeclarationTrace` admits the IsDeclaredAs witness.
//
// 3. A SampleSetResource holding the three raw IC50 replicate readings
//    (72, 85, 100 nM) plus an ObservationTrace pairing it with the
//    bench instrument log (D49 §6 IsObservedAs witness).
//
// 4. The statistical layer:
//    - A `stats:ImpossibilityWitness` resource encoding the
//      methodological argument that mean IC50 cannot exceed the
//      threshold under this assay class — what licenses the
//      `OneSidedWitnessed` directionality on the SAP (D52 §7.1).
//    - A `stats:StatisticalAnalysisPlan` with `OneSidedWitnessed(witness_iri)`
//      directionality, `Absolute(100.0, "nM")` effect size, and the
//      standard universal-claim parameters. The SAP carries no
//      `canonical_proposition` — the verifier derives it from
//      (dispatch, effect_size, directionality).
//    - A pre-authored `stats:StatisticalAnalysisResult` at
//      `{plan_iri}:result:main_effect` carrying the
//      `canonical_proposition` the verifier would emit:
//      `stats:lt(stats:mean_of("urn:...:m_eig0291_sampleset"), 100.0)`.
//      Pre-authored because this test loads the chain witness index
//      directly without dispatching the statistics institution
//      (institution dispatch is exercised in the eigenius-statistics
//      crate's own e2e tests). The is_a marker
//      `reflection:InstitutionEmittedDerivation` is what the D49
//      witness emitter walks to admit
//      `IsDerivedAs(result_iri, stats:lt(...))` directly off the
//      derivation, without needing a separate ProgramTrace.
//
// 5. The statistical-to-domain bridge:
//    - A `reflection:DeclaredResource` whose `canonical_proposition`
//      is the implication
//      `stats:lt(stats:mean_of("urn:...:m_eig0291_sampleset"), 100.0)
//       -> screen:HasLowIC50("urn:...:EIG_0291")`.
//      Monomorphic — specialised to this (sample-set, compound) pair.
//      The polymorphic shape (`forall s c, ...`) is the natural
//      evolution once the SAP authoring workflow reuses a single
//      bridge across many compounds; lands as a follow-on. A matching
//      `DeclarationTrace` admits the IsDeclaredAs witness.
//
// 6. A `ReasoningSentence` claiming `StrongInhibitor(EIG_0291)`. The
//    justification composes THREE evidences via nested `App`:
//      App(rule,
//          App(bridge,
//              DerivedEvidence(verdict_iri)))
//    - `DerivedEvidence(verdict_iri)` exposes
//      `stats:lt(mean_of(s), 100.0)` (the statistical claim)
//    - The inner `App(bridge, verdict)` yields `HasLowIC50(EIG_0291)`
//      (the domain claim)
//    - The outer `App(rule, ...)` yields `StrongInhibitor(EIG_0291)`
//      (the conclusion).
//    The certificate is two nested `app(A, B, j1, j2, c1, c2)` calls
//    composing JustifiedBy.declared (rule) + JustifiedBy.declared
//    (bridge) + JustifiedBy.derived (verdict) via JustifiedBy.app.
//
// On commit, ValidateJustification fires AutoOnLoad on the sentence
// and the kernel type-checks the certificate against
// `JustifiedBy(justification, proposition)`. The chain-witness index
// supplies the three witnesses the grounding constructors consume
// (`IsDerivedAs` on the verdict, `IsDeclaredAs` on the bridge, and
// `IsDeclaredAs` on the literature rule).

namespace core         = "urn:eigenius:core";
namespace formats      = "urn:eigenius:core:formats";
namespace reflection   = "urn:eigenius:reflection";
namespace reasoning    = "urn:eigenius:reasoning";
namespace stats        = "urn:eigenius:measurements";
namespace eigentt      = "urn:eigenius:eigentt";
namespace screen       = "urn:eigenius:demo:screen";

// The per-effect `StatisticalAnalysisResult` IRI scheme is
// `{plan_iri}:result:{effect_name}` (kernel-emitted; see
// `crates/eigenius-statistics/src/validate.rs::measurement_result_resource`).
// `screen_result` is the namespace prefix for the result *of*
// `claim_eig0291_lowic50`, so `screen_result:main_effect` lands at
// `urn:eigenius:demo:screen:claim_eig0291_lowic50:result:main_effect`.
namespace screen_result = "urn:eigenius:demo:screen:claim_eig0291_lowic50:result";

// ─── Step 1: domain vocabulary ─────────────────────────────────────

data screen:HasLowIC50 : core:string -> Prop, stats:PopulationLevel {
}

data screen:StrongInhibitor : core:string -> Prop, stats:PopulationLevel {
}

// ─── Step 2: literature rule + its DeclarationTrace ────────────────
//
// Specialised to EIG_0291. The antecedent is the domain predicate
// that the bridge lifts the statistical claim into.

resource screen:rule_strong : reflection:DeclaredResource {
    reflection:declared_by = "literature:smith_et_al_2024_3.2";
    reflection:rationale   = "IC50 < 100 nM at a kinase target is the standard strong-inhibitor threshold.";

    reflection:canonical_proposition = type_expr(
        screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
        ->
        screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291")
    );
}

resource screen:rule_strong_trace : reflection:DeclarationTrace {
    reflection:resource    = screen:rule_strong;
    reflection:declared_by = "literature:smith_et_al_2024_3.2";
    reflection:timestamp   = "2026-04-10T09:00:00Z";
}

// ─── Step 3: SampleSetResource carrying the raw replicate readings ──

resource screen:m_eig0291_sampleset : stats:SampleSetResource {
    reflection:source      = "instrument-log:kinase-glo-plate-2026-03-04-A1";
    reflection:observed_at = "2026-03-04T14:22:11Z";

    stats:sample_set_value = stats:SingleSampleEstimate(
        [72.0, 85.0, 100.0],
        BiologicalReplication(),
    );
}

resource screen:m_eig0291_sampleset_trace : reflection:ObservationTrace {
    reflection:resource  = screen:m_eig0291_sampleset;
    reflection:source    = "instrument-log:kinase-glo-plate-2026-03-04-A1";
    reflection:timestamp = "2026-03-04T14:22:11Z";
}

// ─── Step 4: statistical layer (witness + SAP + pre-authored result) ──
//
// The impossibility witness encodes the biological argument that the
// inverse direction (mean IC50 *above* the threshold) is impossible
// for this assay class. With the witness committed on chain, the
// statistics institution admits `OneSidedWitnessed` directionality
// (D52 §7.1) and halves the two-sided p-value before the Holds/Fails
// decision. The witness itself is a marker resource — no structural
// requirements beyond the `is_a` membership.

resource screen:witness_kinaseglo_floor : stats:ImpossibilityWitness {
    reflection:declared_by = "methodology:kinase-glo-emax-floor";
    reflection:rationale   = "Kinase-Glo's E_max plateau and the cell-free target panel jointly exclude the inverse direction: mean IC50 cannot biologically be above the assay-class threshold under this protocol. This is the chain-resident proof-of-inverse-direction-impossibility that licenses the one-sided p-value path.";
}

// The SAP carries no propositional content — the verifier derives the
// canonical proposition from (dispatch, effect_size, directionality).
// For SingleSampleEstimate + OneSidedWitnessed + Absolute(T) the
// derived proposition is `stats:lt(stats:mean_of(s), T)`, where T is
// the effect_size threshold (100.0 nM here).

resource screen:claim_eig0291_lowic50 : stats:StatisticalAnalysisPlan {
    stats:sample_set = screen:m_eig0291_sampleset;

    stats:alpha               = 0.05;
    stats:effect_size         = Absolute(100.0, "nM");
    stats:directionality      = OneSidedWitnessed("urn:eigenius:demo:screen:witness_kinaseglo_floor");
    stats:variance_assumption = WelchUnequal();
    stats:outlier_exclusion   = Identity();
}

// Pre-authored `StatisticalAnalysisResult` carrying the
// `canonical_proposition` the verifier would emit if dispatched. The
// multi-class header puts both `stats:StatisticalAnalysisResult` and
// `reflection:InstitutionEmittedDerivation` on the resource's `is_a`
// list — the second marker is what the D49 witness emitter walks to
// admit `IsDerivedAs(result_iri, stats:lt(mean_of(s), 100.0))` against
// the derivation's own IRI.
//
// IRI: `{plan_iri}:result:main_effect` per the kernel's emission scheme
// (`crates/eigenius-statistics/src/validate.rs`). The
// `screen_result` namespace prefix handles the multi-segment local IRI.
//
// Numerics chosen to mirror what the one-sample t-test on (72, 85,
// 100) against threshold 100 nM actually produces; included so the
// shape demonstrates a Holds verdict end-to-end.

resource screen_result:main_effect :
    stats:StatisticalAnalysisResult,
    reflection:InstitutionEmittedDerivation,
    reflection:DerivedResource
{
    reflection:from_subject          = screen:claim_eig0291_lowic50;
    stats:verdict_ctor               = "Holds";
    stats:computed_statistic         = -2.49;
    stats:computed_p_value           = 0.064;
    stats:effect_name                = "main_effect";

    reflection:canonical_proposition = type_expr(
        stats:lt(
            stats:mean_of("urn:eigenius:demo:screen:m_eig0291_sampleset"),
            100.0
        )
    );
}

// ─── Step 5: statistical-to-domain bridge + its DeclarationTrace ────
//
// The bridge translates the verifier-derived statistical claim into
// the domain-predicate language. Without it, `DerivedEvidence(verdict_iri)`
// would expose an inherently-statistical proposition that the
// literature rule's antecedent doesn't match — the chain would have
// no path from one to the other. With the bridge committed, the
// certificate's middle `app(...)` step lifts the statistical claim
// into `HasLowIC50` via a citable, auditable `DeclaredResource`.
//
// Monomorphic — one bridge resource per (sample_set, compound) pair.

resource screen:bridge_eig0291_lowic50 : reflection:DeclaredResource {
    reflection:declared_by = "methodology:ic50-classification-convention";
    reflection:rationale   = "The medicinal-chemistry convention that a sample's mean IC50 being statistically below 100 nM justifies classifying the underlying compound as HasLowIC50 at the assayed target. Specialised to the EIG_0291 sample-set / compound pair; the polymorphic shape would universally-quantify over (sample_set, compound) with an explicit `sample_for(s, c)` premise.";

    reflection:canonical_proposition = type_expr(
        stats:lt(
            stats:mean_of("urn:eigenius:demo:screen:m_eig0291_sampleset"),
            100.0
        )
        ->
        screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
    );
}

resource screen:bridge_eig0291_lowic50_trace : reflection:DeclarationTrace {
    reflection:resource    = screen:bridge_eig0291_lowic50;
    reflection:declared_by = "methodology:ic50-classification-convention";
    reflection:timestamp   = "2026-03-04T14:22:11Z";
}

// ─── Step 6: the ReasoningSentence ─────────────────────────────────
//
// The agent's claim: "EIG_0291 is a strong CDK2 inhibitor."
//
// Justification: a two-step chain — first the bridge applied to the
// statistical claim yields the domain claim (HasLowIC50); then the
// literature rule applied to the domain claim yields the conclusion
// (StrongInhibitor).
//
//   App(
//     DeclaredEvidence(rule_iri),         -- literature rule
//     App(
//       DeclaredEvidence(bridge_iri),     -- statistical → domain
//       DerivedEvidence(verdict_iri)      -- the per-effect result
//     )
//   )
//
// Certificate: nested `app(A, B, j1, j2, c1, c2)`. The outer `app`
// composes the literature rule with the result of the inner `app`,
// which itself composes the bridge with the per-effect verdict.

resource screen:concl_eig0291_strong : reasoning:ReasoningSentence {
    reasoning:subject_iri = "urn:eigenius:demo:screen:EIG_0291";

    reasoning:proposition = type_expr(
        screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291")
    );

    reasoning:justification = App(
        DeclaredEvidence("urn:eigenius:demo:screen:rule_strong"),
        App(
            DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_lowic50"),
            DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_lowic50:result:main_effect")
        )
    );

    // Outer app: applies the literature rule to the result of the
    // inner app (which produces HasLowIC50(EIG_0291)).
    //   A  = HasLowIC50(EIG_0291)
    //   B  = StrongInhibitor(EIG_0291)
    //   j1 = DeclaredEvidence(rule_iri)
    //   j2 = App(bridge, verdict) — produced by the inner app
    //   c1 = declared(rule_iri, A -> B)
    //   c2 = inner app(...) — bridge applied to verdict
    //
    // Inner app: applies the bridge to the per-effect verdict.
    //   A'  = stats:lt(mean_of(s), 100.0)
    //   B'  = HasLowIC50(EIG_0291)
    //   j1' = DeclaredEvidence(bridge_iri)
    //   j2' = DerivedEvidence(verdict_iri)
    //   c1' = declared(bridge_iri, A' -> B')
    //   c2' = derived(verdict_iri, A')
    //
    // The grounding ctors `declared`/`derived` each take a trailing
    // `IsXxAs(iri, P)` slot the kernel's synthesize hook fills in
    // from the chain witness index. ESL admits eliding that slot —
    // the calls below stop after the (iri, P) pair.
    reasoning:certificate = type_expr(
        app(
            // outer A
            screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
            // outer B
            screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291"),
            // outer j1
            DeclaredEvidence("urn:eigenius:demo:screen:rule_strong"),
            // outer j2 — qualified `reasoning:App` because the bare
            // `App` ctor name collides with `eigentt:TypeExpr.App`
            // and the type_expr parser resolves to TypeExpr otherwise.
            reasoning:App(
                DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_lowic50"),
                DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_lowic50:result:main_effect")
            ),
            // outer c1: literature rule — witness slot elided
            declared(
                "urn:eigenius:demo:screen:rule_strong",
                screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
                -> screen:StrongInhibitor("urn:eigenius:demo:screen:EIG_0291")
            ),
            // outer c2: inner app — bridge applied to verdict
            app(
                // inner A'
                stats:lt(
                    stats:mean_of("urn:eigenius:demo:screen:m_eig0291_sampleset"),
                    100.0
                ),
                // inner B'
                screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291"),
                // inner j1'
                DeclaredEvidence("urn:eigenius:demo:screen:bridge_eig0291_lowic50"),
                // inner j2'
                DerivedEvidence("urn:eigenius:demo:screen:claim_eig0291_lowic50:result:main_effect"),
                // inner c1': bridge — witness slot elided
                declared(
                    "urn:eigenius:demo:screen:bridge_eig0291_lowic50",
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_sampleset"),
                        100.0
                    )
                    -> screen:HasLowIC50("urn:eigenius:demo:screen:EIG_0291")
                ),
                // inner c2': SAR — witness slot elided
                derived(
                    "urn:eigenius:demo:screen:claim_eig0291_lowic50:result:main_effect",
                    stats:lt(
                        stats:mean_of("urn:eigenius:demo:screen:m_eig0291_sampleset"),
                        100.0
                    )
                )
            )
        )
    );
}
